diff --git a/src/mesh/LegionCrc32.h b/src/mesh/LegionCrc32.h
new file mode 100644
index 0000000000000000000000000000000000000000..d510e05b57bf368a6f68939f2ba7a80e56d99032
--- /dev/null
+++ b/src/mesh/LegionCrc32.h
@@ -0,0 +1,11 @@
+#pragma once
+
+#include <stdint.h>
+
+inline uint32_t legionCrc32Update(uint32_t crc, uint8_t value)
+{
+    crc ^= value;
+    for (uint8_t bit = 0; bit < 8; ++bit)
+        crc = (crc >> 1) ^ ((0u - (crc & 1u)) & 0xedb88320u);
+    return crc;
+}
diff --git a/src/mesh/LegionPersistence.cpp b/src/mesh/LegionPersistence.cpp
new file mode 100644
index 0000000000000000000000000000000000000000..35aec9ce30d08d64cf8c4ed3656833d5b8419562
--- /dev/null
+++ b/src/mesh/LegionPersistence.cpp
@@ -0,0 +1,65 @@
+#include "LegionPersistence.h"
+
+#if RAK3401_LEGION_FLASH
+#include "FSCommon.h"
+#include "SPILock.h"
+#include "concurrency/LockGuard.h"
+#include <atomic>
+#include <cstring>
+#include <pb_encode.h>
+
+namespace
+{
+std::atomic<uint32_t> checks{0};
+std::atomic<uint32_t> unchanged{0};
+std::atomic<uint32_t> saved{0};
+std::atomic<uint32_t> failed{0};
+
+bool compareEncoded(pb_ostream_t *stream, const pb_byte_t *buffer, size_t count)
+{
+    auto *file = static_cast<File *>(stream->state);
+    uint8_t existing[32];
+    while (count) {
+        const size_t chunk = count < sizeof(existing) ? count : sizeof(existing);
+        if (file->read(existing, chunk) != static_cast<int>(chunk) || memcmp(existing, buffer, chunk) != 0)
+            return false;
+        buffer += chunk;
+        count -= chunk;
+    }
+    return true;
+}
+} // namespace
+
+bool legionProtoMatchesFile(const char *filename, size_t protoSize, const pb_msgdesc_t *fields, const void *source)
+{
+    ++checks;
+#ifdef FSCom
+    concurrency::LockGuard guard(spiLock);
+    auto file = FSCom.open(filename, FILE_O_READ);
+    if (!file)
+        return false;
+    pb_ostream_t comparison = {compareEncoded, &file, protoSize};
+    const bool match = pb_encode(&comparison, fields, source) && file.read() < 0;
+    file.close();
+    if (match)
+        ++unchanged;
+    return match;
+#else
+    return false;
+#endif
+}
+
+void legionRecordProtoSave(bool success)
+{
+    if (success)
+        ++saved;
+    else
+        ++failed;
+}
+
+void legionLogPersistenceStats()
+{
+    LOG_INFO("Legion protobuf saves: checked=%u unchanged=%u saved=%u failed=%u", (unsigned)checks.load(),
+             (unsigned)unchanged.load(), (unsigned)saved.load(), (unsigned)failed.load());
+}
+#endif
