@@ -0,0 +1,36 @@
+#include "configuration.h"
+
+#if RAK3401_LEGION_TELEMETRY
+#include "LegionTelemetryHal.h"
+#include <Arduino.h>
+#include <nrf_sdm.h>
+#include <nrf_soc.h>
+
+bool legionReadCpuTemperature(int16_t &quarterDegrees)
+{
+    int32_t value;
+    uint8_t enabled = 0;
+    if (sd_softdevice_is_enabled(&enabled) != NRF_SUCCESS)
+        return false;
+    if (enabled) {
+        if (sd_temp_get(&value) != NRF_SUCCESS)
+            return false;
+    } else {
+        NRF_TEMP->EVENTS_DATARDY = 0;
+        NRF_TEMP->TASKS_START = 1;
+        const uint32_t started = micros();
+        while (!NRF_TEMP->EVENTS_DATARDY && (uint32_t)(micros() - started) < 1000u) {
+        }
+        const bool ready = NRF_TEMP->EVENTS_DATARDY != 0;
+        value = static_cast<int32_t>(NRF_TEMP->TEMP);
+        NRF_TEMP->TASKS_STOP = 1;
+        NRF_TEMP->EVENTS_DATARDY = 0;
+        if (!ready)
+            return false;
+    }
+    if (value < -160 || value > 500)
+        return false;
+    quarterDegrees = static_cast<int16_t>(value);
+    return true;
+}
+#endif
