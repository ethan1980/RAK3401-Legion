diff --git a/src/modules/LegionTelemetryModule.cpp b/src/modules/LegionTelemetryModule.cpp
new file mode 100644
index 0000000..c1a44f5
--- /dev/null
+++ b/src/modules/LegionTelemetryModule.cpp
@@ -0,0 +1,185 @@
+#include "LegionTelemetryModule.h"
+
+#if RAK3401_LEGION_TELEMETRY
+#include "MeshService.h"
+#include "NodeDB.h"
+#include "PowerStatus.h"
+#include "RadioLibInterface.h"
+#include "UptimeClock.h"
+#include "concurrency/LockGuard.h"
+#include "main.h"
+#include "platform/nrf52/LegionTelemetryHal.h"
+#include "power/RAK3401LegionPower.h"
+#include <cstdio>
+#include <cstring>
+
+LegionTelemetryModule *legionTelemetryModule = nullptr;
+
+LegionTelemetryModule::LegionTelemetryModule()
+    : SinglePortModule("legion-telemetry", meshtastic_PortNum_TEXT_MESSAGE_APP), concurrency::OSThread("LegionTelemetry")
+{
+    loopbackOk = true;
+    legionTelemetryModule = this;
+}
+
+bool LegionTelemetryModule::findChannel(Channel &result) const
+{
+    if (owner.is_licensed)
+        return false;
+    bool found = false;
+    for (uint8_t i = 1; i < channels.getNumChannels(); ++i) {
+        const auto &ch = channels.getByIndex(i);
+        if (!ch.has_settings || ch.role != meshtastic_Channel_Role_SECONDARY ||
+            std::strncmp(ch.settings.name, legion::TELEMETRY_CHANNEL, sizeof(ch.settings.name)) != 0)
+            continue;
+        if (found || (ch.settings.psk.size != 16 && ch.settings.psk.size != 32) || channels.usesPublicKey(i))
+            return false;
+        uint8_t nonzero = 0;
+        for (size_t k = 0; k < ch.settings.psk.size; ++k)
+            nonzero |= ch.settings.psk.bytes[k];
+        if (!nonzero)
+            return false;
+        result.index = i;
+        result.keySize = ch.settings.psk.size;
+        std::memcpy(result.key, ch.settings.psk.bytes, result.keySize);
+        result.aead = channels.isAEADEnabled(i);
+        found = true;
+    }
+    return found;
+}
+
+bool LegionTelemetryModule::sameChannel(const Channel &a, const Channel &b)
+{
+    return a.index == b.index && a.keySize == b.keySize && a.aead == b.aead && std::memcmp(a.key, b.key, a.keySize) == 0;
+}
+
+ProcessMessage LegionTelemetryModule::handleReceived(const meshtastic_MeshPacket &mp)
+{
+    if (mp.which_payload_variant != meshtastic_MeshPacket_decoded_tag ||
+        mp.decoded.portnum != meshtastic_PortNum_TEXT_MESSAGE_APP || !isBroadcast(mp.to) ||
+        mp.decoded.payload.size > sizeof(mp.decoded.payload.bytes))
+        return ProcessMessage::CONTINUE;
+    Channel channel;
+    bool targeted;
+    if (!findChannel(channel) || mp.channel != channel.index ||
+        !legion::parseTelemetryCommand(mp.decoded.payload.bytes, mp.decoded.payload.size, nodeDB->getNodeNum(), targeted))
+        return ProcessMessage::CONTINUE;
+    const uint32_t delayMs = targeted ? random(250, 1001) : random(1000, 10001);
+    concurrency::LockGuard guard(&stateLock);
+    if (requests.reserve(getFrom(&mp), mp.id, Time::getMillis(), delayMs))
+        pendingChannel = channel;
+    return ProcessMessage::CONTINUE;
+}
+
+void LegionTelemetryModule::observeNoise(int16_t dbm)
+{
+    concurrency::LockGuard guard(&stateLock);
+    samples.observeNoise(dbm);
+}
+
+void LegionTelemetryModule::observeBattery(uint16_t mv)
+{
+    concurrency::LockGuard guard(&stateLock);
+    samples.observeBattery(mv);
+}
+
+void legionTelemetryObserveNoise(int16_t dbm)
+{
+    if (legionTelemetryModule)
+        legionTelemetryModule->observeNoise(dbm);
+}
+
+void legionTelemetryObserveBattery(uint16_t mv)
+{
+    if (legionTelemetryModule)
+        legionTelemetryModule->observeBattery(mv);
+}
+
+void LegionTelemetryModule::sample()
+{
+    int16_t temperature;
+    const bool validTemperature = legionReadCpuTemperature(temperature);
+    const uint16_t battery = legionPowerBatteryMv();
+    concurrency::LockGuard guard(&stateLock);
+    if (validTemperature)
+        samples.observeTemperature(temperature);
+    else
+        samples.hasTemperature = false;
+    samples.observeBattery(battery);
+}
+
+static void formatTemperature(char *buffer, size_t size, int16_t quarters)
+{
+    const int32_t magnitude = quarters < 0 ? -static_cast<int32_t>(quarters) : quarters;
+    std::snprintf(buffer, size, "%s%ld.%02ld", quarters < 0 ? "-" : "", (long)(magnitude / 4), (long)((magnitude % 4) * 25));
+}
+
+void LegionTelemetryModule::sendReport(uint8_t channel)
+{
+    legion::TelemetrySamples snapshot;
+    {
+        concurrency::LockGuard guard(&stateLock);
+        snapshot = samples;
+    }
+    char temperature[16] = "NA", maximum[16] = "NA", battery[32] = "NA", noise[48] = "NA";
+    if (snapshot.hasTemperature)
+        formatTemperature(temperature, sizeof(temperature), snapshot.temperature);
+    if (snapshot.temperatureMax != std::numeric_limits<int16_t>::min())
+        formatTemperature(maximum, sizeof(maximum), snapshot.temperatureMax);
+    if (snapshot.hasBattery) {
+        char percent[5] = "NA";
+        if (powerStatus && powerStatus->getHasBattery() && powerStatus->getBatteryChargePercent() <= 100)
+            std::snprintf(percent, sizeof(percent), "%u", (unsigned)powerStatus->getBatteryChargePercent());
+        std::snprintf(battery, sizeof(battery), "%s%% %u.%02u/min%u.%02uV", percent, snapshot.battery / 1000,
+                      (snapshot.battery % 1000) / 10, snapshot.batteryMin / 1000, (snapshot.batteryMin % 1000) / 10);
+    }
+    if (snapshot.noiseCount)
+        std::snprintf(noise, sizeof(noise), "%d peak:%ddBm n:%lu", snapshot.averageNoise(), snapshot.noisePeak,
+                      (unsigned long)snapshot.noiseCount);
+    auto radio = RadioLibInterface::instance;
+    char report[200];
+    const int length = std::snprintf(
+        report, sizeof(report), "Legion0.3.0 !%08lx up:%lus\nCPU:%s/max%sC BAT:%s\nN:%s\nRX:%lu BAD:%lu TX:%lu REL:%lu DROP:%u",
+        (unsigned long)nodeDB->getNodeNum(), (unsigned long)Time::getUptimeSecs(), temperature, maximum, battery, noise,
+        (unsigned long)(radio ? radio->rxGood : 0), (unsigned long)(radio ? radio->rxBad : 0),
+        (unsigned long)(radio ? radio->txGood : 0), (unsigned long)(radio ? radio->txRelay : 0), radio ? radio->txDrop : 0);
+    if (length <= 0 || static_cast<size_t>(length) >= sizeof(report))
+        return;
+    auto packet = allocDataPacket();
+    if (!packet)
+        return;
+    packet->channel = channel;
+    packet->to = NODENUM_BROADCAST;
+    packet->want_ack = false;
+    packet->decoded.want_response = false;
+    packet->priority = meshtastic_MeshPacket_Priority_BACKGROUND;
+    packet->decoded.payload.size = length;
+    std::memcpy(packet->decoded.payload.bytes, report, length);
+    service->sendToMesh(packet, RX_SRC_LOCAL, true);
+}
+
+int32_t LegionTelemetryModule::runOnce()
+{
+    Channel channel;
+    const bool configured = findChannel(channel);
+    const uint32_t now = Time::getMillis();
+    if (configured && (!sampled || Throttle::hasElapsed(lastSample, 60000))) {
+        sample();
+        lastSample = now;
+        sampled = true;
+    }
+    bool respond = false;
+    {
+        concurrency::LockGuard guard(&stateLock);
+        if (requests.ready(now)) {
+            respond = configured && sameChannel(channel, pendingChannel);
+            requests.finish(now);
+        }
+    }
+    if (respond && legionPowerTxReady()) {
+        sample();
+        sendReport(channel.index);
+    }
+    return 1000;
+}
+#endif
