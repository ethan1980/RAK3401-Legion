@@ -0,0 +1,48 @@
+#pragma once
+
+#include "configuration.h"
+
+#if RAK3401_LEGION_TELEMETRY
+#if !defined(ARCH_NRF52) || !defined(RAK3401) || !defined(RAK13302) || !RAK3401_LEGION_POWER
+#error "Legion telemetry requires the RAK3401 + RAK13302 energy profile"
+#endif
+#include "LegionTelemetryPolicy.h"
+#include "SinglePortModule.h"
+#include "concurrency/Lock.h"
+#include "concurrency/OSThread.h"
+
+class LegionTelemetryModule : public SinglePortModule, private concurrency::OSThread
+{
+  public:
+    LegionTelemetryModule();
+    void observeNoise(int16_t dbm);
+    void observeBattery(uint16_t mv);
+
+  protected:
+    ProcessMessage handleReceived(const meshtastic_MeshPacket &mp) override;
+    int32_t runOnce() override;
+
+  private:
+    struct Channel {
+        uint8_t index = 0;
+        uint8_t keySize = 0;
+        uint8_t key[32]{};
+        bool aead = false;
+    };
+    bool findChannel(Channel &result) const;
+    static bool sameChannel(const Channel &a, const Channel &b);
+    void sample();
+    void sendReport(uint8_t channel);
+
+    concurrency::Lock stateLock;
+    legion::TelemetryRequestGate requests;
+    legion::TelemetrySamples samples;
+    Channel pendingChannel;
+    uint32_t lastSample = 0;
+    bool sampled = false;
+};
+
+extern LegionTelemetryModule *legionTelemetryModule;
+void legionTelemetryObserveNoise(int16_t dbm);
+void legionTelemetryObserveBattery(uint16_t mv);
+#endif
diff --git a/src/modules/LegionTelemetryPolicy.h b/src/modules/LegionTelemetryPolicy.h
new file mode 100644
index 0000000..d80b47e
--- /dev/null
+++ b/src/modules/LegionTelemetryPolicy.h
@@ -0,0 +1,150 @@
+#pragma once
+
+#include "mesh/Throttle.h"
+#include <cstddef>
+#include <cstdint>
+#include <cstring>
+#include <limits>
+
+namespace legion
+{
+constexpr char TELEMETRY_CHANNEL[] = "LegionRF";
+constexpr uint32_t TELEMETRY_COOLDOWN_MS = 60000;
+constexpr uint32_t TELEMETRY_DUPLICATE_MS = 600000;
+
+inline bool commandSpace(uint8_t c)
+{
+    return c == ' ' || c == '\t' || c == '\r' || c == '\n';
+}
+
+inline bool parseTelemetryCommand(const uint8_t *data, size_t size, uint32_t ownNode, bool &targeted)
+{
+    targeted = false;
+    if (!data || !ownNode)
+        return false;
+    while (size && commandSpace(*data)) {
+        ++data;
+        --size;
+    }
+    while (size && commandSpace(data[size - 1]))
+        --size;
+    constexpr char command[] = "/telemetry";
+    constexpr size_t commandSize = sizeof(command) - 1;
+    if (size < commandSize || std::memcmp(data, command, commandSize) != 0)
+        return false;
+    data += commandSize;
+    size -= commandSize;
+    if (!size)
+        return true;
+    if (!commandSpace(*data))
+        return false;
+    while (size && commandSpace(*data)) {
+        ++data;
+        --size;
+    }
+    if (size != 9 || data[0] != '!')
+        return false;
+    uint32_t node = 0;
+    for (size_t i = 1; i < size; ++i) {
+        uint8_t c = data[i];
+        uint8_t digit;
+        if (c >= '0' && c <= '9')
+            digit = c - '0';
+        else if (c >= 'a' && c <= 'f')
+            digit = c - 'a' + 10;
+        else if (c >= 'A' && c <= 'F')
+            digit = c - 'A' + 10;
+        else
+            return false;
+        node = (node << 4) | digit;
+    }
+    targeted = true;
+    return node == ownNode;
+}
+
+class TelemetryRequestGate
+{
+  public:
+    bool reserve(uint32_t from, uint32_t id, uint32_t now, uint32_t delayMs)
+    {
+        if (pending || (cooling && !Throttle::deadlinePassedAt(now, nextAllowed)))
+            return false;
+        for (const auto &entry : seen) {
+            if (entry.used && entry.from == from && entry.id == id && !Throttle::deadlinePassedAt(now, entry.expires))
+                return false;
+        }
+        seen[nextSeen] = {from, id, now + TELEMETRY_DUPLICATE_MS, true};
+        nextSeen = (nextSeen + 1) % SEEN_COUNT;
+        due = now + delayMs;
+        pending = true;
+        return true;
+    }
+
+    bool ready(uint32_t now) const { return pending && Throttle::deadlinePassedAt(now, due); }
+    bool isPending() const { return pending; }
+
+    void finish(uint32_t now)
+    {
+        pending = false;
+        cooling = true;
+        nextAllowed = now + TELEMETRY_COOLDOWN_MS;
+    }
+
+  private:
+    struct Seen {
+        uint32_t from = 0;
+        uint32_t id = 0;
+        uint32_t expires = 0;
+        bool used = false;
+    };
+    static constexpr size_t SEEN_COUNT = 16;
+    Seen seen[SEEN_COUNT]{};
+    size_t nextSeen = 0;
+    uint32_t due = 0;
+    uint32_t nextAllowed = 0;
+    bool pending = false;
+    bool cooling = false;
+};
+
+struct TelemetrySamples {
+    int64_t noiseSum = 0;
+    uint32_t noiseCount = 0;
+    int16_t noisePeak = std::numeric_limits<int16_t>::min();
+    int16_t temperature = 0;
+    int16_t temperatureMax = std::numeric_limits<int16_t>::min();
+    uint16_t battery = 0;
+    uint16_t batteryMin = std::numeric_limits<uint16_t>::max();
+    bool hasTemperature = false;
+    bool hasBattery = false;
+
+    void observeNoise(int16_t dbm)
+    {
+        if (dbm < -127 || dbm >= 0)
+            return;
+        if (noiseCount != UINT32_MAX) {
+            noiseSum += dbm;
+            ++noiseCount;
+        }
+        if (dbm > noisePeak)
+            noisePeak = dbm;
+    }
+
+    void observeTemperature(int16_t quarters)
+    {
+        temperature = quarters;
+        hasTemperature = true;
+        if (quarters > temperatureMax)
+            temperatureMax = quarters;
+    }
+
+    void observeBattery(uint16_t mv)
+    {
+        battery = mv;
+        hasBattery = true;
+        if (mv < batteryMin)
+            batteryMin = mv;
+    }
+
+    int16_t averageNoise() const { return noiseCount ? static_cast<int16_t>(noiseSum / noiseCount) : 0; }
+};
+} // namespace legion
