+#include "configuration.h"
+
+#if defined(ARCH_NRF52) && defined(RAK3401_LEGION_DFU) && RAK3401_LEGION_DFU
+
+#include "LegionDfu.h"
+#include "SPILock.h"
+#include <InternalFileSystem.h>
+#include <cstddef>
+#include <cstring>
+
+extern void nrf52FlashQuiesce();
+
+namespace
+{
+struct PeerData {
+    ble_gap_addr_t address;
+    ble_gap_irk_t irk;
+    ble_gap_enc_key_t encryptionKey;
+    uint8_t systemAttributes[8];
+    uint16_t crc;
+};
+static_assert(offsetof(PeerData, crc) == 60, "Bootloader peer-data layout changed");
+static_assert(sizeof(PeerData) == 62, "Bootloader peer-data size changed");
+
+uint16_t peerCrc(const uint8_t *data, size_t length)
+{
+    uint16_t crc = 0xffff;
+    while (length--) {
+        uint8_t value = (crc >> 8) ^ *data++;
+        value ^= value >> 4;
+        crc = (crc << 8) ^ (uint16_t(value) << 12) ^ (uint16_t(value) << 5) ^ value;
+    }
+    return crc;
+}
+} // namespace
+
+extern "C" __attribute__((noinline)) void legionDfuControlWrite(uint16_t connHandle, BLECharacteristic *characteristic,
+                                                                ble_gatts_evt_write_t *request)
+{
+    if (request->handle != characteristic->handles().value_handle || request->op != BLE_GATTS_OP_WRITE_REQ)
+        return;
+
+    ble_gatts_rw_authorize_reply_params_t reply = {};
+    reply.type = BLE_GATTS_AUTHORIZE_TYPE_WRITE;
+    if (!characteristic->notifyEnabled(connHandle)) {
+        reply.params.write.gatt_status = BLE_GATT_STATUS_ATTERR_CPS_CCCD_CONFIG_ERROR;
+    } else if (!request->len) {
+        reply.params.write.gatt_status = BLE_GATT_STATUS_ATTERR_INVALID_ATT_VAL_LENGTH;
+    } else if (request->data[0] != 1) {
+        sd_ble_gatts_rw_authorize_reply(connHandle, &reply);
+        return;
+    } else {
+        BLEConnection *connection = Bluefruit.Connection(connHandle);
+        if (!connection)
+            return;
+
+        nrf52FlashQuiesce();
+        // Bond-key reads need the filesystem mutex; spiLock still fences writers.
+        InternalFS._unlockFS();
+        if (sd_ble_gatts_rw_authorize_reply(connHandle, &reply) != NRF_SUCCESS) {
+            spiLock->unlock();
+            return;
+        }
+
+        // This retained-RAM address and layout are part of the Adafruit bootloader ABI.
+        auto *peer = reinterpret_cast<PeerData *>(0x20007f80UL);
+        memset(peer, 0, sizeof(*peer));
+        uint16_t attributeLength = sizeof(peer->systemAttributes);
+        sd_ble_gatts_sys_attr_get(connHandle, peer->systemAttributes, &attributeLength, BLE_GATTS_SYS_ATTR_FLAG_SYS_SRVCS);
+        peer->address = connection->getPeerAddr();
+        if (connection->secured()) {
+            bond_keys_t keys;
+            if (connection->loadBondKey(&keys)) {
+                peer->address = keys.peer_id.id_addr_info;
+                peer->irk = keys.peer_id.id_info;
+                peer->encryptionKey = keys.own_enc;
+            }
+        }
+        peer->crc = peerCrc(reinterpret_cast<const uint8_t *>(peer), offsetof(PeerData, crc));
+
+        Bluefruit.Advertising.restartOnDisconnect(false);
+        connection->disconnect();
+        // 0xA8 requests a fresh OTA boot; no C frame survives a PSP-to-MSP switch.
+        enterOTADfu();
+        __builtin_unreachable();
+    }
+    sd_ble_gatts_rw_authorize_reply(connHandle, &reply);
+}
+
+#endif
