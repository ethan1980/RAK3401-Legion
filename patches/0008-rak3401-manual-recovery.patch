index 0000000..e918d96
--- /dev/null
+++ b/src/mesh/LegionRecoveryPolicy.h
@@ -0,0 +1,66 @@
+#pragma once
+
+#include <cstddef>
+#include <cstdint>
+#include <cstring>
+
+enum class LegionBackupCommand { None, Create, Status, Replace, Delete };
+
+inline LegionBackupCommand legionParseBackup(const uint8_t *data, size_t size, uint32_t ownNode)
+{
+    const auto space = [](uint8_t c) { return c == ' ' || c == '\t' || c == '\r' || c == '\n'; };
+    if (!data || !ownNode)
+        return LegionBackupCommand::None;
+    while (size && space(*data)) {
+        ++data;
+        --size;
+    }
+    while (size && space(data[size - 1]))
+        --size;
+    constexpr char prefix[] = "/backup";
+    if (size <= sizeof(prefix) - 1 || std::memcmp(data, prefix, sizeof(prefix) - 1) || !space(data[sizeof(prefix) - 1]))
+        return LegionBackupCommand::None;
+    data += sizeof(prefix) - 1;
+    size -= sizeof(prefix) - 1;
+    while (size && space(*data)) {
+        ++data;
+        --size;
+    }
+    auto command = LegionBackupCommand::Create;
+    if (size && *data != '!') {
+        size_t token = 0;
+        while (token < size && !space(data[token]))
+            ++token;
+        if (token == 6 && !std::memcmp(data, "status", 6))
+            command = LegionBackupCommand::Status;
+        else if (token == 7 && !std::memcmp(data, "replace", 7))
+            command = LegionBackupCommand::Replace;
+        else if (token == 6 && !std::memcmp(data, "delete", 6))
+            command = LegionBackupCommand::Delete;
+        else
+            return LegionBackupCommand::None;
+        data += token;
+        size -= token;
+        while (size && space(*data)) {
+            ++data;
+            --size;
+        }
+    }
+    if (size != 9 || *data != '!')
+        return LegionBackupCommand::None;
+    uint32_t node = 0;
+    for (size_t i = 1; i < size; ++i) {
+        const uint8_t c = data[i];
+        uint8_t digit;
+        if (c >= '0' && c <= '9')
+            digit = c - '0';
+        else if (c >= 'a' && c <= 'f')
+            digit = c - 'a' + 10;
+        else if (c >= 'A' && c <= 'F')
+            digit = c - 'A' + 10;
+        else
+            return LegionBackupCommand::None;
+        node = (node << 4) | digit;
+    }
+    return node == ownNode ? command : LegionBackupCommand::None;
+}
diff --git a/src/mesh/LegionRecoveryRunner.h b/src/mesh/LegionRecoveryRunner.h
new file mode 100644
index 0000000..8cc49b1
--- /dev/null
+++ b/src/mesh/LegionRecoveryRunner.h
@@ -0,0 +1,36 @@
+#pragma once
+
+#include "LegionRecoveryStore.h"
+
+enum class LegionBootRecovery { None, Restored, Blocked };
+
+namespace legion
+{
+enum class PreferenceRead { Valid, Missing, Corrupt, Temporary, Unsupported };
+
+template <typename Probe, typename Restore, typename Pause>
+LegionBootRecovery runRecovery(RecoveryStore &store, RecoveryPage &page, Probe probe, Restore restore, Pause pause)
+{
+    if (page.phase != RecoveryPhase::Restoring) {
+        const auto result = probe();
+        if (result == PreferenceRead::Valid)
+            return LegionBootRecovery::None;
+        if (result == PreferenceRead::Temporary || result == PreferenceRead::Unsupported)
+            return LegionBootRecovery::Blocked;
+        for (uint8_t retry = 0; retry < 2; ++retry) {
+            pause();
+            if (probe() != result)
+                return LegionBootRecovery::Blocked;
+        }
+        page.restoreAttempts = 0;
+        page.noticeAttempts = 0;
+    }
+    if (page.restoreAttempts >= RECOVERY_MAX_ATTEMPTS)
+        return LegionBootRecovery::Blocked;
+    page.phase = RecoveryPhase::Restoring;
+    ++page.restoreAttempts;
+    if (!store.commit(page) || !restore())
+        return LegionBootRecovery::Blocked;
+    return LegionBootRecovery::Restored;
+}
+} // namespace legion
diff --git a/src/mesh/LegionRecoveryStore.h b/src/mesh/LegionRecoveryStore.h
new file mode 100644
index 0000000..25abfcb
--- /dev/null
+++ b/src/mesh/LegionRecoveryStore.h
@@ -0,0 +1,139 @@
+#pragma once
+
+#include "LegionCrc32.h"
+#include <cstddef>
+#include <cstdint>
+#include <cstring>
+#include <memory>
+#include <new>
+
+namespace legion
+{
+constexpr uint32_t RECOVERY_BASE = 0xe8000;
+constexpr size_t RECOVERY_PAGE_SIZE = 4096;
+constexpr size_t RECOVERY_PAYLOAD_SIZE = 3072;
+constexpr uint32_t RECOVERY_MAGIC = 0x3147524c;
+constexpr uint32_t RECOVERY_SCHEMA = 0x04cb8881;
+constexpr uint32_t RECOVERY_MAX_ATTEMPTS = 3;
+
+enum class RecoveryPhase : uint32_t { Deleted, Armed, Restoring, NoticePending, NoticeSent };
+enum class RecoveryRead { Empty, Valid, Incompatible, Failed };
+
+struct RecoveryPage {
+    uint32_t magic;
+    uint32_t schema;
+    uint32_t generation;
+    uint32_t device[2];
+    uint32_t node;
+    RecoveryPhase phase;
+    uint32_t restoreAttempts;
+    uint32_t noticeAttempts;
+    uint32_t payloadSize;
+    uint32_t hasPosition;
+    int32_t latitude;
+    int32_t longitude;
+    int32_t altitude;
+    uint32_t crc;
+    uint8_t payload[RECOVERY_PAYLOAD_SIZE];
+    uint8_t reserved[RECOVERY_PAGE_SIZE - 60 - RECOVERY_PAYLOAD_SIZE];
+};
+static_assert(sizeof(RecoveryPage) == RECOVERY_PAGE_SIZE, "Recovery page layout changed");
+
+inline uint32_t recoveryCrc(const RecoveryPage &page)
+{
+    const auto *bytes = reinterpret_cast<const uint8_t *>(&page);
+    uint32_t crc = UINT32_MAX;
+    for (size_t i = 0; i < sizeof(page); ++i) {
+        if (i < offsetof(RecoveryPage, crc) || i >= offsetof(RecoveryPage, crc) + sizeof(page.crc))
+            crc = legionCrc32Update(crc, bytes[i]);
+    }
+    return ~crc;
+}
+
+class RecoveryFlash
+{
+  public:
+    virtual ~RecoveryFlash() = default;
+    virtual bool read(uint8_t slot, RecoveryPage &page) = 0;
+    virtual bool write(uint8_t slot, const RecoveryPage &page) = 0;
+};
+
+// Every transition replaces a complete alternate page; neither page needs an
+// in-place commit word.
+class RecoveryStore
+{
+  public:
+    explicit RecoveryStore(RecoveryFlash &backend) : flash(backend) {}
+
+    RecoveryRead load(RecoveryPage &page)
+    {
+        active = -1;
+        std::unique_ptr<RecoveryPage> candidate(new (std::nothrow) RecoveryPage);
+        if (!candidate)
+            return RecoveryRead::Failed;
+        for (uint8_t slot = 0; slot < 2; ++slot) {
+            if (!flash.read(slot, *candidate))
+                return RecoveryRead::Failed;
+            if (!validEnvelope(*candidate))
+                continue;
+            if (active < 0 || candidate->generation > page.generation) {
+                page = *candidate;
+                active = slot;
+            } else if (candidate->generation == page.generation && std::memcmp(candidate.get(), &page, sizeof(page))) {
+                return RecoveryRead::Failed;
+            }
+        }
+        if (active < 0) {
+            std::memset(&page, 0, sizeof(page));
+            return RecoveryRead::Empty;
+        }
+        if (page.schema != RECOVERY_SCHEMA)
+            return RecoveryRead::Incompatible;
+        return validContents(page) ? RecoveryRead::Valid : RecoveryRead::Failed;
+    }
+
+    bool commit(RecoveryPage &page)
+    {
+        if (page.generation >= UINT32_MAX - 1)
+            return false;
+        std::unique_ptr<RecoveryPage> next(new (std::nothrow) RecoveryPage(page));
+        if (!next)
+            return false;
+        next->magic = RECOVERY_MAGIC;
+        next->schema = RECOVERY_SCHEMA;
+        ++next->generation;
+        next->crc = recoveryCrc(*next);
+        if (!validContents(*next))
+            return false;
+        const uint8_t slot = active == 0 ? 1 : 0;
+        if (!flash.write(slot, *next))
+            return false;
+        // Read through the backend only after physical flush, never through its
+        // page cache.
+        std::unique_ptr<RecoveryPage> verified(new (std::nothrow) RecoveryPage);
+        if (!verified || !flash.read(slot, *verified) || std::memcmp(next.get(), verified.get(), sizeof(page)))
+            return false;
+        page = *next;
+        active = slot;
+        return true;
+    }
+
+    static bool validEnvelope(const RecoveryPage &page)
+    {
+        return page.magic == RECOVERY_MAGIC && page.generation && page.generation != UINT32_MAX && page.crc == recoveryCrc(page);
+    }
+
+    static bool validContents(const RecoveryPage &page)
+    {
+        if (page.schema != RECOVERY_SCHEMA || page.phase > RecoveryPhase::NoticeSent ||
+            page.restoreAttempts > RECOVERY_MAX_ATTEMPTS || page.noticeAttempts > RECOVERY_MAX_ATTEMPTS ||
+            page.payloadSize > RECOVERY_PAYLOAD_SIZE || page.hasPosition > 1)
+            return false;
+        return page.phase == RecoveryPhase::Deleted ? page.payloadSize == 0 : page.payloadSize > 0 && page.node != 0;
+    }
+
+  private:
+    RecoveryFlash &flash;
+    int active = -1;
+};
+} // namespace legion
