+bool CryptoEngine::matchesIdentityKey(const uint8_t *privateKey, const uint8_t *publicKey)
+{
+    const auto matches = [&]() {
+        uint8_t derived[32]{};
+        return x25519(derived, privateKey, nullptr) && !Curve25519::isWeakPoint(derived) && std::memcmp(derived, publicKey, 32) == 0;
+    };
+    // NodeDB validates boot preferences before Router creates the shared crypto mutex.
+    if (!cryptLock)
+        return matches();
+    concurrency::LockGuard guard(cryptLock);
+    return matches();
+}
+#endif
