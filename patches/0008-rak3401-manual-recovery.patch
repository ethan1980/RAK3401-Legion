@@ -0,0 +1,483 @@
+#include "LegionRecovery.h"
+
+#if RAK3401_LEGION_RECOVERY
+#include "CryptoEngine.h"
+#include "FSCommon.h"
+#include "LegionPersistence.h"
+#include "NodeDB.h"
+#include "SPILock.h"
+#include "concurrency/LockGuard.h"
+#include "flash/flash_nrf5x.h"
+#include "main.h"
+#include "modules/AdminModule.h"
+#include "power/PowerHAL.h"
+#include <ErriezCRC32.h>
+#include <cstdio>
+#include <pb_decode.h>
+#include <pb_encode.h>
+#ifdef MESHTASTIC_ENCRYPTED_STORAGE
+#include "security/EncryptedStorage.h"
+#endif
+
+namespace
+{
+using legion::RecoveryPage;
+using legion::RecoveryPhase;
+using legion::RecoveryRead;
+
+class Flash final : public legion::RecoveryFlash
+{
+  public:
+    bool read(uint8_t slot, RecoveryPage &page) override
+    {
+        if (slot > 1)
+            return false;
+        std::memcpy(&page, reinterpret_cast<const void *>(legion::RECOVERY_BASE + slot * sizeof(page)), sizeof(page));
+        return true;
+    }
+
+    bool write(uint8_t slot, const RecoveryPage &page) override
+    {
+        if (slot > 1 || !powerHAL_isPowerLevelSafe())
+            return false;
+        concurrency::LockGuard guard(spiLock);
+        FSCom._lockFS();
+        // The framework flush erases/programs a complete page, so only replace the
+        // inactive slot.
+        flash_nrf5x_flush();
+        const bool safe = powerHAL_isPowerLevelSafe();
+        const uint32_t address = legion::RECOVERY_BASE + slot * sizeof(page);
+        const bool written = safe && flash_nrf5x_write(address, &page, sizeof(page)) == sizeof(page);
+        if (written)
+            flash_nrf5x_flush();
+        const bool verified = written && std::memcmp(reinterpret_cast<const void *>(address), &page, sizeof(page)) == 0;
+        FSCom._unlockFS();
+        return verified;
+    }
+};
+
+Flash flash;
+legion::RecoveryStore store(flash);
+bool restoredThisBoot = false;
+bool noticePending = false;
+bool persistenceBlocked = false;
+
+template <typename T> std::unique_ptr<T> allocate()
+{
+    return std::unique_ptr<T>(new (std::nothrow) T{});
+}
+
+bool boundToDevice(const RecoveryPage &page)
+{
+    return page.device[0] == NRF_FICR->DEVICEID[0] && page.device[1] == NRF_FICR->DEVICEID[1];
+}
+
+bool compatibleStorage()
+{
+#ifdef MESHTASTIC_ENCRYPTED_STORAGE
+    if (EncryptedStorage::isLockdownActive())
+        return false;
+#endif
+#if USERPREFS_EVENT_MODE
+    return false;
+#else
+    return true;
+#endif
+}
+
+bool identityValid(const meshtastic_LocalConfig &settings, uint32_t expectedNode = 0)
+{
+    if (!settings.has_security || settings.security.private_key.size != 32 || settings.security.public_key.size != 32)
+        return false;
+    const auto *key = settings.security.private_key.bytes;
+    if ((key[0] & 7) || (key[31] & 0xc0) != 0x40)
+        return false;
+    if (!crypto || !crypto->matchesIdentityKey(key, settings.security.public_key.bytes))
+        return false;
+    const uint32_t node = crc32Buffer(settings.security.public_key.bytes, 32);
+    return node && (!expectedNode || node == expectedNode);
+}
+
+bool snapshotValid(const RecoveryPage &page, meshtastic_BackupPreferences &backup)
+{
+    if (!boundToDevice(page) || page.phase == RecoveryPhase::Deleted)
+        return false;
+    pb_istream_t stream = pb_istream_from_buffer(page.payload, page.payloadSize);
+    return pb_decode(&stream, &meshtastic_BackupPreferences_msg, &backup) && backup.version == DEVICESTATE_CUR_VER &&
+           backup.has_config && backup.has_module_config && backup.has_channels && backup.has_owner &&
+           backup.config.version == DEVICESTATE_CUR_VER && backup.module_config.version >= DEVICESTATE_MIN_VER &&
+           backup.channels.version >= DEVICESTATE_MIN_VER && backup.channels.channels_count > 0 && !backup.owner.is_licensed &&
+           !backup.owner.is_unmessagable && identityValid(backup.config, page.node) &&
+           backup.config.position.fixed_position == static_cast<bool>(page.hasPosition);
+}
+
+using legion::PreferenceRead;
+
+PreferenceRead probe(const char *name, size_t maximum, const pb_msgdesc_t *fields, void *object)
+{
+    concurrency::LockGuard guard(spiLock);
+    if (!FSCom.exists("/"))
+        return PreferenceRead::Temporary;
+    if (!FSCom.exists(name))
+        return PreferenceRead::Missing;
+    auto file = FSCom.open(name, FILE_O_READ);
+    if (!file)
+        return PreferenceRead::Temporary;
+    const size_t size = file.size();
+    if (!size || size > maximum) {
+        file.close();
+        return PreferenceRead::Corrupt;
+    }
+    std::unique_ptr<uint8_t[]> bytes(new (std::nothrow) uint8_t[size]);
+    if (!bytes)
+        return PreferenceRead::Temporary;
+    const bool read = file.read(bytes.get(), size) == static_cast<int>(size);
+    file.close();
+    if (!read)
+        return PreferenceRead::Temporary;
+    pb_istream_t stream = pb_istream_from_buffer(bytes.get(), size);
+    const bool decoded = pb_decode(&stream, fields, object);
+    // Config buffers include private keys; clear temporary encoded bytes before
+    // releasing them.
+    volatile uint8_t *wipe = bytes.get();
+    for (size_t i = 0; i < size; ++i)
+        wipe[i] = 0;
+    return decoded ? PreferenceRead::Valid : PreferenceRead::Corrupt;
+}
+
+PreferenceRead versioned(PreferenceRead result, uint32_t version, uint32_t maximum = DEVICESTATE_CUR_VER)
+{
+    if (result == PreferenceRead::Valid && (version < DEVICESTATE_MIN_VER || version > maximum))
+        return PreferenceRead::Unsupported;
+    return result;
+}
+
+PreferenceRead preferences()
+{
+    auto cfg = allocate<meshtastic_LocalConfig>();
+    auto modules = allocate<meshtastic_LocalModuleConfig>();
+    auto channels = allocate<meshtastic_ChannelFile>();
+    auto device = allocate<meshtastic_DeviceState>();
+    if (!cfg || !modules || !channels || !device)
+        return PreferenceRead::Temporary;
+    PreferenceRead results[4];
+    results[0] = probe(configFileName, meshtastic_LocalConfig_size, &meshtastic_LocalConfig_msg, cfg.get());
+    results[0] = versioned(results[0], cfg->version);
+    results[1] = probe(moduleConfigFileName, meshtastic_LocalModuleConfig_size, &meshtastic_LocalModuleConfig_msg, modules.get());
+    results[1] = versioned(results[1], modules->version, POSITION_TELEMETRY_OPTIN_VER);
+    results[2] = probe(channelFileName, meshtastic_ChannelFile_size, &meshtastic_ChannelFile_msg, channels.get());
+    results[2] = versioned(results[2], channels->version, POSITION_TELEMETRY_OPTIN_VER);
+    results[3] = probe(deviceStateFileName, meshtastic_DeviceState_size, &meshtastic_DeviceState_msg, device.get());
+    results[3] = versioned(results[3], device->version);
+    if (results[0] == PreferenceRead::Valid && (!cfg->has_lora || !identityValid(*cfg)))
+        results[0] = PreferenceRead::Corrupt;
+    if (results[2] == PreferenceRead::Valid && !channels->channels_count)
+        results[2] = PreferenceRead::Corrupt;
+    if (results[3] == PreferenceRead::Valid && !device->has_owner)
+        results[3] = PreferenceRead::Corrupt;
+    // Temporary/unsupported storage must never be classified as confirmed loss of
+    // preferences.
+    for (auto result : results)
+        if (result == PreferenceRead::Temporary || result == PreferenceRead::Unsupported)
+            return result;
+    for (auto result : results)
+        if (result != PreferenceRead::Valid)
+            return result;
+    return PreferenceRead::Valid;
+}
+
+bool persist(const char *name, size_t maximum, const pb_msgdesc_t *fields, const void *object)
+{
+    if (!powerHAL_isPowerLevelSafe() || !legionSaveProto(name, maximum, fields, object, true))
+        return false;
+    {
+        concurrency::LockGuard guard(spiLock);
+        FSCom._lockFS();
+        flash_nrf5x_flush();
+        FSCom._unlockFS();
+    }
+    return legionProtoMatchesFile(name, maximum, fields, object);
+}
+
+bool restore(const RecoveryPage &page, const meshtastic_BackupPreferences &backup)
+{
+    auto device = allocate<meshtastic_DeviceState>();
+    if (!device)
+        return false;
+    device->version = DEVICESTATE_CUR_VER;
+    device->has_owner = true;
+    device->owner = backup.owner;
+    device->has_my_node = true;
+    device->my_node.my_node_num = page.node;
+    {
+        concurrency::LockGuard guard(spiLock);
+        FSCom.mkdir("/prefs");
+    }
+    return persist(configFileName, meshtastic_LocalConfig_size, &meshtastic_LocalConfig_msg, &backup.config) &&
+           persist(moduleConfigFileName, meshtastic_LocalModuleConfig_size, &meshtastic_LocalModuleConfig_msg,
+                   &backup.module_config) &&
+           persist(channelFileName, meshtastic_ChannelFile_size, &meshtastic_ChannelFile_msg, &backup.channels) &&
+           persist(deviceStateFileName, meshtastic_DeviceState_size, &meshtastic_DeviceState_msg, device.get());
+}
+} // namespace
+
+LegionBootRecovery legionRecoveryBoot()
+{
+    auto page = allocate<RecoveryPage>();
+    if (!page)
+        return LegionBootRecovery::Blocked;
+    const auto state = store.load(*page);
+    if (state == RecoveryRead::Empty || (state == RecoveryRead::Valid && page->phase == RecoveryPhase::Deleted))
+        return LegionBootRecovery::None;
+    if (state != RecoveryRead::Valid || !compatibleStorage() || !boundToDevice(*page))
+        return LegionBootRecovery::None;
+    auto backup = allocate<meshtastic_BackupPreferences>();
+    if (!backup || !snapshotValid(*page, *backup))
+        return LegionBootRecovery::Blocked;
+    noticePending = page->phase == RecoveryPhase::NoticePending && page->noticeAttempts < legion::RECOVERY_MAX_ATTEMPTS;
+    const auto outcome =
+        legion::runRecovery(store, *page, preferences, [&]() { return restore(*page, *backup); }, []() { delay(100); });
+    restoredThisBoot = outcome == LegionBootRecovery::Restored;
+    if (restoredThisBoot)
+        LOG_WARN("Legion restored rescue preferences; completing identity and fixed position");
+    return outcome;
+}
+
+bool legionRecoveryPosition(meshtastic_PositionLite &position, bool &present)
+{
+    present = false;
+    if (!restoredThisBoot)
+        return false;
+    auto page = allocate<RecoveryPage>();
+    if (!page || store.load(*page) != RecoveryRead::Valid)
+        return false;
+    present = page->hasPosition != 0;
+    if (!present)
+        return true;
+    position = meshtastic_PositionLite_init_zero;
+    position.latitude_i = page->latitude;
+    position.longitude_i = page->longitude;
+    position.altitude = page->altitude;
+    position.location_source = meshtastic_Position_LocSource_LOC_MANUAL;
+    return true;
+}
+
+bool legionRecoveryFinish()
+{
+    auto page = allocate<RecoveryPage>();
+    if (!restoredThisBoot || !page || store.load(*page) != RecoveryRead::Valid || page->phase != RecoveryPhase::Restoring ||
+        !identityValid(config, page->node) || preferences() != PreferenceRead::Valid)
+        return false;
+    page->phase = RecoveryPhase::NoticePending;
+    page->noticeAttempts = 0;
+    const bool committed = store.commit(*page);
+    if (committed) {
+        restoredThisBoot = false;
+        noticePending = true;
+    }
+    return committed;
+}
+
+void legionRecoveryCommand(LegionBackupCommand command, char *reply, size_t size)
+{
+    const uint32_t node = nodeDB->getNodeNum();
+    const auto respond = [&](const char *message) {
+        std::snprintf(reply, size, "Backup !%08lx: %s", (unsigned long)node, message);
+    };
+    auto page = allocate<RecoveryPage>();
+    if (!page) {
+        respond("not enough memory");
+        return;
+    }
+    const auto state = store.load(*page);
+    const bool exists = state == RecoveryRead::Valid && page->phase != RecoveryPhase::Deleted;
+    if (command == LegionBackupCommand::Status) {
+        auto backup = allocate<meshtastic_BackupPreferences>();
+        if (exists && backup && snapshotValid(*page, *backup)) {
+            if (page->phase == RecoveryPhase::Restoring)
+                respond("recovery incomplete; inspect logs before retrying");
+            else
+                respond("valid rescue point; recovery armed");
+        } else
+            respond(state == RecoveryRead::Empty || (state == RecoveryRead::Valid && !exists)
+                        ? "no rescue point; recovery disabled"
+                        : "rescue point invalid or incompatible");
+        return;
+    }
+    if (state != RecoveryRead::Valid && state != RecoveryRead::Empty) {
+        respond("storage invalid or incompatible; no changes");
+        return;
+    }
+    if (command == LegionBackupCommand::Create && exists) {
+        respond("already exists; use /backup replace !xxxxxxxx");
+        return;
+    }
+    if ((adminModule && adminModule->isEditingSettings()) || rebootAtMsec || !compatibleStorage()) {
+        respond("configuration busy or unsupported; no changes");
+        return;
+    }
+    if (command == LegionBackupCommand::Delete) {
+        if (!exists) {
+            respond("no rescue point; recovery disabled");
+            return;
+        }
+        const uint32_t generation = page->generation;
+        std::memset(page.get(), 0, sizeof(*page));
+        page->generation = generation;
+        page->phase = RecoveryPhase::Deleted;
+        respond(store.commit(*page) ? "deleted; recovery disabled" : "delete failed; previous state retained");
+        return;
+    }
+    auto backup = allocate<meshtastic_BackupPreferences>();
+    if (!backup || !identityValid(config, node) || owner.is_licensed || !config.has_lora) {
+        respond("identity/configuration not ready; no changes");
+        return;
+    }
+    backup->version = DEVICESTATE_CUR_VER;
+    backup->has_config = backup->has_module_config = backup->has_channels = backup->has_owner = true;
+    backup->config = config;
+    backup->module_config = moduleConfig;
+    backup->channels = channelFile;
+    std::memcpy(backup->owner.long_name, owner.long_name, sizeof(owner.long_name));
+    std::memcpy(backup->owner.short_name, owner.short_name, sizeof(owner.short_name));
+    backup->owner.public_key = owner.public_key;
+    const uint32_t generation = page->generation;
+    auto next = allocate<RecoveryPage>();
+    if (!next) {
+        respond("not enough memory");
+        return;
+    }
+    next->generation = generation;
+    next->device[0] = NRF_FICR->DEVICEID[0];
+    next->device[1] = NRF_FICR->DEVICEID[1];
+    next->node = node;
+    next->phase = RecoveryPhase::Armed;
+    if (config.position.fixed_position) {
+        meshtastic_PositionLite position;
+        if (!nodeDB->copyNodePosition(node, position)) {
+            respond("fixed position unavailable; no changes");
+            return;
+        }
+        next->hasPosition = 1;
+        next->latitude = position.latitude_i;
+        next->longitude = position.longitude_i;
+        next->altitude = position.altitude;
+    }
+    pb_ostream_t output = pb_ostream_from_buffer(next->payload, sizeof(next->payload));
+    if (!pb_encode(&output, &meshtastic_BackupPreferences_msg, backup.get())) {
+        respond("configuration too large or invalid; no changes");
+        return;
+    }
+    next->payloadSize = output.bytes_written;
+    if (exists && page->payloadSize == next->payloadSize && page->hasPosition == next->hasPosition &&
+        page->latitude == next->latitude && page->longitude == next->longitude && page->altitude == next->altitude &&
+        std::memcmp(page->payload, next->payload, next->payloadSize) == 0) {
+        respond("already up to date; no flash write");
+        return;
+    }
+    respond(store.commit(*next) ? "saved and verified; recovery armed" : "save failed; previous rescue point retained");
+}
+
+bool legionRecoveryNotice(char *text, size_t size, uint8_t channel)
+{
+    if (!noticePending || !config.lora.tx_enabled || config.lora.region == meshtastic_Config_LoRaConfig_RegionCode_UNSET)
+        return false;
+    auto page = allocate<RecoveryPage>();
+    if (!page || store.load(*page) != RecoveryRead::Valid || page->phase != RecoveryPhase::NoticePending ||
+        page->noticeAttempts >= legion::RECOVERY_MAX_ATTEMPTS || !identityValid(config, page->node))
+        return false;
+    auto backup = allocate<meshtastic_BackupPreferences>();
+    if (!backup || !snapshotValid(*page, *backup) || channel >= backup->channels.channels_count ||
+        channel >= channelFile.channels_count)
+        return false;
+    const auto &saved = backup->channels.channels[channel];
+    const auto &current = channelFile.channels[channel];
+    if (saved.role != meshtastic_Channel_Role_SECONDARY || !saved.has_settings || !current.has_settings ||
+        std::strcmp(saved.settings.name, "LegionRF") || std::strcmp(current.settings.name, "LegionRF") ||
+        saved.settings.psk.size != current.settings.psk.size || saved.settings.use_aead != current.settings.use_aead ||
+        std::memcmp(saved.settings.psk.bytes, current.settings.psk.bytes, saved.settings.psk.size))
+        return false;
+    char id[10];
+    std::snprintf(id, sizeof(id), "!%08lx", (unsigned long)page->node);
+    const char *name = *owner.long_name ? owner.long_name : *owner.short_name ? owner.short_name : id;
+    const int length = std::snprintf(text, size, "Ashes to ashes, dust to dust, the node %s has risen again", name);
+    return length > 0 && static_cast<size_t>(length) < size;
+}
+
+bool legionRecoveryNoticeAttempt()
+{
+    auto page = allocate<RecoveryPage>();
+    if (!page || store.load(*page) != RecoveryRead::Valid || page->phase != RecoveryPhase::NoticePending ||
+        page->noticeAttempts >= legion::RECOVERY_MAX_ATTEMPTS)
+        return false;
+    ++page->noticeAttempts;
+    return store.commit(*page);
+}
+
+void legionRecoveryNoticeQueued()
+{
+    noticePending = false;
+    auto page = allocate<RecoveryPage>();
+    if (page && store.load(*page) == RecoveryRead::Valid && page->phase == RecoveryPhase::NoticePending) {
+        page->phase = RecoveryPhase::NoticeSent;
+        store.commit(*page);
+    }
+}
+
+bool legionRecoveryForgetIdentity()
+{
+    auto page = allocate<RecoveryPage>();
+    if (!page)
+        return false;
+    const auto state = store.load(*page);
+    if (state == RecoveryRead::Empty || (state == RecoveryRead::Valid && page->phase == RecoveryPhase::Deleted))
+        return true;
+    if (state != RecoveryRead::Valid)
+        return false;
+    const uint32_t generation = page->generation;
+    std::memset(page.get(), 0, sizeof(*page));
+    page->generation = generation;
+    page->phase = RecoveryPhase::Deleted;
+    return store.commit(*page);
+}
+
+bool legionRecoveryAcceptIdentity(uint32_t node)
+{
+    auto page = allocate<RecoveryPage>();
+    if (!page)
+        return false;
+    const auto state = store.load(*page);
+    if (state == RecoveryRead::Empty)
+        return true;
+    if (state != RecoveryRead::Valid)
+        return false;
+    return page->phase == RecoveryPhase::Deleted || page->node == node || legionRecoveryForgetIdentity();
+}
+
+bool legionRecoveryIsBlocked()
+{
+    return persistenceBlocked;
+}
+
+void legionRecoveryBlock()
+{
+    persistenceBlocked = true;
+}
+
+int legionRecoveryFactoryReset()
+{
+    auto page = allocate<RecoveryPage>();
+    if (!page)
+        return -1;
+    const auto state = store.load(*page);
+    if (state == RecoveryRead::Empty || (state == RecoveryRead::Valid && page->phase == RecoveryPhase::Deleted))
+        return 0;
+    auto backup = allocate<meshtastic_BackupPreferences>();
+    if (state != RecoveryRead::Valid || !backup || !snapshotValid(*page, *backup))
+        return -1;
+    page->phase = RecoveryPhase::Restoring;
+    page->restoreAttempts = 0;
+    page->noticeAttempts = 0;
+    return store.commit(*page) ? 1 : -1;
+}
+#endif
