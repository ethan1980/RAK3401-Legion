diff --git a/src/modules/LegionControlPolicy.h b/src/modules/LegionControlPolicy.h
new file mode 100644
index 0000000..d3aa404
--- /dev/null
+++ b/src/modules/LegionControlPolicy.h
@@ -0,0 +1,382 @@
+#pragma once
+
+#include "LegionTelemetryPolicy.h"
+#include <algorithm>
+#include <cmath>
+#include <cstdio>
+
+namespace legion
+{
+constexpr size_t CONTROL_TEXT_MAX = 199;
+constexpr uint32_t CONTROL_COOLDOWN_MS = 5000;
+constexpr uint32_t CONTROL_SNAPSHOT_MS = 15 * 60 * 1000;
+constexpr size_t CONTROL_DIRECTORY_MAX = 128;
+
+enum class ControlCommand : uint8_t { None, Message, Reboot, ZeroHop, Ignore, Unignore, IgnoreList };
+struct ControlRequest {
+    ControlCommand command = ControlCommand::None;
+    uint32_t node = 0;
+    uint16_t page = 1;
+    char channel[12]{};
+    char text[CONTROL_TEXT_MAX + 1]{};
+    bool valid = false;
+    bool group = false;
+};
+
+inline bool validPeer(uint32_t node)
+{
+    return node >= 4 && node != UINT32_MAX;
+}
+
+inline bool validUtf8(const uint8_t *data, size_t size)
+{
+    for (size_t i = 0; i < size;) {
+        uint32_t c = data[i++];
+        if (c < 0x80) {
+            if (!c || (c < 0x20 && !commandSpace(c)) || c == 0x7f)
+                return false;
+            continue;
+        }
+        size_t extra;
+        uint32_t minimum;
+        if (c >= 0xc2 && c <= 0xdf) {
+            extra = 1;
+            minimum = 0x80;
+            c &= 0x1f;
+        } else if (c >= 0xe0 && c <= 0xef) {
+            extra = 2;
+            minimum = 0x800;
+            c &= 0xf;
+        } else if (c >= 0xf0 && c <= 0xf4) {
+            extra = 3;
+            minimum = 0x10000;
+            c &= 7;
+        } else
+            return false;
+        if (extra > size - i)
+            return false;
+        while (extra--) {
+            const auto next = data[i++];
+            if ((next & 0xc0) != 0x80)
+                return false;
+            c = (c << 6) | (next & 0x3f);
+        }
+        if (c < minimum || c > 0x10ffff || (c >= 0xd800 && c <= 0xdfff))
+            return false;
+    }
+    return true;
+}
+
+class ControlParser
+{
+  public:
+    ControlParser(const uint8_t *data, size_t size) : data(data), size(size) {}
+    void spaces()
+    {
+        while (size && commandSpace(*data)) {
+            ++data;
+            --size;
+        }
+    }
+    bool token(const char *value)
+    {
+        spaces();
+        const auto length = std::strlen(value);
+        if (size < length || std::memcmp(data, value, length) || (size > length && !commandSpace(data[length])))
+            return false;
+        data += length;
+        size -= length;
+        return true;
+    }
+    bool node(uint32_t &value)
+    {
+        spaces();
+        if (size < 9 || data[0] != '!' || (size > 9 && !commandSpace(data[9])))
+            return false;
+        value = 0;
+        for (size_t i = 1; i < 9; ++i) {
+            const uint8_t c = data[i];
+            uint8_t digit;
+            if (c >= '0' && c <= '9')
+                digit = c - '0';
+            else if (c >= 'a' && c <= 'f')
+                digit = c - 'a' + 10;
+            else if (c >= 'A' && c <= 'F')
+                digit = c - 'A' + 10;
+            else
+                return false;
+            value = (value << 4) | digit;
+        }
+        data += 9;
+        size -= 9;
+        return true;
+    }
+    bool page(uint16_t &value)
+    {
+        spaces();
+        if (!size)
+            return true;
+        value = 0;
+        while (size && *data >= '0' && *data <= '9') {
+            if (value > 1000)
+                return false;
+            value = value * 10 + (*data++ - '0');
+            --size;
+        }
+        return value && end();
+    }
+    bool message(ControlRequest &request)
+    {
+        spaces();
+        if (!size)
+            return false;
+        const bool quoted = *data == '"';
+        if (quoted) {
+            ++data;
+            --size;
+        }
+        size_t length = 0;
+        while (size && (quoted ? *data != '"' : !commandSpace(*data))) {
+            if (length + 1 >= sizeof(request.channel))
+                return false;
+            request.channel[length++] = *data++;
+            --size;
+        }
+        if (!length || (quoted && (!size || *data != '"')))
+            return false;
+        if (quoted) {
+            ++data;
+            --size;
+        }
+        if (!size || !commandSpace(*data))
+            return false;
+        spaces();
+        if (!size || size > CONTROL_TEXT_MAX || !validUtf8(data, size) ||
+            !validUtf8(reinterpret_cast<const uint8_t *>(request.channel), length))
+            return false;
+        std::memcpy(request.text, data, size);
+        return true;
+    }
+    bool end()
+    {
+        spaces();
+        return !size;
+    }
+
+  private:
+    const uint8_t *data;
+    size_t size;
+};
+
+inline ControlRequest parseControl(const uint8_t *data, size_t size, uint32_t ownNode)
+{
+    ControlRequest result;
+    if (!data || !ownNode || size > 233)
+        return result;
+    ControlParser parser(data, size);
+    if (parser.token("/msg"))
+        result.command = ControlCommand::Message;
+    else if (parser.token("/reboot"))
+        result.command = ControlCommand::Reboot;
+    else if (parser.token("/zerohop"))
+        result.command = ControlCommand::ZeroHop;
+    else if (parser.token("/ignore")) {
+        result.command = ControlCommand::Ignore;
+        result.group = true;
+    } else if (parser.token("/unignore")) {
+        result.command = ControlCommand::Unignore;
+        result.group = true;
+    } else if (parser.token("/ignorelist")) {
+        result.command = ControlCommand::IgnoreList;
+        result.group = true;
+    } else
+        return result;
+    if (result.command == ControlCommand::IgnoreList) {
+        result.valid = parser.page(result.page);
+        return result;
+    }
+    if (!parser.node(result.node) || (!result.group && result.node != ownNode)) {
+        if (!result.group)
+            result.command = ControlCommand::None;
+        return result;
+    }
+    if (result.command == ControlCommand::Message)
+        result.valid = parser.message(result);
+    else if (result.command == ControlCommand::ZeroHop)
+        result.valid = parser.page(result.page);
+    else
+        result.valid = parser.end();
+    return result;
+}
+
+class ControlGate
+{
+  public:
+    bool reserve(uint32_t from, uint32_t id, uint32_t now, uint32_t delayMs)
+    {
+        if (pending || (cooling && !Throttle::deadlinePassedAt(now, nextAllowed)))
+            return false;
+        for (const auto &entry : seen)
+            if (entry.used && entry.from == from && entry.id == id && !Throttle::deadlinePassedAt(now, entry.expires))
+                return false;
+        seen[nextSeen] = {from, id, now + CONTROL_SNAPSHOT_MS, true};
+        nextSeen = (nextSeen + 1) % 16;
+        due = now + delayMs;
+        pending = true;
+        return true;
+    }
+    bool ready(uint32_t now) const { return pending && Throttle::deadlinePassedAt(now, due); }
+    void finish(uint32_t now)
+    {
+        pending = false;
+        cooling = true;
+        nextAllowed = now + CONTROL_COOLDOWN_MS;
+    }
+
+  private:
+    struct Seen {
+        uint32_t from = 0, id = 0, expires = 0;
+        bool used = false;
+    };
+    Seen seen[16]{};
+    size_t nextSeen = 0;
+    uint32_t due = 0, nextAllowed = 0;
+    bool pending = false, cooling = false;
+};
+
+class DirectLinkWitness
+{
+  public:
+    void observe(uint32_t node, uint32_t generation, bool direct)
+    {
+        for (auto &entry : entries)
+            if (entry.node == node) {
+                entry = direct ? Entry{node, generation} : Entry{};
+                return;
+            }
+        if (!direct)
+            return;
+        for (auto &entry : entries)
+            if (!entry.node) {
+                entry = {node, generation};
+                return;
+            }
+        entries[next] = {node, generation};
+        next = (next + 1) % CONTROL_DIRECTORY_MAX;
+        incomplete = true;
+    }
+    bool qualifies(uint32_t node, uint32_t generation) const
+    {
+        for (const auto &entry : entries)
+            if (entry.node == node && entry.generation == generation)
+                return true;
+        return false;
+    }
+    bool overflowed() const { return incomplete; }
+
+  private:
+    struct Entry {
+        uint32_t node = 0, generation = 0;
+    };
+    Entry entries[CONTROL_DIRECTORY_MAX]{};
+    size_t next = 0;
+    bool incomplete = false;
+};
+
+struct DirectoryRow {
+    uint32_t node = 0;
+    char name[5]{};
+    int16_t snrQ4 = 0;
+};
+
+class ControlDirectory
+{
+  public:
+    void clear(bool snr, uint16_t token)
+    {
+        count = 0;
+        pages = 1;
+        incomplete = false;
+        withSnr = snr;
+        this->token = token;
+    }
+    void add(uint32_t node, const char *name, float snr = 0)
+    {
+        for (size_t i = 0; i < count; ++i)
+            if (rows[i].node == node)
+                return;
+        if (count == CONTROL_DIRECTORY_MAX) {
+            incomplete = true;
+            return;
+        }
+        auto &row = rows[count++];
+        row = {};
+        row.node = node;
+        if (name) {
+            const auto length = strnlen(name, sizeof(row.name));
+            if (length < sizeof(row.name) && validUtf8(reinterpret_cast<const uint8_t *>(name), length) &&
+                !std::strchr(name, '\n') && !std::strchr(name, '\r') && !std::strchr(name, '\t'))
+                std::memcpy(row.name, name, length);
+        }
+        row.snrQ4 = std::isfinite(snr) && snr >= -128 && snr <= 127 ? static_cast<int16_t>(std::lround(snr * 4)) : 0;
+    }
+    void finish()
+    {
+        std::sort(rows, rows + count, [this](const DirectoryRow &a, const DirectoryRow &b) {
+            return withSnr && a.snrQ4 != b.snrQ4 ? a.snrQ4 > b.snrQ4 : a.node < b.node;
+        });
+        pages = 1;
+        starts[0] = 0;
+        size_t bytes = 0, lines = 0;
+        for (size_t i = 0; i < count; ++i) {
+            char line[40];
+            const auto length = formatRow(line, sizeof(line), rows[i]);
+            if (lines == 5 || bytes + length + 1 > CONTROL_TEXT_MAX - 84) {
+                starts[pages++] = i;
+                bytes = 0;
+                lines = 0;
+            }
+            bytes += length + 1;
+            ++lines;
+        }
+        starts[pages] = count;
+    }
+    bool format(char *output, size_t size, uint32_t ownNode, uint16_t page) const
+    {
+        if (!page || page > pages || size < CONTROL_TEXT_MAX + 1)
+            return false;
+        const char *kind = withSnr ? "ZH" : "IG";
+        int used = std::snprintf(output, size, "!%08lx %s#%04x %u/%u n:%u%s%s", (unsigned long)ownNode, kind, token, page, pages,
+                                 count, incomplete ? "+ partial" : "", withSnr ? " SNR" : "");
+        if (!count)
+            used +=
+                std::snprintf(output + used, size - used, "\n%s", withSnr ? "No direct RF nodes this boot" : "No ignored nodes");
+        for (size_t i = starts[page - 1]; i < starts[page]; ++i) {
+            output[used++] = '\n';
+            used += formatRow(output + used, size - used, rows[i]);
+        }
+        if (page < pages) {
+            if (withSnr)
+                used += std::snprintf(output + used, size - used, "\nNext: /zerohop !%08lx %u", (unsigned long)ownNode, page + 1);
+            else
+                used += std::snprintf(output + used, size - used, "\nNext: /ignorelist %u", page + 1);
+        }
+        return used > 0 && static_cast<size_t>(used) <= CONTROL_TEXT_MAX;
+    }
+    void markIncomplete() { incomplete = true; }
+
+  private:
+    int formatRow(char *output, size_t size, const DirectoryRow &row) const
+    {
+        if (!withSnr)
+            return std::snprintf(output, size, "!%08lx%s%s", (unsigned long)row.node, row.name[0] ? " " : "", row.name);
+        const int value = row.snrQ4 < 0 ? -row.snrQ4 : row.snrQ4;
+        return std::snprintf(output, size, "!%08lx %s %c%d.%02ddB", (unsigned long)row.node, row.name[0] ? row.name : "?",
+                             row.snrQ4 < 0 ? '-' : '+', value / 4, (value % 4) * 25);
+    }
+    DirectoryRow rows[CONTROL_DIRECTORY_MAX]{};
+    uint16_t starts[CONTROL_DIRECTORY_MAX + 1]{};
+    uint16_t count = 0, pages = 1, token = 0;
+    bool withSnr = false, incomplete = false;
+};
+} // namespace legion
