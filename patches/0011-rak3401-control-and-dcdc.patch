new file mode 100644
index 0000000..a7f1c90
--- /dev/null
+++ b/src/mesh/LegionIgnore.cpp
@@ -0,0 +1,97 @@
+#include "configuration.h"
+
+#if RAK3401_LEGION_CONTROL
+#include "LegionRecovery.h"
+#include "NodeDB.h"
+#include "Throttle.h"
+#include "UptimeClock.h"
+#include "power/PowerHAL.h"
+#include "power/RAK3401LegionPower.h"
+#include "xmodem.h"
+#if !MESHTASTIC_EXCLUDE_ADMIN
+#include "modules/AdminModule.h"
+#endif
+#ifdef MESHTASTIC_ENCRYPTED_STORAGE
+#include "security/EncryptedStorage.h"
+#endif
+
+bool NodeDB::legionFlushIgnoreChanges(bool force)
+{
+    if (!legionIgnorePendingSegments)
+        return true;
+    if ((!force && legionIgnoreSaveAttempted && !Throttle::hasElapsed(legionIgnoreLastSave, 60000)) ||
+        !powerHAL_isPowerLevelSafe() || !legionBatterySafeForFlash() || legionRecoveryIsBlocked() || xModem.isBusy() ||
+        (!owner.is_licensed && owner.public_key.size != 32))
+        return false;
+#if !MESHTASTIC_EXCLUDE_ADMIN
+    if (adminModule && adminModule->isEditingSettings())
+        return false;
+#endif
+#ifdef MESHTASTIC_ENCRYPTED_STORAGE
+    if (EncryptedStorage::isLockdownActive() && !EncryptedStorage::isUnlocked())
+        return false;
+#endif
+    legionIgnoreSaveAttempted = true;
+    legionIgnoreLastSave = Time::getMillis();
+    if (!saveToDisk(legionIgnorePendingSegments) || ((legionIgnorePendingSegments & SEGMENT_NODEDATABASE) && nodeDatabaseDirty))
+        return false;
+    legionIgnorePendingSegments = 0;
+    return true;
+}
+
+LegionIgnoreResult NodeDB::legionSetIgnored(NodeNum id, bool ignored)
+{
+    if (id < 4 || id == UINT32_MAX || id == getNodeNum())
+        return LegionIgnoreResult::Invalid;
+    if (!powerHAL_isPowerLevelSafe() || !legionBatterySafeForFlash() || legionRecoveryIsBlocked())
+        return LegionIgnoreResult::Unavailable;
+#if !MESHTASTIC_EXCLUDE_ADMIN
+    if (adminModule && adminModule->isEditingSettings())
+        return LegionIgnoreResult::Unavailable;
+#endif
+#ifdef MESHTASTIC_ENCRYPTED_STORAGE
+    if (EncryptedStorage::isLockdownActive() && !EncryptedStorage::isUnlocked())
+        return LegionIgnoreResult::Unavailable;
+#endif
+    auto node = getMeshNode(id);
+    bool legacy = false;
+    for (size_t i = 0; i < config.lora.ignore_incoming_count && i < 3; ++i)
+        legacy |= config.lora.ignore_incoming[i] == id;
+    const bool wasIgnored = legacy || nodeInfoLiteIsIgnored(node);
+    if (wasIgnored == ignored)
+        return legionIgnorePendingSegments ? LegionIgnoreResult::Pending : LegionIgnoreResult::Unchanged;
+    if (ignored) {
+        if (!nodeInfoLiteIsProtected(node) && numProtectedNodes() >= MAX_NUM_NODES - 2)
+            return LegionIgnoreResult::Capacity;
+        if (!node)
+            node = getOrCreateMeshNode(id);
+        if (!node || !setProtectedFlag(node, NODEINFO_BITFIELD_IS_IGNORED_MASK, true))
+            return LegionIgnoreResult::Capacity;
+        eraseNodeSatellites(id);
+        legionIgnorePendingSegments |= SEGMENT_NODEDATABASE;
+    } else {
+        if (nodeInfoLiteIsIgnored(node)) {
+            setProtectedFlag(node, NODEINFO_BITFIELD_IS_IGNORED_MASK, false);
+            legionIgnorePendingSegments |= SEGMENT_NODEDATABASE;
+        }
+        if (legacy) {
+            size_t target = 0;
+            for (size_t i = 0; i < config.lora.ignore_incoming_count && i < 3; ++i) {
+                const auto peer = config.lora.ignore_incoming[i];
+                if (peer && peer != id)
+                    config.lora.ignore_incoming[target++] = peer;
+            }
+            config.lora.ignore_incoming_count = target;
+            while (target < sizeof(config.lora.ignore_incoming) / sizeof(config.lora.ignore_incoming[0]))
+                config.lora.ignore_incoming[target++] = 0;
+            legionIgnorePendingSegments |= SEGMENT_CONFIG;
+        }
+    }
+    if (legionIgnorePendingSegments & SEGMENT_NODEDATABASE)
+        nodeDatabaseDirty = true;
+    notifyObservers(true);
+    // A new explicit change gets one immediate attempt; retries share the normal minute cadence.
+    legionIgnoreSaveAttempted = false;
+    return legionFlushIgnoreChanges() ? LegionIgnoreResult::Saved : LegionIgnoreResult::Pending;
+}
+#endif
