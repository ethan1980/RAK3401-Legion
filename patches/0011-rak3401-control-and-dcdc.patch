diff --git a/src/modules/LegionControlModule.cpp b/src/modules/LegionControlModule.cpp
new file mode 100644
index 0000000..2143ad2
--- /dev/null
+++ b/src/modules/LegionControlModule.cpp
@@ -0,0 +1,344 @@
+#include "LegionControlModule.h"
+
+#if RAK3401_LEGION_CONTROL
+#include "Channels.h"
+#include "MeshService.h"
+#include "NodeDB.h"
+#include "UptimeClock.h"
+#include "concurrency/LockGuard.h"
+#include "main.h"
+#include "mesh/LegionRecovery.h"
+#include "power/RAK3401LegionPower.h"
+#include "xmodem.h"
+#if !MESHTASTIC_EXCLUDE_ADMIN
+#include "modules/AdminModule.h"
+#endif
+
+LegionControlModule *legionControlModule = nullptr;
+
+LegionControlModule::LegionControlModule()
+    : SinglePortModule("legion-control", meshtastic_PortNum_TEXT_MESSAGE_APP), concurrency::OSThread("LegionControl")
+{
+    legionControlModule = this;
+}
+
+bool LegionControlModule::readChannel(uint8_t index, Channel &result) const
+{
+    if (index >= channels.getNumChannels())
+        return false;
+    const auto &channel = channels.getByIndex(index);
+    if (!channel.has_settings || channel.role == meshtastic_Channel_Role_DISABLED || channel.settings.psk.size > 32)
+        return false;
+    result = {};
+    result.index = index;
+    result.role = channel.role;
+    result.keySize = channel.settings.psk.size;
+    std::memcpy(result.key, channel.settings.psk.bytes, result.keySize);
+    const char *name = channels.getName(index);
+    if (!name || strnlen(name, sizeof(result.name)) >= sizeof(result.name))
+        return false;
+    std::strcpy(result.name, name);
+    result.aead = channels.isAEADEnabled(index);
+    result.publicKey = channels.usesPublicKey(index);
+    return true;
+}
+
+bool LegionControlModule::findControlChannel(Channel &result) const
+{
+    if (owner.is_licensed)
+        return false;
+    bool found = false;
+    for (uint8_t i = 1; i < channels.getNumChannels(); ++i) {
+        const auto &channel = channels.getByIndex(i);
+        if (!channel.has_settings || channel.role != meshtastic_Channel_Role_SECONDARY ||
+            std::strncmp(channel.settings.name, legion::TELEMETRY_CHANNEL, sizeof(channel.settings.name)))
+            continue;
+        if (found || !readChannel(i, result) || (result.keySize != 16 && result.keySize != 32) || result.publicKey)
+            return false;
+        uint8_t nonzero = 0;
+        for (size_t k = 0; k < result.keySize; ++k)
+            nonzero |= result.key[k];
+        if (!nonzero)
+            return false;
+        found = true;
+    }
+    return found;
+}
+
+bool LegionControlModule::sameChannel(const Channel &a, const Channel &b)
+{
+    return a.index == b.index && a.role == b.role && a.keySize == b.keySize && a.aead == b.aead && a.publicKey == b.publicKey &&
+           !std::strcmp(a.name, b.name) && !std::memcmp(a.key, b.key, a.keySize);
+}
+
+static bool sameName(const char *a, const char *b)
+{
+    while (*a && *b) {
+        const auto x = *a >= 'A' && *a <= 'Z' ? *a + ('a' - 'A') : *a;
+        const auto y = *b >= 'A' && *b <= 'Z' ? *b + ('a' - 'A') : *b;
+        if (x != y)
+            return false;
+        ++a;
+        ++b;
+    }
+    return *a == *b;
+}
+
+uint8_t LegionControlModule::findDestination(const char *name, Channel &result) const
+{
+    uint8_t count = 0;
+    for (uint8_t i = 0; i < channels.getNumChannels(); ++i) {
+        Channel candidate;
+        if (readChannel(i, candidate) && sameName(candidate.name, name)) {
+            result = candidate;
+            ++count;
+        }
+    }
+    return count;
+}
+
+ProcessMessage LegionControlModule::handleReceived(const meshtastic_MeshPacket &packet)
+{
+    if (packet.which_payload_variant != meshtastic_MeshPacket_decoded_tag ||
+        packet.decoded.portnum != meshtastic_PortNum_TEXT_MESSAGE_APP || !isBroadcast(packet.to) ||
+        packet.decoded.payload.size > sizeof(packet.decoded.payload.bytes))
+        return ProcessMessage::CONTINUE;
+    Channel control;
+    if (!findControlChannel(control) || control.index != packet.channel)
+        return ProcessMessage::CONTINUE;
+    const auto request = legion::parseControl(packet.decoded.payload.bytes, packet.decoded.payload.size, nodeDB->getNodeNum());
+    if (request.command == legion::ControlCommand::None)
+        return ProcessMessage::CONTINUE;
+    const uint32_t now = Time::getMillis();
+    concurrency::LockGuard guard(&stateLock);
+    if (requests.reserve(getFrom(&packet), packet.id, now, request.group ? random(1000, 10001) : random(250, 1001))) {
+        pending = {};
+        pending.request = request;
+        pending.control = control;
+        pending.from = getFrom(&packet);
+        pending.acceptedAt = now;
+        if (request.valid && request.command == legion::ControlCommand::Message)
+            pending.destinationMatches = findDestination(request.channel, pending.destination);
+    }
+    return ProcessMessage::CONTINUE;
+}
+
+void LegionControlModule::observeLink(const meshtastic_MeshPacket &packet, int8_t hopsAway)
+{
+    if (!legion::validPeer(packet.from) || packet.from == nodeDB->getNodeNum())
+        return;
+    const bool direct = packet.transport_mechanism == meshtastic_MeshPacket_TransportMechanism_TRANSPORT_LORA &&
+                        packet.has_rx_rssi && !packet.via_mqtt && hopsAway == 0 && std::isfinite(packet.rx_snr) &&
+                        packet.rx_snr >= -128 && packet.rx_snr <= 127;
+    concurrency::LockGuard guard(&stateLock);
+    directLinks.observe(packet.from, radioGeneration, direct);
+}
+
+void legionControlObserveLink(const meshtastic_MeshPacket &packet, int8_t hopsAway)
+{
+    if (legionControlModule)
+        legionControlModule->observeLink(packet, hopsAway);
+}
+
+bool LegionControlModule::sendText(uint8_t channel, const char *text, bool message)
+{
+    const auto length = std::strlen(text);
+    if (!length || length > legion::CONTROL_TEXT_MAX || !legionPowerTxReady())
+        return false;
+    auto packet = allocDataPacket();
+    if (!packet)
+        return false;
+    packet->channel = channel;
+    packet->to = NODENUM_BROADCAST;
+    packet->want_ack = false;
+    packet->decoded.want_response = false;
+    packet->priority = message ? meshtastic_MeshPacket_Priority_DEFAULT : meshtastic_MeshPacket_Priority_BACKGROUND;
+    packet->decoded.payload.size = length;
+    std::memcpy(packet->decoded.payload.bytes, text, length);
+    return service->sendToMesh(packet, RX_SRC_LOCAL, true) == 0;
+}
+
+void LegionControlModule::reply(uint8_t channel, const char *text)
+{
+    char output[legion::CONTROL_TEXT_MAX + 1];
+    const int length = std::snprintf(output, sizeof(output), "!%08lx: %s", (unsigned long)nodeDB->getNodeNum(), text);
+    if (length > 0 && static_cast<size_t>(length) < sizeof(output))
+        sendText(channel, output);
+}
+
+void LegionControlModule::report(const Pending &command, uint32_t now, bool zeroHop)
+{
+    auto &snapshot = zeroHop ? zeroHopReport : ignoreReport;
+    const uint16_t page = command.request.page;
+    const bool live = snapshot.valid && Throttle::isWithinTimespanMs(snapshot.createdAt, legion::CONTROL_SNAPSHOT_MS) &&
+                      sameChannel(snapshot.control, command.control) && (!zeroHop || snapshot.generation == radioGeneration);
+    if (live && snapshot.from != command.from) {
+        reply(command.control.index, "Report busy; another requester has an active snapshot");
+        return;
+    }
+    if (!live) {
+        snapshot.valid = false;
+        if (page != 1) {
+            reply(command.control.index, "Snapshot expired or changed; request page 1");
+            return;
+        }
+        snapshot.directory.clear(zeroHop, ++nextReport);
+        for (size_t i = 0; i < nodeDB->getNumMeshNodes(); ++i) {
+            const auto node = nodeDB->getMeshNodeByIndex(i);
+            if (!legion::validPeer(node->num) || node->num == nodeDB->getNodeNum())
+                continue;
+            if (zeroHop) {
+                bool witnessed;
+                {
+                    concurrency::LockGuard guard(&stateLock);
+                    witnessed = directLinks.qualifies(node->num, radioGeneration);
+                }
+                if (!witnessed || !node->has_hops_away || node->hops_away != 0 || !nodeInfoLiteHasSnr(node) ||
+                    nodeInfoLiteViaMqtt(node) || !nodeInfoLiteHeardOnSlot(node, nodeDB->committedLoraSlot()) ||
+                    !std::isfinite(node->snr) || node->snr < -128 || node->snr > 127)
+                    continue;
+                snapshot.directory.add(node->num, node->short_name, node->snr);
+            } else if (nodeInfoLiteIsIgnored(node))
+                snapshot.directory.add(node->num, node->short_name);
+        }
+        if (!zeroHop) {
+            for (size_t i = 0; i < config.lora.ignore_incoming_count && i < 3; ++i) {
+                const auto id = config.lora.ignore_incoming[i];
+                if (!legion::validPeer(id) || id == nodeDB->getNodeNum())
+                    continue;
+                const auto node = nodeDB->getMeshNode(id);
+                snapshot.directory.add(id, node ? node->short_name : nullptr);
+            }
+        } else {
+            concurrency::LockGuard guard(&stateLock);
+            if (directLinks.overflowed())
+                snapshot.directory.markIncomplete();
+        }
+        snapshot.directory.finish();
+        snapshot.control = command.control;
+        snapshot.from = command.from;
+        snapshot.createdAt = now;
+        snapshot.generation = radioGeneration;
+        snapshot.valid = true;
+    }
+    char output[legion::CONTROL_TEXT_MAX + 1];
+    if (snapshot.directory.format(output, sizeof(output), nodeDB->getNodeNum(), page))
+        sendText(command.control.index, output);
+    else
+        reply(command.control.index, "Invalid page; request page 1");
+}
+
+void LegionControlModule::execute(const Pending &command, uint32_t now)
+{
+    const auto &request = command.request;
+    const auto channel = command.control.index;
+    if (!request.valid) {
+        const char *usage = "Usage: /msg !nodeid <channel> <message>; text <=199 UTF-8 bytes, channel <=11 bytes";
+        switch (request.command) {
+        case legion::ControlCommand::Reboot:
+            usage = "Usage: /reboot !nodeid";
+            break;
+        case legion::ControlCommand::ZeroHop:
+            usage = "Usage: /zerohop !nodeid [positive page]";
+            break;
+        case legion::ControlCommand::Ignore:
+            usage = "Usage: /ignore !peerid";
+            break;
+        case legion::ControlCommand::Unignore:
+            usage = "Usage: /unignore !peerid";
+            break;
+        case legion::ControlCommand::IgnoreList:
+            usage = "Usage: /ignorelist [positive page]";
+            break;
+        default:
+            break;
+        }
+        reply(channel, usage);
+        return;
+    }
+    if (request.command == legion::ControlCommand::ZeroHop || request.command == legion::ControlCommand::IgnoreList) {
+        report(command, now, request.command == legion::ControlCommand::ZeroHop);
+        return;
+    }
+    if (legionRecoveryIsBlocked() || xModem.isBusy() || !legionBatterySafeForFlash()
+#if !MESHTASTIC_EXCLUDE_ADMIN
+        || (adminModule && adminModule->isEditingSettings())
+#endif
+    ) {
+        reply(channel, "Busy or power reserve low; retry later");
+        return;
+    }
+    if (request.command == legion::ControlCommand::Reboot) {
+        const uint32_t deadline = command.acceptedAt + 20000;
+        if (!rebootAtMsec || static_cast<int32_t>(deadline - rebootAtMsec) < 0) {
+            rebootAtMsec = deadline ? deadline : 1;
+            reply(channel, "Reboot scheduled in 20s");
+        } else
+            reply(channel, "Reboot already scheduled");
+    } else if (request.command == legion::ControlCommand::Message) {
+        if (command.destinationMatches != 1) {
+            reply(channel, command.destinationMatches ? "Ambiguous channel name" : "Channel not found or disabled");
+            return;
+        }
+        Channel current;
+        if (findDestination(request.channel, current) != 1 || !sameChannel(current, command.destination)) {
+            reply(channel, "Destination channel changed; request cancelled");
+            return;
+        }
+        if (sendText(current.index, request.text, true)) {
+            char status[80];
+            std::snprintf(status, sizeof(status), "Message queued to %s", current.name);
+            reply(channel, status);
+        } else
+            reply(channel, "Message queue rejected; no delivery confirmation");
+    } else {
+        const bool ignored = request.command == legion::ControlCommand::Ignore;
+        const auto result = nodeDB->legionSetIgnored(request.node, ignored);
+        const char *status;
+        switch (result) {
+        case LegionIgnoreResult::Saved:
+            status = ignored ? "Ignored" : "Unignored";
+            break;
+        case LegionIgnoreResult::Unchanged:
+            status = ignored ? "Already ignored" : "Not ignored";
+            break;
+        case LegionIgnoreResult::Pending:
+            status = ignored ? "Ignored in RAM; persistence pending for" : "Unignored in RAM; persistence pending for";
+            break;
+        case LegionIgnoreResult::Capacity:
+            status = "Protected-node capacity reached; cannot ignore";
+            break;
+        case LegionIgnoreResult::Invalid:
+            status = "Invalid, reserved or self Node ID";
+            break;
+        default:
+            status = "Storage or power unavailable; no change to";
+            break;
+        }
+        char text[128];
+        std::snprintf(text, sizeof(text), "%s !%08lx", status, (unsigned long)request.node);
+        reply(channel, text);
+        ignoreReport.valid = false;
+    }
+}
+
+int32_t LegionControlModule::runOnce()
+{
+    const uint32_t now = Time::getMillis();
+    Pending command;
+    bool executeCommand = false;
+    {
+        concurrency::LockGuard guard(&stateLock);
+        if (requests.ready(now)) {
+            command = pending;
+            pending = {};
+            requests.finish(now);
+            executeCommand = true;
+        }
+    }
+    Channel control;
+    if (executeCommand && findControlChannel(control) && sameChannel(control, command.control) && legionPowerTxReady())
+        execute(command, now);
+    return 1000;
+}
+#endif
diff --git a/src/modules/LegionControlModule.h b/src/modules/LegionControlModule.h
new file mode 100644
index 0000000..90bdba4
--- /dev/null
+++ b/src/modules/LegionControlModule.h
@@ -0,0 +1,62 @@
+#pragma once
+
+#include "configuration.h"
+
+#if RAK3401_LEGION_CONTROL
+#if !RAK3401_LEGION_TELEMETRY || !RAK3401_LEGION_RECOVERY
+#error "Legion control requires private telemetry and recovery"
+#endif
+#include "LegionControlPolicy.h"
+#include "SinglePortModule.h"
+#include "concurrency/Lock.h"
+#include "concurrency/OSThread.h"
+
+class LegionControlModule : public SinglePortModule, private concurrency::OSThread
+{
+  public:
+    LegionControlModule();
+    void observeLink(const meshtastic_MeshPacket &packet, int8_t hopsAway);
+
+  protected:
+    ProcessMessage handleReceived(const meshtastic_MeshPacket &packet) override;
+    int32_t runOnce() override;
+
+  private:
+    struct Channel {
+        uint8_t index = 0, keySize = 0, role = 0;
+        uint8_t key[32]{};
+        char name[12]{};
+        bool aead = false, publicKey = false;
+    };
+    struct Pending {
+        legion::ControlRequest request;
+        Channel control, destination;
+        uint32_t from = 0, acceptedAt = 0;
+        uint8_t destinationMatches = 0;
+    };
+    struct Report {
+        legion::ControlDirectory directory;
+        Channel control;
+        uint32_t from = 0, createdAt = 0, generation = 0;
+        bool valid = false;
+    };
+    bool readChannel(uint8_t index, Channel &result) const;
+    bool findControlChannel(Channel &result) const;
+    uint8_t findDestination(const char *name, Channel &result) const;
+    static bool sameChannel(const Channel &a, const Channel &b);
+    bool sendText(uint8_t channel, const char *text, bool message = false);
+    void reply(uint8_t channel, const char *text);
+    void execute(const Pending &command, uint32_t now);
+    void report(const Pending &command, uint32_t now, bool zeroHop);
+
+    concurrency::Lock stateLock;
+    legion::ControlGate requests;
+    legion::DirectLinkWitness directLinks;
