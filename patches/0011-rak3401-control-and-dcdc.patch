+#include "LegionDcdc.h"
+
+#if RAK3401_LEGION_DCDC
+#if !defined(ARCH_NRF52) || !defined(RAK3401) || !defined(RAK13302)
+#error "Legion REG1 DC/DC requires the validated RAK3401 + RAK13302 profile"
+#endif
+#include <nrf_sdm.h>
+#include <nrf_soc.h>
+
+extern "C" __attribute__((noinline)) void legionEnableDcdcReg1()
+{
+    static bool attempted = false;
+    if (attempted)
+        return;
+    attempted = true;
+    uint8_t enabled = 0;
+    const uint32_t query = sd_softdevice_is_enabled(&enabled);
+    if (query != NRF_SUCCESS || enabled != 1) {
+        LOG_WARN("Legion REG1 DC/DC: SoftDevice unavailable (%lu)", (unsigned long)query);
+        return;
+    }
+    const uint32_t result = sd_power_dcdc_mode_set(NRF_POWER_DCDC_ENABLE);
+    if (result == NRF_SUCCESS && NRF_POWER->DCDCEN == 1)
+        LOG_INFO("Legion REG1 DC/DC enabled");
+    else
+        LOG_WARN("Legion REG1 DC/DC activation failed (%lu), readback=%lu", (unsigned long)result,
+                 (unsigned long)NRF_POWER->DCDCEN);
+}
+#endif
