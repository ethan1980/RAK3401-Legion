+void LegionControlModule::startTrace(const Pending &command, uint32_t now)
+{
+    bool active;
+    {
+        concurrency::LockGuard guard(&stateLock);
+        active = trace.id != 0;
+    }
+    if (active || (traceCooling && !Throttle::deadlinePassedAt(now, nextTraceAt))) {
+        reply(command.control.index, active ? "Trace busy; wait for the current result" : "Trace cooldown; retry in up to 60s");
+        return;
+    }
+    if (legionRecoveryIsBlocked() || xModem.isBusy()
+#if !MESHTASTIC_EXCLUDE_ADMIN
+        || (adminModule && adminModule->isEditingSettings())
+#endif
+    ) {
+        reply(command.control.index, "Busy; retry trace later");
+        return;
+    }
+    Channel destination, primary;
+    if (!command.destinationMatches || command.generation != radioGeneration ||
+        !findTraceDestination(command.request.target, destination) || !sameChannel(destination, command.destination) ||
+        !readChannel(channels.getPrimaryIndex(), primary) || !sameChannel(primary, command.primary)) {
+        reply(command.control.index, "Trace channel unavailable or changed; request cancelled");
+        return;
+    }
+    auto packet = router->allocForSending();
+    if (!packet) {
+        reply(command.control.index, "Trace allocation failed; request not queued");
+        return;
+    }
+    packet->to = command.request.target;
+    packet->channel = destination.index;
+    packet->decoded.portnum = meshtastic_PortNum_TRACEROUTE_APP;
+    packet->decoded.want_response = true;
+    packet->want_ack = true;
+    // An empty standard RouteDiscovery encodes to zero bytes.
+    packet->decoded.payload.size = 0;
+    const auto id = packet->id;
+    {
+        concurrency::LockGuard guard(&stateLock);
+        trace = {};
+        trace.id = id;
+        trace.target = command.request.target;
+        trace.control = command.control;
+        trace.destination = destination;
+        trace.primary = primary;
+        trace.startedAt = trace.lastReplyAt = now;
+        trace.generation = radioGeneration;
+    }
+    // Arm before dispatch: a local routing error can arrive synchronously.
+    if (service->sendToMesh(packet, RX_SRC_USER, true) != 0) {
+        {
+            concurrency::LockGuard guard(&stateLock);
+            trace = {};
+        }
+        reply(command.control.index, "Trace queue rejected; no reachability result");
+        return;
+    }
+    traceCooling = true;
+    nextTraceAt = now + legion::TRACE_COOLDOWN_MS;
+    char status[100];
+    std::snprintf(status, sizeof(status), "Trace !%08lx queued; waiting up to 90s", (unsigned long)command.request.target);
+    reply(command.control.index, status);
+}
+
+bool LegionControlModule::matchesTrace(const meshtastic_MeshPacket &packet) const
+{
+    return trace.id && packet.which_payload_variant == meshtastic_MeshPacket_decoded_tag &&
+           packet.decoded.request_id == trace.id && packet.to == nodeDB->getNodeNum() &&
+           packet.channel == trace.destination.index && trace.phase == TracePhase::Waiting &&
+           !Throttle::deadlinePassedAt(Time::getMillis(), trace.startedAt + legion::TRACE_WAIT_MS);
+}
+
+void LegionControlModule::observeTraceRoute(const meshtastic_MeshPacket &packet, const meshtastic_RouteDiscovery &route)
+{
+    if (route.route_count > sizeof(route.route) / sizeof(route.route[0]) ||
+        route.route_back_count > sizeof(route.route_back) / sizeof(route.route_back[0]) ||
+        route.snr_towards_count > sizeof(route.snr_towards) / sizeof(route.snr_towards[0]) ||
+        route.snr_back_count > sizeof(route.snr_back) / sizeof(route.snr_back[0]))
+        return;
+    concurrency::LockGuard guard(&stateLock);
+    if (matchesTrace(packet) && packet.decoded.portnum == meshtastic_PortNum_TRACEROUTE_APP && packet.from == trace.target) {
+        trace.route = route;
+        trace.phase = TracePhase::Routes;
+    }
+}
+
+void LegionControlModule::observeTraceError(const meshtastic_MeshPacket &packet, meshtastic_Routing_Error error)
+{
+    concurrency::LockGuard guard(&stateLock);
+    if (matchesTrace(packet) && packet.decoded.portnum == meshtastic_PortNum_ROUTING_APP &&
+        error != meshtastic_Routing_Error_NONE) {
+        trace.error = error;
+        trace.phase = TracePhase::Error;
+    }
+}
+
+void legionControlObserveTraceRoute(const meshtastic_MeshPacket &packet, const meshtastic_RouteDiscovery &route)
+{
+    if (legionControlModule)
+        legionControlModule->observeTraceRoute(packet, route);
+}
+
+void legionControlObserveTraceError(const meshtastic_MeshPacket &packet, meshtastic_Routing_Error error)
+{
+    if (legionControlModule)
+        legionControlModule->observeTraceError(packet, error);
+}
+
+void LegionControlModule::formatTrace(const Trace &result, bool back, char *output, size_t size) const
+{
+    const auto &route = result.route;
+    static_assert(sizeof(route.route) / sizeof(route.route[0]) <= 8 &&
+                      sizeof(route.route_back) / sizeof(route.route_back[0]) <= 8,
+                  "Revisit the 199-byte trace report limit if route capacity grows");
+    const auto count = back ? route.route_back_count : route.route_count;
+    const auto nodes = back ? route.route_back : route.route;
+    const auto snrs = back ? route.snr_back_count : route.snr_towards_count;
+    size_t used = std::snprintf(output, size, "!%08lx TR#%08lx %s: ", (unsigned long)nodeDB->getNodeNum(),
+                                (unsigned long)result.id, back ? "2/2 back" : "1/2 out");
+    if (!count && !snrs) {
+        std::snprintf(output + used, size - used, "!%08lx route not reported; reply received", (unsigned long)result.target);
+        return;
+    }
+    used += std::snprintf(output + used, size - used, "!%08lx", (unsigned long)(back ? result.target : nodeDB->getNodeNum()));
+    for (size_t i = 0; i < count; ++i) {
+        if (legion::validPeer(nodes[i]))
+            used += std::snprintf(output + used, size - used, " > !%08lx", (unsigned long)nodes[i]);
+        else
+            used += std::snprintf(output + used, size - used, " > ?");
+    }
+    std::snprintf(output + used, size - used, " > !%08lx%s", (unsigned long)(back ? nodeDB->getNodeNum() : result.target),
+                  count ? "" : " (0 reported relays)");
+}
+
+void LegionControlModule::pollTrace(uint32_t now)
+{
+    Trace result;
+    {
+        concurrency::LockGuard guard(&stateLock);
+        result = trace;
+    }
+    if (!result.id)
+        return;
+    Channel control, destination, primary;
+    const bool canReply = findControlChannel(control) && sameChannel(control, result.control) && legionPowerTxReady();
+    const bool valid = canReply && readChannel(result.destination.index, destination) &&
+                       sameChannel(destination, result.destination) && readChannel(channels.getPrimaryIndex(), primary) &&
+                       sameChannel(primary, result.primary) && result.generation == radioGeneration;
+    if (!valid) {
+        {
+            concurrency::LockGuard guard(&stateLock);
+            trace = {};
+        }
+        router->cancelSending(nodeDB->getNodeNum(), result.id);
+        if (canReply)
+            reply(control.index, "Trace cancelled; radio or channel settings changed");
+        return;
+    }
+    bool timedOut;
+    {
+        concurrency::LockGuard guard(&stateLock);
+        // Re-read after validation so a response racing the timeout wins.
+        result = trace;
+        timedOut =
+            result.phase == TracePhase::Waiting && Throttle::deadlinePassedAt(now, result.startedAt + legion::TRACE_WAIT_MS);
+        if ((!timedOut && result.phase == TracePhase::Waiting) ||
+            !Throttle::deadlinePassedAt(now, result.lastReplyAt + legion::TRACE_REPLY_GAP_MS))
+            return;
+        if (!timedOut && result.phase == TracePhase::Routes && !result.part) {
+            trace.part = 1;
+            trace.lastReplyAt = now;
+        } else
+            trace = {};
+    }
+    char output[legion::CONTROL_TEXT_MAX + 1];
+    if (!timedOut && result.phase == TracePhase::Routes) {
+        formatTrace(result, result.part != 0, output, sizeof(output));
+    } else {
+        const char *status = "No traceroute response within 90s; reachability unknown";
+        if (!timedOut) {
+            switch (result.error) {
+            case meshtastic_Routing_Error_NO_ROUTE:
+                status = "Unreachable: routing reported NO_ROUTE";
+                break;
+            case meshtastic_Routing_Error_MAX_RETRANSMIT:
+                status = "No acknowledgement: MAX_RETRANSMIT; reachability unknown";
+                break;
+            case meshtastic_Routing_Error_TIMEOUT:
+            case meshtastic_Routing_Error_NO_RESPONSE:
+                status = "No response: routing timeout; reachability unknown";
+                break;
+            default:
+                status = "Routing failed; no reachability result";
+                break;
+            }
+        }
+        const auto length =
+            std::snprintf(output, sizeof(output), "!%08lx TR#%08lx !%08lx: %s", (unsigned long)nodeDB->getNodeNum(),
+                          (unsigned long)result.id, (unsigned long)result.target, status);
+        if (!timedOut && length > 0 && static_cast<size_t>(length) < sizeof(output))
+            std::snprintf(output + length, sizeof(output) - length, " (error:%u)", (unsigned)result.error);
+    }
+    const bool queued = sendText(control.index, output);
+    if (!queued && result.phase == TracePhase::Routes && !result.part) {
+        concurrency::LockGuard guard(&stateLock);
+        trace = {};
+    }
+    if (timedOut)
+        router->cancelSending(nodeDB->getNodeNum(), result.id);
+}
