+#pragma once
+
+#include "configuration.h"
+
+#if RAK3401_LEGION_CC310
+#if !defined(ARCH_NRF52) || !defined(RAK3401) || !defined(RAK13302)
+#error "Legion CC310 requires the RAK3401 + RAK13302 nRF52 profile"
+#endif
+#include <cstddef>
+#include <cstdint>
+
+struct LegionCryptoStats {
+    uint32_t sha = 0, hmac = 0, fallback = 0;
+};
+
+// Every begin, including a failed one, must be paired with end. Sessions nest on
+// one task and serialize all CC310 users without nesting the caller's cryptLock.
+bool legionCc310Begin();
+void legionCc310End();
+LegionCryptoStats legionCryptoStats();
+
+// Output is committed only after all SDK calls succeed. Inputs may alias output,
+// reside in flash or be unaligned; the SDK receives aligned RAM blocks only.
+bool legionCc310Sha256(const uint8_t *data, size_t size, uint8_t *output);
+bool legionCc310Hmac(const uint8_t *key, const uint8_t *header, size_t headerSize, const uint8_t *data, size_t size,
+                     uint8_t *output);
+#endif
