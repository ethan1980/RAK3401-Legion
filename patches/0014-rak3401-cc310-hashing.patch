diff --git a/src/platform/nrf52/LegionCrypto.cpp b/src/platform/nrf52/LegionCrypto.cpp
new file mode 100644
index 0000000..90e88ec
--- /dev/null
+++ b/src/platform/nrf52/LegionCrypto.cpp
@@ -0,0 +1,152 @@
+#include "LegionCrypto.h"
+
+#if RAK3401_LEGION_CC310
+#include "concurrency/Lock.h"
+#include <Adafruit_nRFCrypto.h>
+#include <atomic>
+#include <cstring>
+#include <nrf_cc310/include/crys_hash.h>
+#include <nrf_cc310/include/crys_hmac.h>
+#include <task.h>
+
+namespace
+{
+concurrency::Lock acceleratorLock;
+std::atomic<TaskHandle_t> owner{nullptr};
+unsigned depth = 0;
+bool ready = false;
+uint8_t earlyOwner;
+std::atomic<uint32_t> shaCount{0}, hmacCount{0}, fallbackCount{0};
+
+TaskHandle_t currentOwner()
+{
+    const auto task = xTaskGetCurrentTaskHandle();
+    return task ? task : reinterpret_cast<TaskHandle_t>(&earlyOwner);
+}
+
+void wipe(void *data, size_t size)
+{
+    auto bytes = static_cast<volatile uint8_t *>(data);
+    while (size--)
+        *bytes++ = 0;
+}
+
+struct Session {
+    bool available = legionCc310Begin();
+    ~Session() { legionCc310End(); }
+};
+
+// A partial final block must be the LAST SDK update, including when the two
+// fragments meet in the middle of a block (ACK headers are only 15 bytes).
+template <typename Update>
+bool feed(const uint8_t *first, size_t firstSize, const uint8_t *second, size_t secondSize, Update update)
+{
+    alignas(4) uint8_t block[64]{};
+    size_t used = 0;
+    bool ok = true;
+    for (unsigned part = 0; part < 2 && ok; ++part) {
+        auto input = part ? second : first;
+        auto remaining = part ? secondSize : firstSize;
+        while (remaining && ok) {
+            const size_t amount = remaining < sizeof(block) - used ? remaining : sizeof(block) - used;
+            std::memcpy(block + used, input, amount);
+            input += amount;
+            remaining -= amount;
+            used += amount;
+            if (used == sizeof(block)) {
+                ok = update(block, used) == 0;
+                used = 0;
+            }
+        }
+    }
+    if (ok && used)
+        ok = update(block, used) == 0;
+    wipe(block, sizeof(block));
+    return ok;
+}
+} // namespace
+
+bool legionCc310Begin()
+{
+    const auto self = currentOwner();
+    if (owner.load() != self) {
+        acceleratorLock.lock();
+        owner.store(self);
+    }
+    if (depth++ == 0)
+        ready = nRFCrypto.begin();
+    return ready;
+}
+
+void legionCc310End()
+{
+    if (owner.load() != currentOwner() || !depth)
+        return;
+    if (--depth == 0) {
+        // Also resets the library's begun flag after a failed initialization.
+        nRFCrypto.end();
+        ready = false;
+        owner.store(nullptr);
+        acceleratorLock.unlock();
+    }
+}
+
+LegionCryptoStats legionCryptoStats()
+{
+    return {shaCount.load(), hmacCount.load(), fallbackCount.load()};
+}
+
+bool legionCc310Sha256(const uint8_t *data, size_t size, uint8_t *output)
+{
+    bool ok = false;
+    if (output && (data || !size)) {
+        Session session;
+        if (session.available) {
+            CRYS_HASHUserContext_t context{};
+            CRYS_HASH_Result_t result{};
+            ok = CRYS_HASH_Init(&context, CRYS_HASH_SHA256_mode) == 0;
+            if (ok)
+                ok = feed(data, size, nullptr, 0,
+                          [&](uint8_t *block, size_t count) { return CRYS_HASH_Update(&context, block, count); });
+            if (ok)
+                ok = CRYS_HASH_Finish(&context, result) == 0;
+            if (ok)
+                std::memcpy(output, result, 32);
+            CRYS_HASH_Free(&context);
+            wipe(result, sizeof(result));
+            wipe(&context, sizeof(context));
+        }
+    }
+    (ok ? shaCount : fallbackCount).fetch_add(1);
+    return ok;
+}
+
+bool legionCc310Hmac(const uint8_t *key, const uint8_t *header, size_t headerSize, const uint8_t *data, size_t size,
+                     uint8_t *output)
+{
+    bool ok = false;
+    if (key && output && (header || !headerSize) && (data || !size)) {
+        Session session;
+        if (session.available) {
+            alignas(4) uint8_t keyCopy[32];
+            std::memcpy(keyCopy, key, sizeof(keyCopy));
+            CRYS_HMACUserContext_t context{};
+            CRYS_HASH_Result_t result{};
+            ok = CRYS_HMAC_Init(&context, CRYS_HASH_SHA256_mode, keyCopy, sizeof(keyCopy)) == 0;
+            if (ok)
+                ok = feed(header, headerSize, data, size,
+                          [&](uint8_t *block, size_t count) { return CRYS_HMAC_Update(&context, block, count); });
+            if (ok)
+                ok = CRYS_HMAC_Finish(&context, result) == 0;
+            if (ok)
+                std::memcpy(output, result, 32);
+            CRYS_HMAC_Free(&context);
+            wipe(keyCopy, sizeof(keyCopy));
+            wipe(result, sizeof(result));
+            wipe(&context, sizeof(context));
+        }
+    }
+    (ok ? hmacCount : fallbackCount).fetch_add(1);
+    return ok;
+}
+#endif
