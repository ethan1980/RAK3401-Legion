diff --git a/src/platform/nrf52/LegionBoot.cpp b/src/platform/nrf52/LegionBoot.cpp
new file mode 100644
index 0000000..0550e7b
--- /dev/null
+++ b/src/platform/nrf52/LegionBoot.cpp
@@ -0,0 +1,143 @@
+#include "LegionBoot.h"
+
+#if RAK3401_LEGION_BOOT
+#if !defined(ARCH_NRF52) || !defined(RAK3401) || !defined(RAK13302)
+#error "Legion boot diagnostics require the RAK3401 + RAK13302 nRF52 profile"
+#endif
+#include <Arduino.h>
+#include <cstdio>
+#include <nrf_sdm.h>
+#include <nrf_soc.h>
+#if RAK3401_LEGION_CC310
+#include "LegionCrypto.h"
+#endif
+
+namespace
+{
+// Leave the low nibble (including Nordic's optional CRC-skip bit) alone. The
+// Adafruit UF2 bootloader uses GPREGRET, which this module never touches.
+constexpr uint8_t REASON_MASK = 0xf0;
+LegionBootSnapshot snapshot;
+bool captured = false;
+
+LegionShutdown decode(uint8_t value)
+{
+    switch (static_cast<LegionShutdown>(value & REASON_MASK)) {
+    case LegionShutdown::BootProtect:
+    case LegionShutdown::LowBattery:
+    case LegionShutdown::LowVdd:
+    case LegionShutdown::SystemOff:
+        return static_cast<LegionShutdown>(value & REASON_MASK);
+    default:
+        return LegionShutdown::Unknown;
+    }
+}
+
+bool replaceReason(uint8_t value)
+{
+    uint8_t enabled = 0;
+    if (sd_softdevice_is_enabled(&enabled) != NRF_SUCCESS)
+        return false;
+    if (enabled)
+        return sd_power_gpregret_clr(1, REASON_MASK) == NRF_SUCCESS && sd_power_gpregret_set(1, value) == NRF_SUCCESS;
+    NRF_POWER->GPREGRET2 = (NRF_POWER->GPREGRET2 & ~REASON_MASK) | value;
+    return true;
+}
+
+const char *resetName(uint32_t value)
+{
+    if (value & POWER_RESETREAS_DOG_Msk)
+        return "watchdog";
+    if (value & POWER_RESETREAS_LOCKUP_Msk)
+        return "lockup";
+    if (value & (POWER_RESETREAS_OFF_Msk | POWER_RESETREAS_LPCOMP_Msk))
+        return "system-off-wake";
+    if (value & POWER_RESETREAS_RESETPIN_Msk)
+        return "reset-pin";
+    if (value & POWER_RESETREAS_SREQ_Msk)
+        return "software";
+    return value ? "other" : "power-on/unknown";
+}
+
+const char *shutdownName(LegionShutdown reason)
+{
+    switch (reason) {
+    case LegionShutdown::BootProtect:
+        return "boot-protect";
+    case LegionShutdown::LowBattery:
+        return "low-battery";
+    case LegionShutdown::LowVdd:
+        return "low-vdd";
+    case LegionShutdown::SystemOff:
+        return "system-off";
+    default:
+        return "unknown";
+    }
+}
+} // namespace
+
+void legionBootCapture()
+{
+    if (captured)
+        return;
+    captured = true;
+    snapshot.reset = readResetReason(); // The Arduino core already cleared hardware RESETREAS.
+    const auto previous = decode(NRF_POWER->GPREGRET2);
+    // A marker records an intentional energy stop, not the cause of a later
+    // unrelated watchdog/pin reset. A recovery wait can end in a software reset.
+    constexpr uint32_t expected = POWER_RESETREAS_OFF_Msk | POWER_RESETREAS_LPCOMP_Msk | POWER_RESETREAS_SREQ_Msk;
+    if ((snapshot.reset & expected) &&
+        !(snapshot.reset & (POWER_RESETREAS_DOG_Msk | POWER_RESETREAS_LOCKUP_Msk | POWER_RESETREAS_RESETPIN_Msk)))
+        snapshot.previous = previous;
+    if (previous != LegionShutdown::Unknown)
+        replaceReason(0); // Consume only our markers; preserve foreign values and low-nibble flags.
+}
+
+void legionBootObserveVoltage(uint16_t batteryMv, uint16_t vddMv, bool usb)
+{
+    if (!snapshot.sampled) {
+        snapshot.batteryMv = batteryMv;
+        snapshot.vddMv = vddMv;
+        snapshot.usb = usb;
+        snapshot.sampled = true;
+    }
+}
+
+bool legionBootRecordShutdown(LegionShutdown reason)
+{
+    const auto bits = static_cast<uint8_t>(reason);
+    const auto existing = NRF_POWER->GPREGRET2 & REASON_MASK;
+    if (decode(bits) == LegionShutdown::Unknown || (existing && decode(existing) == LegionShutdown::Unknown))
+        return false;
+    return replaceReason(bits);
+}
+
+LegionBootSnapshot legionBootSnapshot()
+{
+    return snapshot; // Written only by the boot gate, before the radio/command threads start.
+}
+
+bool legionBootFormat(char *output, size_t size, uint32_t node)
+{
+    if (!output || !size)
+        return false;
+    char battery[12] = "NA", vdd[12] = "NA";
+    if (snapshot.sampled && snapshot.batteryMv)
+        std::snprintf(battery, sizeof(battery), "%u", (unsigned)snapshot.batteryMv);
+    if (snapshot.sampled && snapshot.vddMv)
+        std::snprintf(vdd, sizeof(vdd), "%u", (unsigned)snapshot.vddMv);
+    int used = std::snprintf(output, size, "!%08lx BOOT reset:%s(%08lx) prev:%s\nVBAT:%s VDD:%smV USB:%s", (unsigned long)node,
+                             resetName(snapshot.reset), (unsigned long)snapshot.reset, shutdownName(snapshot.previous), battery,
+                             vdd, snapshot.sampled ? (snapshot.usb ? "1" : "0") : "NA");
+    if (used < 0 || static_cast<size_t>(used) >= size)
+        return false;
+#if RAK3401_LEGION_CC310
+    const auto stats = legionCryptoStats();
+    const int added = std::snprintf(output + used, size - used, "\nCC310 SHA:%lu MAC:%lu SW:%lu", (unsigned long)stats.sha,
+                                    (unsigned long)stats.hmac, (unsigned long)stats.fallback);
+    if (added < 0 || static_cast<size_t>(added) >= size - used)
+        return false;
+#endif
+    return true;
+}
+#endif
