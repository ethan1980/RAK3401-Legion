@@ -0,0 +1,23 @@
+#pragma once
+
+#include "configuration.h"
+
+#if RAK3401_LEGION_BOOT
+#include <cstddef>
+#include <cstdint>
+
+enum class LegionShutdown : uint8_t { Unknown = 0, BootProtect = 0xa0, LowBattery = 0xb0, LowVdd = 0xc0, SystemOff = 0xd0 };
+
+struct LegionBootSnapshot {
+    uint32_t reset = 0;
+    uint16_t batteryMv = 0, vddMv = 0;
+    LegionShutdown previous = LegionShutdown::Unknown;
+    bool sampled = false, usb = false;
+};
+
+void legionBootCapture();
+void legionBootObserveVoltage(uint16_t batteryMv, uint16_t vddMv, bool usb);
+bool legionBootRecordShutdown(LegionShutdown reason);
+LegionBootSnapshot legionBootSnapshot();
+bool legionBootFormat(char *output, size_t size, uint32_t node);
+#endif
