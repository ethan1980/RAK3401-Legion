+void LegionControlModule::apc(const Pending &command, uint32_t now)
+{
+    const auto &request = command.request;
+    if (request.apcAction != 1) {
+        const auto mode = request.apcAction == 2   ? legion::ApcMode::Observe
+                          : request.apcAction == 4 ? legion::ApcMode::Shadow
+                          : request.apcAction == 5 ? legion::ApcMode::On
+                                                   : legion::ApcMode::Off;
+        Channel primary;
+        if (mode != legion::ApcMode::Off && (!readChannel(channels.getPrimaryIndex(), primary) ||
+                                             config.device.role != meshtastic_Config_DeviceConfig_Role_CLIENT || rebootAtMsec ||
+                                             shutdownAtMsec || legionRecoveryIsBlocked() || xModem.isBusy()
+#if !MESHTASTIC_EXCLUDE_ADMIN
+                                             || (adminModule && adminModule->isEditingSettings())
+#endif
+                                                 )) {
+            reply(command.control.index, "APC requires CLIENT, stable configuration and no pending restart/transfer");
+            return;
+        }
+        const bool changed = legionApcSetMode(mode, static_cast<uint32_t>(random(1, 0x7fffffff)), radioGeneration);
+        apcBound = mode != legion::ApcMode::Off;
+        apcControl = command.control;
+        apcPrimary = primary;
+        apcLora = config.lora;
+        apcGeneration = radioGeneration;
+        char output[150];
+        std::snprintf(output, sizeof(output), "APC %s%s; %s; RAM only, boot OFF", legion::apcModeName(mode),
+                      changed ? " selected" : " unchanged",
+                      mode == legion::ApcMode::On ? "optional relay budget armed after warmup, TX nominal" : "normal TX/relays");
+        reply(command.control.index, output);
+        apcReport.valid = false;
+        return;
+    }
+    const auto page = request.page;
+    if (page < 1 || page > 6) {
+        reply(command.control.index, "APC pages: 1-6; request page 1 first");
+        return;
+    }
+    if (page == 1) {
+        apcReport.stats = legionApcSnapshot();
+        apcReport.controlStats = legionApcControlSnapshot();
+        apcReport.control = command.control;
+        apcReport.from = command.from;
+        apcReport.createdAt = now;
+        apcReport.uptime = Time::getUptimeSecs();
+        apcReport.generation = radioGeneration;
+        if (!++apcReport.capture)
+            ++apcReport.capture;
+        std::strcpy(apcReport.radio, "Radio unavailable");
+        if (RadioLibInterface::instance)
+            RadioLibInterface::instance->legionApcDescribe(apcReport.radio, sizeof(apcReport.radio));
+        apcReport.valid = true;
+    } else if (!apcReport.valid || apcReport.from != command.from || !sameChannel(apcReport.control, command.control) ||
+               apcReport.generation != radioGeneration || Throttle::hasElapsed(apcReport.createdAt, 15 * 60000)) {
+        reply(command.control.index, "APC capture missing/expired; request page 1");
+        return;
+    }
+    const auto &s = apcReport.stats;
+    char body[160];
+    int n = 0;
+    if (page == 1) {
+        const auto &c = apcReport.controlStats;
+        char filtered[8] = "?";
+        if (c.filtered)
+            std::snprintf(filtered, sizeof(filtered), "%u", c.filtered);
+        n = std::snprintf(body, sizeof(body),
+                          "%s %s %s\nVBAT:%u/%smV\nnext:%s %lu/%lus\neligible:%lu would:%lu skip:%lu\nTX:nominal",
+                          legion::apcModeName(c.mode), legion::apcStateName(c.state), legion::apcHoldName(c.hold), s.battery,
+                          filtered, legion::apcStateName(c.pending), (unsigned long)c.dwellSec, (unsigned long)c.requiredSec,
+                          (unsigned long)c.eligible, (unsigned long)c.wouldSkip, (unsigned long)c.skipped);
+    } else if (page == 2) {
+        const uint32_t elapsed = s.session ? (s.enabled ? apcReport.uptime : s.stopSec) - s.startSec : 0;
+        char batterySum[21];
+        formatUint64(s.batterySum, batterySum);
+        n = std::snprintf(body, sizeof(body),
+                          "%s up:%lus dt:%lus n:%lu usb:%lu\nVBAT "
+                          "mV:%u/%u/%u/%u/%u\nsum:%s VDD:%u/%u",
+                          s.enabled ? "OBS" : "OFF", (unsigned long)apcReport.uptime, (unsigned long)elapsed,
+                          (unsigned long)s.samples, (unsigned long)s.usbSamples, s.battery, s.minimum, s.maximum,
+                          (unsigned)(s.samples ? s.batterySum / s.samples : 0), (unsigned)((s.filteredQ8 + 128) >> 8), batterySum,
+                          s.vdd, s.vddMin);
+    } else if (page == 3) {
+        char ownExpectedMs[21];
+        char relayExpectedMs[21];
+        formatUint64(s.own.expectedMs, ownExpectedMs);
+        formatUint64(s.relay.expectedMs, relayExpectedMs);
+        n = std::snprintf(body, sizeof(body),
+                          "TX start/done/abort\nO:%lu/%lu/%lu R:%lu/%lu/%lu\nest_ms "
+                          "O/R:%s/%s",
+                          (unsigned long)s.own.started, (unsigned long)s.own.done, (unsigned long)s.own.interrupted,
+                          (unsigned long)s.relay.started, (unsigned long)s.relay.done, (unsigned long)s.relay.interrupted,
+                          ownExpectedMs, relayExpectedMs);
+    } else if (page == 4) {
+        char ownIrqMs[21];
+        char relayIrqMs[21];
+        formatUint64(s.own.irqMs, ownIrqMs);
+        formatUint64(s.relay.irqMs, relayIrqMs);
+        n = std::snprintf(body, sizeof(body),
+                          "irq_ms O/R:%s/%s n:%lu/%lu\nrepeat32:%lu evict:%lu fail:%lu "
+                          "open:%lu\ngaps:%lu cfg:%lu",
+                          ownIrqMs, relayIrqMs, (unsigned long)s.own.irqTimed, (unsigned long)s.relay.irqTimed,
+                          (unsigned long)s.repeated, (unsigned long)s.repeatEvictions, (unsigned long)s.startErrors,
+                          (unsigned long)s.unfinished, (unsigned long)s.gaps, (unsigned long)s.configChanges);
+    } else if (page == 5)
+        n = std::snprintf(body, sizeof(body), "%s", apcReport.radio);
+    else {
+        const auto &c = apcReport.controlStats;
+        char wouldMs[21], skippedMs[21];
+        formatUint64(c.wouldSkipMs, wouldMs);
+        formatUint64(c.skippedMs, skippedMs);
+        n = std::snprintf(body, sizeof(body),
+                          "budget C/R:%lu/%lums/min\nburst:%lums; RF:nominal\nprotected:%lu changes:%lu\nest_would/skip_ms:%s/%s",
+                          (unsigned long)legion::APC_CONSERVE_BUDGET_MS, (unsigned long)legion::APC_RESERVE_BUDGET_MS,
+                          (unsigned long)legion::APC_BURST_MS, (unsigned long)c.protectedRelays, (unsigned long)c.changes,
+                          wouldMs, skippedMs);
+    }
+    char output[legion::CONTROL_TEXT_MAX + 1];
+    if (n < 0 || size_t(n) >= sizeof(body)) {
+        reply(command.control.index, "APC report exceeds message limit");
+        return;
+    }
+    n = std::snprintf(output, sizeof(output), "!%08lx A2 s%08lx r%04x %u/6\n%s", (unsigned long)nodeDB->getNodeNum(),
+                      (unsigned long)s.session, apcReport.capture, page, body);
+    if (n < 0 || size_t(n) >= sizeof(output)) {
+        reply(command.control.index, "APC report exceeds message limit");
+        return;
+    }
+    sendText(command.control.index, output);
+}
