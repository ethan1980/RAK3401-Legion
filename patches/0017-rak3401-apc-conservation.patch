diff --git a/src/modules/LegionApc.cpp b/src/modules/LegionApc.cpp
new file mode 100644
index 0000000..4f3ad54
--- /dev/null
+++ b/src/modules/LegionApc.cpp
@@ -0,0 +1,83 @@
+#include "LegionApc.h"
+
+#if RAK3401_LEGION_APC
+#include "UptimeClock.h"
+#include "concurrency/Lock.h"
+#include "concurrency/LockGuard.h"
+#include <atomic>
+
+namespace
+{
+concurrency::Lock apcLock;
+legion::ApcObserver observer;
+legion::ApcController controller;
+std::atomic<uint32_t> irqMs{0};
+std::atomic<bool> irqValid{false};
+static_assert(std::atomic<uint32_t>::is_always_lock_free && std::atomic<bool>::is_always_lock_free,
+              "APC interrupt stamps must be lock-free");
+} // namespace
+
+bool legionApcSetMode(legion::ApcMode mode, uint32_t session, uint32_t generation)
+{
+    concurrency::LockGuard guard(&apcLock);
+    const bool changed = controller.setMode(mode, generation);
+    if (mode == legion::ApcMode::Off)
+        observer.off(Time::getUptimeSecs());
+    else if (observer.observe(Time::getUptimeSecs(), session, generation))
+        controller.resetCounters();
+    return changed;
+}
+void legionApcDisarm()
+{
+    concurrency::LockGuard guard(&apcLock);
+    controller.disarm();
+    observer.off(Time::getUptimeSecs());
+}
+legion::ApcControlStats legionApcControlSnapshot()
+{
+    concurrency::LockGuard guard(&apcLock);
+    return controller.copy(Time::getMillis());
+}
+bool legionApcAllowRelay(uint32_t generation, bool context, bool optional, uint32_t airtimeMs)
+{
+    concurrency::LockGuard guard(&apcLock);
+    return controller.allowRelay(Time::getMillis(), generation, context, optional, airtimeMs);
+}
+legion::ApcStats legionApcSnapshot()
+{
+    concurrency::LockGuard guard(&apcLock);
+    return observer.copy();
+}
+void legionApcSample(uint16_t battery, uint16_t vdd, bool usb, uint32_t generation)
+{
+    concurrency::LockGuard guard(&apcLock);
+    observer.sample(Time::getMillis(), battery, vdd, usb, generation);
+    controller.sample(Time::getMillis(), battery, vdd, usb, generation);
+}
+void legionApcTxPreparing()
+{
+    irqValid.store(false, std::memory_order_release);
+}
+void legionApcTxStarted(uint32_t from, uint32_t id, bool own, uint32_t expectedMs, uint32_t startMs)
+{
+    concurrency::LockGuard guard(&apcLock);
+    observer.started(startMs, from, id, own, expectedMs);
+}
+void legionApcTxDoneIsr(uint32_t nowMs)
+{
+    irqMs.store(nowMs, std::memory_order_relaxed);
+    irqValid.store(true, std::memory_order_release);
+}
+void legionApcTxEnded(bool done)
+{
+    const bool timed = irqValid.load(std::memory_order_acquire);
+    const uint32_t end = timed ? irqMs.load(std::memory_order_relaxed) : Time::getMillis();
+    concurrency::LockGuard guard(&apcLock);
+    observer.ended(end, done || timed, timed);
+}
+void legionApcTxStartError()
+{
+    concurrency::LockGuard guard(&apcLock);
+    observer.startError();
+}
+#endif
