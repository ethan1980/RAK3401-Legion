+bool LegionControlModule::apcContext()
+{
+    if (!apcBound)
+        return false;
+    Channel current, primary;
+    if (!findControlChannel(current) || !sameChannel(current, apcControl) || apcGeneration != radioGeneration ||
+        !readChannel(channels.getPrimaryIndex(), primary) || !sameChannel(primary, apcPrimary) ||
+        !sameApcLora(config.lora, apcLora) || config.device.role != meshtastic_Config_DeviceConfig_Role_CLIENT || rebootAtMsec ||
+        shutdownAtMsec || legionRecoveryIsBlocked() || xModem.isBusy()
+#if !MESHTASTIC_EXCLUDE_ADMIN
+        || (adminModule && adminModule->isEditingSettings())
+#endif
+    ) {
+        legionApcDisarm();
+        apcBound = false;
+        apcReport.valid = false;
+        return false;
+    }
+    return true;
+}
+
+bool LegionControlModule::allowApcRelay(const meshtastic_MeshPacket &packet, RadioInterface &radio)
+{
+    if (!apcBound)
+        return true;
+    const bool context = apcContext();
+    const auto &data = packet.decoded;
+    const bool optional = packet.which_payload_variant == meshtastic_MeshPacket_decoded_tag &&
+                          packet.transport_mechanism == meshtastic_MeshPacket_TransportMechanism_TRANSPORT_LORA &&
+                          !packet.via_mqtt && packet.from && packet.from != nodeDB->getNodeNum() && isBroadcast(packet.to) &&
+                          packet.channel != apcControl.index && packet.hop_limit && !packet.want_ack && !data.want_response &&
+                          !data.request_id && !data.reply_id && packet.priority <= meshtastic_MeshPacket_Priority_DEFAULT &&
+                          (data.portnum == meshtastic_PortNum_POSITION_APP || data.portnum == meshtastic_PortNum_TELEMETRY_APP);
+    const auto status = legionApcControlSnapshot();
+    const bool budget = context && status.hold == legion::ApcHold::None && status.state != legion::ApcState::Normal;
+    const uint32_t airtimeMs = optional && budget ? radio.getPacketTime(&packet) : 1;
+    return legionApcAllowRelay(radioGeneration, context, optional, airtimeMs);
+}
+
+bool legionControlApcAllowRelay(const meshtastic_MeshPacket &packet, RadioInterface &radio)
+{
+    return !legionControlModule || legionControlModule->allowApcRelay(packet, radio);
+}
