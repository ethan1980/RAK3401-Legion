diff --git a/src/modules/LegionApcController.h b/src/modules/LegionApcController.h
new file mode 100644
index 0000000..51390ae
--- /dev/null
+++ b/src/modules/LegionApcController.h
@@ -0,0 +1,245 @@
+#pragma once
+
+#include "mesh/Throttle.h"
+#include <algorithm>
+#include <cstdint>
+
+namespace legion
+{
+constexpr uint16_t APC_CONSERVE_MV = 3800, APC_RESERVE_MV = 3650;
+constexpr uint16_t APC_RESERVE_EXIT_MV = 3750, APC_NORMAL_MV = 3900;
+constexpr uint32_t APC_CONSERVE_MS = 900000, APC_RESERVE_MS = 300000, APC_RECOVER_MS = 900000;
+constexpr uint32_t APC_WARMUP_MS = 300000, APC_SAMPLE_MAX_MS = 20000;
+constexpr uint32_t APC_CONSERVE_BUDGET_MS = 600, APC_RESERVE_BUDGET_MS = 120, APC_BURST_MS = 2000;
+
+enum class ApcMode : uint8_t { Off, Observe, Shadow, On };
+enum class ApcState : uint8_t { Normal, Conserve, Reserve };
+enum class ApcHold : uint8_t { Off, Observe, Sample, Warmup, Usb, Context, None };
+
+inline const char *apcModeName(ApcMode mode)
+{
+    switch (mode) {
+    case ApcMode::Observe:
+        return "OBSERVE";
+    case ApcMode::Shadow:
+        return "SHADOW";
+    case ApcMode::On:
+        return "ON";
+    default:
+        return "OFF";
+    }
+}
+inline const char *apcStateName(ApcState state)
+{
+    switch (state) {
+    case ApcState::Conserve:
+        return "CONSERVE";
+    case ApcState::Reserve:
+        return "RESERVE";
+    default:
+        return "NORMAL";
+    }
+}
+inline const char *apcHoldName(ApcHold hold)
+{
+    switch (hold) {
+    case ApcHold::Off:
+        return "off";
+    case ApcHold::Observe:
+        return "observe";
+    case ApcHold::Sample:
+        return "sample";
+    case ApcHold::Warmup:
+        return "warmup";
+    case ApcHold::Usb:
+        return "USB";
+    case ApcHold::Context:
+        return "context";
+    default:
+        return "ready";
+    }
+}
+
+struct ApcControlStats {
+    ApcMode mode = ApcMode::Off;
+    ApcState state = ApcState::Normal, pending = ApcState::Normal;
+    ApcHold hold = ApcHold::Off;
+    uint16_t battery = 0, filtered = 0;
+    bool usb = false;
+    uint32_t dwellSec = 0, requiredSec = 0, changes = 0;
+    uint32_t eligible = 0, protectedRelays = 0, wouldSkip = 0, skipped = 0;
+    uint64_t wouldSkipMs = 0, skippedMs = 0;
+};
+
+class ApcController
+{
+  public:
+    void resetCounters()
+    {
+        stats.changes = stats.eligible = stats.protectedRelays = stats.wouldSkip = stats.skipped = 0;
+        stats.wouldSkipMs = stats.skippedMs = 0;
+    }
+    bool setMode(ApcMode mode, uint32_t generation)
+    {
+        if (stats.mode == mode && armedGeneration == generation) {
+            if (mode == ApcMode::Off)
+                contextStop = false;
+            return false;
+        }
+        stats.mode = mode;
+        contextStop = false;
+        armedGeneration = generation;
+        resetEvidence();
+        return true;
+    }
+    void disarm()
+    {
+        stats.mode = ApcMode::Off;
+        contextStop = true;
+        resetEvidence();
+    }
+    void sample(uint32_t now, uint16_t battery, uint16_t vdd, bool usb, uint32_t generation)
+    {
+        if (stats.mode == ApcMode::Off)
+            return;
+        if (generation != armedGeneration) {
+            disarm();
+            return;
+        }
+        if (!validSample(battery, vdd)) {
+            resetEvidence();
+            return;
+        }
+        const bool gap = haveSample && uint32_t(now - lastSample) > APC_SAMPLE_MAX_MS;
+        if (gap || (haveSample && usb != stats.usb))
+            resetEvidence();
+        if (!haveSample) {
+            filteredQ8 = uint32_t(battery) << 8;
+            warmupAt = now;
+            haveSample = true;
+        } else {
+            filteredQ8 = (11 * filteredQ8 + (uint32_t(battery) << 8) + 6) / 12;
+        }
+        lastSample = now;
+        stats.battery = battery;
+        stats.filtered = (filteredQ8 + 128) >> 8;
+        stats.usb = usb;
+        if (!warmupComplete && Throttle::deadlinePassedAt(now, warmupAt + APC_WARMUP_MS))
+            warmupComplete = true;
+        if (hold(now) != ApcHold::None) {
+            pendingActive = false;
+            return;
+        }
+        const auto next = target();
+        if (next == stats.state) {
+            pendingActive = false;
+            return;
+        }
+        if (!pendingActive || stats.pending != next) {
+            stats.pending = next;
+            pendingAt = now;
+            pendingActive = true;
+        }
+        const auto delay = pendingDelay();
+        if (Throttle::deadlinePassedAt(now, pendingAt + delay)) {
+            stats.state = next;
+            ++stats.changes;
+            pendingActive = false;
+            creditQ = 0;
+            refillAt = now;
+        }
+    }
+    bool allowRelay(uint32_t now, uint32_t generation, bool context, bool optional, uint32_t airtimeMs)
+    {
+        if (stats.mode == ApcMode::Off || stats.mode == ApcMode::Observe)
+            return true;
+        if (generation != armedGeneration) {
+            disarm();
+            return true;
+        }
+        if (!optional || !airtimeMs || airtimeMs > APC_BURST_MS) {
+            ++stats.protectedRelays;
+            return true;
+        }
+        ++stats.eligible;
+        if (!context || hold(now) != ApcHold::None || stats.state == ApcState::Normal)
+            return true;
+        const auto rate = stats.state == ApcState::Reserve ? APC_RESERVE_BUDGET_MS : APC_CONSERVE_BUDGET_MS;
+        creditQ = std::min(uint64_t(APC_BURST_MS) * 60000, creditQ + uint64_t(uint32_t(now - refillAt)) * rate);
+        refillAt = now;
+        const uint64_t cost = uint64_t(airtimeMs) * 60000;
+        if (creditQ >= cost) {
+            creditQ -= cost;
+            return true;
+        }
+        ++stats.wouldSkip;
+        stats.wouldSkipMs += airtimeMs;
+        if (stats.mode != ApcMode::On)
+            return true;
+        ++stats.skipped;
+        stats.skippedMs += airtimeMs;
+        return false;
+    }
+    ApcControlStats copy(uint32_t now, bool context = true) const
+    {
+        auto result = stats;
+        result.hold = context ? hold(now) : ApcHold::Context;
+        if (pendingActive && result.hold == ApcHold::None) {
+            const auto delay = pendingDelay();
+            result.dwellSec = std::min(uint32_t(now - pendingAt), delay) / 1000;
+            result.requiredSec = delay / 1000;
+        } else {
+            result.pending = stats.state;
+        }
+        return result;
+    }
+
+  private:
+    static bool validSample(uint16_t battery, uint16_t vdd)
+    {
+        return battery >= 2500 && battery <= 4500 && vdd >= 3000 && vdd <= 3600;
+    }
+    void resetEvidence()
+    {
+        stats.state = stats.pending = ApcState::Normal;
+        stats.battery = stats.filtered = 0;
+        stats.usb = false;
+        haveSample = pendingActive = warmupComplete = false;
+        creditQ = 0;
+    }
+    ApcHold hold(uint32_t now) const
+    {
+        if (stats.mode == ApcMode::Off)
+            return contextStop ? ApcHold::Context : ApcHold::Off;
+        if (stats.mode == ApcMode::Observe)
+            return ApcHold::Observe;
+        if (!haveSample || uint32_t(now - lastSample) > APC_SAMPLE_MAX_MS)
+            return ApcHold::Sample;
+        if (stats.usb)
+            return ApcHold::Usb;
+        if (!warmupComplete)
+            return ApcHold::Warmup;
+        return ApcHold::None;
+    }
+    ApcState target() const
+    {
+        if (stats.filtered <= APC_RESERVE_MV)
+            return ApcState::Reserve;
+        if (stats.state == ApcState::Reserve)
+            return stats.filtered >= APC_RESERVE_EXIT_MV ? ApcState::Conserve : ApcState::Reserve;
+        if (stats.state == ApcState::Conserve)
+            return stats.filtered >= APC_NORMAL_MV ? ApcState::Normal : ApcState::Conserve;
+        return stats.filtered <= APC_CONSERVE_MV ? ApcState::Conserve : ApcState::Normal;
+    }
+    uint32_t pendingDelay() const
+    {
+        if (stats.pending == ApcState::Reserve)
+            return APC_RESERVE_MS;
+        return stats.state == ApcState::Normal ? APC_CONSERVE_MS : APC_RECOVER_MS;
+    }
+    ApcControlStats stats;
+    bool haveSample = false, pendingActive = false, contextStop = false, warmupComplete = false;
+    uint32_t armedGeneration = 0, filteredQ8 = 0, warmupAt = 0, lastSample = 0, pendingAt = 0, refillAt = 0;
+    uint64_t creditQ = 0;
+};
+} // namespace legion
diff --git a/src/modules/LegionApcPolicy.h b/src/modules/LegionApcPolicy.h
new file mode 100644
index 0000000..e37a753
--- /dev/null
+++ b/src/modules/LegionApcPolicy.h
@@ -0,0 +1,136 @@
+#pragma once
+
+#include <algorithm>
+#include <cstddef>
+#include <cstdint>
+
+namespace legion
+{
+struct ApcTxStats {
+    uint32_t started = 0, done = 0, interrupted = 0, irqTimed = 0;
+    uint64_t expectedMs = 0, irqMs = 0;
+};
+
+struct ApcStats {
+    bool enabled = false;
+    uint32_t session = 0, startSec = 0, stopSec = 0, generation = 0;
+    uint32_t samples = 0, usbSamples = 0, gaps = 0, configChanges = 0;
+    uint16_t battery = 0, minimum = 0, maximum = 0, vdd = 0, vddMin = 0;
+    uint32_t filteredQ8 = 0;
+    uint64_t batterySum = 0;
+    ApcTxStats own, relay;
+    uint32_t startErrors = 0, repeated = 0, repeatEvictions = 0, unfinished = 0;
+};
+
+class ApcObserver
+{
+  public:
+    bool observe(uint32_t nowSec, uint32_t session, uint32_t generation)
+    {
+        if (stats.enabled)
+            return false;
+        *this = {};
+        stats.enabled = true;
+        stats.session = session;
+        stats.startSec = nowSec;
+        stats.generation = generation;
+        return true;
+    }
+    void off(uint32_t nowSec)
+    {
+        if (stats.enabled) {
+            stats.enabled = false;
+            stats.stopSec = nowSec;
+        }
+    }
+    void sample(uint32_t nowMs, uint16_t battery, uint16_t vdd, bool usb, uint32_t generation)
+    {
+        if (!stats.enabled)
+            return;
+        if (stats.generation != generation) {
+            ++stats.configChanges;
+            stats.generation = generation;
+        }
+        if (haveSample && uint32_t(nowMs - lastSample) > 20000)
+            ++stats.gaps;
+        lastSample = nowMs;
+        haveSample = true;
+        if (!battery || !vdd)
+            return;
+        if (!stats.samples) {
+            stats.minimum = stats.maximum = battery;
+            stats.vddMin = vdd;
+            stats.filteredQ8 = uint32_t(battery) << 8;
+        } else {
+            stats.minimum = std::min(stats.minimum, battery);
+            stats.maximum = std::max(stats.maximum, battery);
+            stats.vddMin = std::min(stats.vddMin, vdd);
+            stats.filteredQ8 = (11 * stats.filteredQ8 + (uint32_t(battery) << 8) + 6) / 12;
+        }
+        stats.battery = battery;
+        stats.vdd = vdd;
+        stats.batterySum += battery;
+        ++stats.samples;
+        stats.usbSamples += usb;
+    }
+    void started(uint32_t nowMs, uint32_t from, uint32_t id, bool own, uint32_t expectedMs)
+    {
+        if (!stats.enabled)
+            return;
+        if (active)
+            ++stats.unfinished;
+        active = true;
+        activeOwn = own;
+        txStartMs = nowMs;
+        auto &tx = own ? stats.own : stats.relay;
+        ++tx.started;
+        tx.expectedMs += expectedMs;
+        bool repeated = false;
+        for (const auto &entry : seen)
+            if (entry.used && entry.from == from && entry.id == id && uint32_t(nowMs - entry.when) <= 600000)
+                repeated = true;
+        stats.repeated += repeated;
+        if (seen[nextSeen].used && uint32_t(nowMs - seen[nextSeen].when) <= 600000)
+            ++stats.repeatEvictions;
+        seen[nextSeen] = {from, id, nowMs, true};
+        nextSeen = (nextSeen + 1) % 32;
+    }
+    void ended(uint32_t nowMs, bool done, bool irqTimed)
+    {
+        if (!active)
+            return;
+        auto &tx = activeOwn ? stats.own : stats.relay;
+        if (done) {
+            ++tx.done;
+            if (irqTimed) {
+                tx.irqMs += uint32_t(nowMs - txStartMs);
+                ++tx.irqTimed;
+            }
+        } else
+            ++tx.interrupted;
+        active = false;
+    }
+    void startError()
+    {
+        if (stats.enabled)
+            ++stats.startErrors;
+    }
+    ApcStats copy() const
+    {
+        auto result = stats;
+        result.unfinished += active;
+        return result;
+    }
+
+  private:
+    struct Seen {
+        uint32_t from = 0, id = 0, when = 0;
+        bool used = false;
+    };
+    ApcStats stats;
+    Seen seen[32]{};
