+    for (size_t i = 0; i < size; i += 4) {
+        const int a = base64Digit(text[i]), b = base64Digit(text[i + 1]);
+        const int c = base64Digit(text[i + 2]), d = base64Digit(text[i + 3]);
+        const bool last = i + 4 == size;
+        const unsigned count = text[i + 2] == '=' ? 1 : text[i + 3] == '=' ? 2 : 3;
+        if (a < 0 || b < 0 || length + count > sizeof(key) || (count == 1 && (!last || text[i + 3] != '=' || (b & 15))) ||
+            (count >= 2 && c < 0) || (count == 2 && (!last || (c & 3))) || (count == 3 && d < 0))
