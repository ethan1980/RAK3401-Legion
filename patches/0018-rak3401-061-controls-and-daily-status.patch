+void LegionControlModule::editChannel(const Pending &command)
+{
+    const auto &request = command.request;
+    const uint8_t slot = command.channelSlot;
+    const bool creating = request.command == legion::ControlCommand::CreateChannel;
+    const auto respond = [&](const char *text) { reply(command.control.index, text); };
+    if (rebootAtMsec || shutdownAtMsec || command.generation != radioGeneration) {
+        respond("Configuration busy or changed; channel request cancelled");
+        return;
+    }
+    Channel found;
+    const uint8_t matches = findDestination(request.channel, found);
+    if (creating && (matches || !std::strcmp(request.channel, "Default"))) {
+        respond(matches ? "Channel name already exists; no change" : "Reserved channel name; no change");
+        return;
+    }
+    if (!creating && matches != 1) {
+        respond(matches ? "Ambiguous channel name; no change" : "Channel not found; no change");
+        return;
+    }
+    if (!creating && (!found.index || found.index == channels.getPrimaryIndex() ||
+                      found.role != meshtastic_Channel_Role_SECONDARY || sameName(found.name, legion::TELEMETRY_CHANNEL))) {
+        respond("Primary and LegionRF channels are protected");
+        return;
+    }
+    if (slot == 0xff) {
+        respond(creating ? "No free secondary channel slot" : "Channel changed; request cancelled");
+        return;
+    }
+    if (!slot || slot >= channels.getNumChannels() ||
+        std::memcmp(&channels.getByIndex(slot), &command.selectedChannel, sizeof(command.selectedChannel)) ||
+        (creating ? channels.getByIndex(slot).role != meshtastic_Channel_Role_DISABLED : found.index != slot)) {
+        respond("Channel slot changed; request cancelled");
+        return;
+    }
+#if !MESHTASTIC_EXCLUDE_BEACON
+    if (!MeshBeaconModule::legionChannelEditAllowed(slot)) {
+        respond("Mesh Beacon active or references this slot; edit its targets first");
+        return;
+    }
+#endif
+    meshtastic_Channel updated = meshtastic_Channel_init_zero;
+    updated.index = slot;
+    updated.has_settings = true;
+    updated.role = creating ? meshtastic_Channel_Role_SECONDARY : meshtastic_Channel_Role_DISABLED;
+    if (creating) {
+        std::strcpy(updated.settings.name, request.channel);
+        updated.settings.psk.size = request.keySize;
+        std::memcpy(updated.settings.psk.bytes, request.key, request.keySize);
+    }
+    const auto saved = legionSaveChannel(updated);
+    if (saved != LegionChannelSave::Saved) {
+        respond(saved == LegionChannelSave::Uncertain ? "Channel storage unverified; writes blocked; inspect locally"
+                : saved == LegionChannelSave::Failed  ? "Channel save failed; previous settings retained"
+                                                      : "Channel storage or power unavailable; no change");
+        return;
+    }
+#if !MESHTASTIC_EXCLUDE_BEACON
+    MeshBeaconModule::legionChannelsChanged();
+#endif
+#if RAK3401_LEGION_APC
+    legionApcDisarm();
+    apcBound = false;
+    apcReport.valid = false;
+#endif
+    channels.setChannel(updated);
+    channels.onConfigChanged();
+    char text[100];
+    std::snprintf(text, sizeof(text), "%s channel %s in slot %u; saved; APC OFF", creating ? "Created" : "Deleted",
+                  request.channel, slot);
+    respond(text);
+}
