@@ -0,0 +1,28 @@
+#pragma once
+#include <cstdint>
+
+enum class LegionBackupState : uint8_t { Unknown, UpToDate, NotPresent, Outdated, Invalid };
+enum class LegionBackupDetail : uint8_t { None, Memory, Busy, Incomplete };
+struct LegionBackupStatus {
+    LegionBackupState state = LegionBackupState::Unknown;
+    LegionBackupDetail detail = LegionBackupDetail::None;
+    uint8_t changes = 0;
+    bool validRescue = false;
+};
+enum class LegionChannelSave : uint8_t { Saved, Failed, Uncertain, Unavailable };
+
+inline const char *legionBackupStateName(LegionBackupState state)
+{
+    switch (state) {
+    case LegionBackupState::UpToDate:
+        return "UP TO DATE";
+    case LegionBackupState::NotPresent:
+        return "NOT PRESENT";
+    case LegionBackupState::Outdated:
+        return "OUTDATED";
+    case LegionBackupState::Invalid:
+        return "INVALID";
+    default:
+        return "UNKNOWN";
+    }
+}
