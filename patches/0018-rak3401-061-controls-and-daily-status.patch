diff --git a/src/platform/nrf52/LegionComponents.cpp b/src/platform/nrf52/LegionComponents.cpp
new file mode 100644
index 0000000..275d859
--- /dev/null
+++ b/src/platform/nrf52/LegionComponents.cpp
@@ -0,0 +1,43 @@
+#include "LegionComponents.h"
+
+#if RAK3401_LEGION_COMPONENTS
+#if !defined(ARCH_NRF52) || !defined(RAK3401) || !defined(RAK13302)
+#error "Legion components require the RAK3401 + RAK13302 nRF52 profile"
+#endif
+#include <atomic>
+#include <cstdio>
+#include <nrf_soc.h>
+#if RAK3401_LEGION_CC310
+#include "LegionCrypto.h"
+#endif
+
+namespace
+{
+std::atomic<bool> spiAvailable{false};
+}
+
+void legionComponentsSpiAvailable(bool available)
+{
+    spiAvailable.store(available, std::memory_order_relaxed);
+}
+
+bool legionComponentsFormat(char *output, size_t size, uint32_t node)
+{
+    if (!output || !size)
+        return false;
+    char crypto[72] = "CC310:NA";
+#if RAK3401_LEGION_CC310
+    const auto stats = legionCryptoStats();
+    std::snprintf(crypto, sizeof(crypto), "CC310 SHA:%lu MAC:%lu SW:%lu", (unsigned long)stats.sha, (unsigned long)stats.hmac,
+                  (unsigned long)stats.fallback);
+#endif
+    const bool spi = spiAvailable.load(std::memory_order_relaxed);
+    char clock[24] = "NA";
+    if (spi)
+        std::snprintf(clock, sizeof(clock), "%luMHz", (unsigned long)(LEGION_RADIO_SPI_HZ / 1000000));
+    const int used =
+        std::snprintf(output, size, "!%08lx COMPONENTS\n%s\nSPI:%s %s BULK:%s\nDC/DC:%s REG1", (unsigned long)node, crypto,
+                      spi ? "ON" : "OFF", clock, RAK3401_LEGION_SPI_BULK ? "ON" : "OFF", NRF_POWER->DCDCEN == 1 ? "ON" : "OFF");
+    return used > 0 && static_cast<size_t>(used) < size && used <= 199;
+}
+#endif
