diff --git a/src/modules/LegionDailyPolicy.h b/src/modules/LegionDailyPolicy.h
new file mode 100644
index 0000000..0593486
--- /dev/null
+++ b/src/modules/LegionDailyPolicy.h
@@ -0,0 +1,31 @@
+#pragma once
+
+#include <cstdint>
+
+namespace legion
+{
+class DailySchedule
+{
+  public:
+    static constexpr uint64_t DAY_MS = 86400000, WINDOW_MS = 900000, RETRY_MS = 60000;
+    bool due(uint64_t now)
+    {
+        const uint64_t slot = now / DAY_MS;
+        if (!slot || slot <= closedSlot)
+            return false;
+        if (now % DAY_MS > WINDOW_MS) {
+            closedSlot = slot;
+            return false;
+        }
+        if (attemptSlot == slot && now - lastAttempt < RETRY_MS)
+            return false;
+        attemptSlot = slot;
+        lastAttempt = now;
+        return true;
+    }
+    void queued(uint64_t now) { closedSlot = now / DAY_MS; }
+
+  private:
+    uint64_t closedSlot = 0, attemptSlot = 0, lastAttempt = 0;
+};
+} // namespace legion
diff --git a/src/modules/LegionSecretText.h b/src/modules/LegionSecretText.h
new file mode 100644
index 0000000..6b53699
--- /dev/null
+++ b/src/modules/LegionSecretText.h
@@ -0,0 +1,20 @@
+#pragma once
+#include <cstddef>
+#include <cstdint>
+#include <cstring>
+
+namespace legion
+{
+inline bool secretControlText(const uint8_t *data, size_t size)
+{
+    if (!data)
+        return false;
+    while (size && *data <= ' ') {
+        ++data;
+        --size;
+    }
+    constexpr char command[] = "/createch";
+    constexpr size_t length = sizeof(command) - 1;
+    return size >= length && !std::memcmp(data, command, length) && (size == length || data[length] <= ' ');
+}
+} // namespace legion
