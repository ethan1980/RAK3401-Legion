+void LegionControlModule::pollDaily()
+{
+    {
+        concurrency::LockGuard guard(&stateLock);
+        if (requests.isPending() || trace.id)
+            return;
+    }
+    if (rebootAtMsec || shutdownAtMsec || legionRecoveryIsBlocked() || xModem.isBusy() || !legionPowerTxReady()
