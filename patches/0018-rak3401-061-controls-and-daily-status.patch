+LegionBackupStatus legionBackupStatus()
+{
+    LegionBackupStatus result;
+    auto page = allocate<RecoveryPage>();
+    if (!page) {
+        result.detail = LegionBackupDetail::Memory;
+        return result;
+    }
+    const auto state = store.load(*page);
+    if (state == RecoveryRead::Unavailable)
+        return result;
+    if (state == RecoveryRead::Empty || (state == RecoveryRead::Valid && page->phase == RecoveryPhase::Deleted)) {
+        result.state =
+            state == RecoveryRead::Empty && store.hasStoredData() ? LegionBackupState::Invalid : LegionBackupState::NotPresent;
+        return result;
+    }
+    if (state != RecoveryRead::Valid || !compatibleStorage()) {
+        result.state = LegionBackupState::Invalid;
+        return result;
+    }
+    auto backup = allocate<meshtastic_BackupPreferences>();
+    if (!backup) {
+        result.detail = LegionBackupDetail::Memory;
+        return result;
+    }
+    if (!snapshotValid(*page, *backup)) {
+        result.state = LegionBackupState::Invalid;
+        return result;
+    }
+    result.validRescue = true;
+    if (page->phase == RecoveryPhase::Restoring) {
+        result.detail = LegionBackupDetail::Incomplete;
+        return result;
+    }
+    if ((adminModule && adminModule->isEditingSettings()) || rebootAtMsec || shutdownAtMsec || persistenceBlocked) {
+        result.detail = LegionBackupDetail::Busy;
+        return result;
+    }
+    if (backupChanges(*page, *backup, result.changes))
+        result.state = result.changes ? LegionBackupState::Outdated : LegionBackupState::UpToDate;
+    return result;
+}
+
+LegionChannelSave legionSaveChannel(const meshtastic_Channel &channel)
+{
+    if (persistenceBlocked || !compatibleStorage() || owner.is_licensed || rebootAtMsec || shutdownAtMsec ||
+        (adminModule && adminModule->isEditingSettings()) || !powerHAL_isPowerLevelSafe() || channel.index <= 0 ||
+        channel.index >= channelFile.channels_count ||
+        channelFile.channels[channel.index].role == meshtastic_Channel_Role_PRIMARY || !channel.has_settings ||
+        (channel.role != meshtastic_Channel_Role_SECONDARY && channel.role != meshtastic_Channel_Role_DISABLED))
+        return LegionChannelSave::Unavailable;
+    const auto &current = channelFile.channels[channel.index];
+    if (current.has_settings && !strcasecmp(current.settings.name, "LegionRF"))
+        return LegionChannelSave::Unavailable;
+    auto candidate = allocate<meshtastic_ChannelFile>();
+    if (!candidate)
+        return LegionChannelSave::Unavailable;
+    *candidate = channelFile;
+    candidate->channels[channel.index] = channel;
+    if (persist(channelFileName, meshtastic_ChannelFile_size, &meshtastic_ChannelFile_msg, candidate.get()))
+        return LegionChannelSave::Saved;
+    if (legionProtoMatchesFile(channelFileName, meshtastic_ChannelFile_size, &meshtastic_ChannelFile_msg, &channelFile) ||
+        persist(channelFileName, meshtastic_ChannelFile_size, &meshtastic_ChannelFile_msg, &channelFile))
+        return LegionChannelSave::Failed;
+    legionRecoveryBlock();
+    return LegionChannelSave::Uncertain;
+}
