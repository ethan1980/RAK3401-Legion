+    const int length = std::snprintf(output, sizeof(output), "!%08lx DAILY\nAPC:%s\nBACKUP:%s",
+                                     (unsigned long)nodeDB->getNodeNum(), apcState, legionBackupStateName(backup.state));
+    Channel current;
+    if (length > 0 && static_cast<size_t>(length) < sizeof(output) && findControlChannel(current) &&
+        sameChannel(current, control) && sendText(control.index, output))
