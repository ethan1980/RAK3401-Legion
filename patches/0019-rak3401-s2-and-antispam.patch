diff --git a/src/modules/LegionGuardPolicy.h b/src/modules/LegionGuardPolicy.h
new file mode 100644
index 0000000..4c604b3
--- /dev/null
+++ b/src/modules/LegionGuardPolicy.h
@@ -0,0 +1,253 @@
+#pragma once
+
+#include <algorithm>
+#include <cstddef>
+#include <cstdint>
+#include <cstring>
+
+namespace legion
+{
+enum class GuardMode : uint8_t { Off, Observe, On };
+enum class SpamCause : uint8_t { Rate, Repeated };
+constexpr uint32_t SPAM_WINDOW_MS = 20000, SPAM_QUARANTINE_MS = 600000;
+constexpr size_t SPAM_ORIGINS = 12, SPAM_SEEN = 12, SPAM_QUARANTINES = 8;
+inline const char *guardModeName(GuardMode mode)
+{
+    return mode == GuardMode::On ? "ON" : mode == GuardMode::Observe ? "OBSERVE" : "OFF";
+}
+inline const char *spamCauseName(SpamCause cause)
+{
+    return cause == SpamCause::Repeated ? "repeat" : "rate";
+}
+
+struct SpamIdentity {
+    uint32_t node = 0;
+    uint8_t key[32]{};
+    bool verified = false;
+    bool operator==(const SpamIdentity &other) const
+    {
+        return node == other.node && verified == other.verified && (!verified || !std::memcmp(key, other.key, sizeof(key)));
+    }
+};
+struct SpamEntry {
+    uint32_t node = 0, remainingSec = 0;
+    bool verified = false;
+    SpamCause cause = SpamCause::Rate;
+};
+struct GuardStats {
+    GuardMode mode = GuardMode::Observe;
+    uint32_t fresh = 0, duplicates = 0, limited = 0, quarantined = 0, dropped = 0, wouldDrop = 0, full = 0;
+    uint8_t active = 0;
+};
+
+class GuardPolicy
+{
+  public:
+    bool setMode(GuardMode mode)
+    {
+        if (stats.mode == mode)
+            return false;
+        resetEvidence();
+        stats.mode = mode;
+        return true;
+    }
+    void contextChanged()
+    {
+        resetEvidence();
+        stats.mode = GuardMode::Off;
+    }
+    bool receive(uint32_t now, const SpamIdentity &identity, uint32_t id, uint32_t hash)
+    {
+        if (stats.mode == GuardMode::Off || !id)
+            return true;
+        expire(now);
+        if (quarantine(identity))
+            return decision(false);
+        Origin *origin = findOrigin(identity);
+        if (!origin) {
+            for (auto &candidate : origins) {
+                if (!candidate.used || (uint32_t(now - candidate.lastSeen) > 60000 && !quarantine(candidate.identity))) {
+                    candidate = {};
+                    candidate.used = true;
+                    candidate.identity = identity;
+                    candidate.refillAt = now;
+                    origin = &candidate;
+                    break;
+                }
+            }
+        }
+        if (!origin) {
+            ++stats.full;
+            return true;
+        }
+        for (const auto &event : origin->events) {
+            if (event.used && event.id == id && uint32_t(now - event.at) <= SPAM_WINDOW_MS) {
+                ++stats.duplicates;
+                return stats.mode != GuardMode::On || event.allowed;
+            }
+        }
+        ++stats.fresh;
+        origin->lastSeen = now;
+        Event &slot = origin->events[origin->next];
+        if (slot.used && uint32_t(now - slot.at) <= SPAM_WINDOW_MS) {
+            ++stats.full;
+            return true; // Lost duplicate evidence must not create an individual
+                         // sanction.
+        }
+        const uint32_t elapsed = now - origin->refillAt;
+        origin->credit = static_cast<uint16_t>(std::min(uint32_t(40000), uint32_t(origin->credit) + std::min<uint32_t>(elapsed, 40000)));
+        origin->refillAt = now;
+        const bool withinRate = origin->credit >= 5000;
+        if (withinRate)
+            origin->credit -= 5000;
+        else {
+            ++stats.limited;
+            origin->excess[origin->nextExcess] = now;
+            origin->excessUsed[origin->nextExcess] = true;
+            origin->nextExcess = (origin->nextExcess + 1) % 4;
+        }
+        uint8_t repeats = 1, excesses = 0;
+        for (const auto &event : origin->events)
+            repeats += event.used && event.hash == hash && uint32_t(now - event.at) <= SPAM_WINDOW_MS;
+        for (size_t i = 0; i < 4; ++i)
+            excesses += origin->excessUsed[i] && uint32_t(now - origin->excess[i]) <= SPAM_WINDOW_MS;
+        bool allowed = withinRate;
+        if (repeats >= 6 || excesses >= 4) {
+            allowed = false;
+            for (auto &q : quarantines) {
+                if (!q.used) {
+                    q = {};
+                    q.used = true;
+                    q.identity = identity;
+                    q.startedAt = now;
+                    q.cause = repeats >= 6 ? SpamCause::Repeated : SpamCause::Rate;
+                    ++stats.quarantined;
+                    break;
+                }
+            }
+            if (!quarantine(identity))
+                ++stats.full;
+        }
+        slot = {now, id, hash, true, allowed};
+        origin->next = (origin->next + 1) % SPAM_SEEN;
+        return decision(allowed);
+    }
+    bool allowPending(uint32_t now, const SpamIdentity &identity, uint32_t id)
+    {
+        if (stats.mode != GuardMode::On)
+            return true;
+        expire(now);
+        if (quarantine(identity))
+            return false;
+        const auto *origin = findOrigin(identity);
+        if (origin)
+            for (const auto &event : origin->events)
+                if (event.used && event.id == id && uint32_t(now - event.at) <= SPAM_WINDOW_MS)
+                    return event.allowed;
+        return true;
+    }
+    void clear(uint32_t node, uint32_t now)
+    {
+        for (auto &q : quarantines)
+            if (q.used && q.identity.node == node)
+                q = {};
+        for (auto &origin : origins)
+            if (origin.used && origin.identity.node == node) {
+                const auto identity = origin.identity;
+                origin = {};
+                origin.used = true;
+                origin.identity = identity;
+                origin.credit = 40000;
+                origin.refillAt = origin.lastSeen = now;
+            }
+    }
+    GuardStats snapshot(uint32_t now)
+    {
+        expire(now);
+        auto result = stats;
+        for (const auto &q : quarantines)
+            result.active += q.used;
+        return result;
+    }
+    size_t list(uint32_t now, SpamEntry *out, size_t capacity)
+    {
+        expire(now);
+        size_t size = 0;
+        for (const auto &q : quarantines)
+            if (q.used && size < capacity)
+                out[size++] = {q.identity.node, (SPAM_QUARANTINE_MS - uint32_t(now - q.startedAt) + 999) / 1000,
+                               q.identity.verified, q.cause};
+        return size;
+    }
+
+  private:
+    struct Event {
+        uint32_t at = 0, id = 0, hash = 0;
+        bool used = false, allowed = true;
+    };
+    struct Origin {
+        SpamIdentity identity;
+        Event events[SPAM_SEEN]{};
+        uint32_t refillAt = 0, lastSeen = 0, excess[4]{};
+        uint16_t credit = 40000;
+        uint8_t next = 0, nextExcess = 0;
+        bool used = false, excessUsed[4]{};
+    };
+    struct Quarantine {
+        SpamIdentity identity;
+        uint32_t startedAt = 0;
+        SpamCause cause = SpamCause::Rate;
+        bool used = false;
+    };
+    Origin origins[SPAM_ORIGINS]{};
+    Quarantine quarantines[SPAM_QUARANTINES]{};
+    GuardStats stats;
+    void resetEvidence()
+    {
+        for (auto &origin : origins)
+            origin = {};
+        for (auto &q : quarantines)
+            q = {};
+    }
+    Origin *findOrigin(const SpamIdentity &identity)
+    {
+        for (auto &origin : origins)
+            if (origin.used && origin.identity == identity)
+                return &origin;
+        return nullptr;
+    }
+    const Quarantine *quarantine(const SpamIdentity &identity) const
+    {
+        for (const auto &q : quarantines)
+            if (q.used && q.identity == identity)
+                return &q;
+        return nullptr;
+    }
+    void expire(uint32_t now)
+    {
+        for (auto &q : quarantines) {
+            if (!q.used || uint32_t(now - q.startedAt) < SPAM_QUARANTINE_MS)
+                continue;
+            if (auto *origin = findOrigin(q.identity)) {
+                const auto identity = origin->identity;
+                *origin = {};
+                origin->used = true;
+                origin->identity = identity;
+                origin->credit = 10000;
+                origin->refillAt = origin->lastSeen = now;
+            }
+            q = {};
+        }
+    }
+    bool decision(bool allowed)
+    {
+        if (!allowed) {
+            ++stats.wouldDrop;
+            if (stats.mode == GuardMode::On)
+                ++stats.dropped;
+        }
+        return stats.mode != GuardMode::On || allowed;
+    }
+};
+static_assert(sizeof(GuardPolicy) <= 4096, "Guard RAM budget exceeded");
+} // namespace legion
