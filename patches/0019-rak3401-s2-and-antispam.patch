@@ -0,0 +1,114 @@
+#pragma once
+
+#include "LegionApcController.h"
+#include <algorithm>
+#include <cstddef>
+#include <cstdint>
+
+namespace legion
+{
+enum class RelayKind : uint8_t { Protected, Routine, NodeInfo, Text, Opaque };
+struct RfStats {
+    uint32_t reduced = 0, wouldReduce = 0, nominal = 0, repeated = 0, errors = 0, metadataFull = 0;
+    int8_t nominalDbm = 0, targetDbm = 0, chipDbm = 0;
+    bool valid = false, fault = false;
+};
+class RfPolicy
+{
+  public:
+    int8_t target(const ApcControlStats &apc, RelayKind kind, uint32_t from, uint32_t id, uint64_t hash, int8_t nominal,
+                  uint32_t now)
+    {
+        if (apc.mode == ApcMode::Off)
+            stats.fault = false;
+        if (stats.fault || apc.hold != ApcHold::None || apc.state == ApcState::Normal ||
+            (apc.mode != ApcMode::On && apc.mode != ApcMode::Shadow) || kind == RelayKind::Protected || nominal <= 21)
+            return nominal;
+        if (wasTransmitted(from, id, now))
+            return nominal;
+        if (kind == RelayKind::NodeInfo && !knownNodeInfo(from, hash, now))
+            return nominal;
+        const int delta = apc.state == ApcState::Reserve && (kind == RelayKind::Routine || kind == RelayKind::NodeInfo) ? 6 : 3;
+        return static_cast<int8_t>(std::max(21, int(nominal) - delta));
+    }
+    void started(const ApcControlStats &apc, uint32_t from, uint32_t id, int8_t nominal, int8_t proposed, int8_t applied,
+                 uint32_t now)
+    {
+        if (wasTransmitted(from, id, now))
+            ++stats.repeated;
+        sent[nextSent] = {from, id, now, true};
+        nextSent = (nextSent + 1) % 24;
+        stats.nominalDbm = nominal;
+        stats.targetDbm = applied;
+        if (apc.mode == ApcMode::Shadow && proposed < nominal)
+            ++stats.wouldReduce;
+        if (applied < nominal)
+            ++stats.reduced;
+        else
+            ++stats.nominal;
+    }
+    void nodeInfoDone(uint32_t from, uint64_t hash, uint32_t now)
+    {
+        for (auto &entry : nodes) {
+            if (entry.used && entry.from == from) {
+                entry = {hash, from, now, true};
+                return;
+            }
+        }
+        for (auto &entry : nodes) {
+            if (!entry.used || uint32_t(now - entry.at) > 3600000) {
+                entry = {hash, from, now, true};
+                return;
+            }
+        }
+    }
+    void programmed(int8_t chip, bool success)
+    {
+        stats.valid = success;
+        if (success)
+            stats.chipDbm = chip;
+        else {
+            ++stats.errors;
+            stats.fault = true;
+        }
+    }
+    void resetFault() { stats.fault = false; }
+    void metadataFull() { ++stats.metadataFull; }
+    void contextChanged()
+    {
+        for (auto &s : sent)
+            s = {};
+        for (auto &n : nodes)
+            n = {};
+        stats.valid = false;
+    }
+    RfStats snapshot() const { return stats; }
+
+  private:
+    struct Sent {
+        uint32_t from = 0, id = 0, at = 0;
+        bool used = false;
+    } sent[24]{};
+    struct Node {
+        uint64_t hash = 0;
+        uint32_t from = 0, at = 0;
+        bool used = false;
+    } nodes[16]{};
+    uint8_t nextSent = 0;
+    RfStats stats;
+    bool wasTransmitted(uint32_t from, uint32_t id, uint32_t now) const
+    {
+        for (const auto &entry : sent)
+            if (entry.used && entry.from == from && entry.id == id && uint32_t(now - entry.at) <= 120000)
+                return true;
+        return false;
+    }
+    bool knownNodeInfo(uint32_t from, uint64_t hash, uint32_t now) const
+    {
+        for (const auto &entry : nodes)
+            if (entry.used && entry.from == from && entry.hash == hash && uint32_t(now - entry.at) <= 3600000)
+                return true;
+        return false;
+    }
+};
+} // namespace legion
diff --git a/src/modules/LegionTraffic.cpp b/src/modules/LegionTraffic.cpp
new file mode 100644
index 0000000..a1e3b7d
--- /dev/null
+++ b/src/modules/LegionTraffic.cpp
@@ -0,0 +1,300 @@
+#include "LegionTraffic.h"
+
+#if RAK3401_LEGION_TRAFFIC
+#if !RAK3401_LEGION_APC || !RAK3401_LEGION_CONTROL
+#error "Legion traffic policies require APC and private control"
+#endif
+#include "Channels.h"
+#include "LegionApc.h"
+#include "NodeDB.h"
+#include "UptimeClock.h"
+#include "concurrency/Lock.h"
+#include "concurrency/LockGuard.h"
+#include "main.h"
+
+namespace
+{
+concurrency::Lock trafficLock;
+legion::GuardPolicy guardPolicy;
+legion::RfPolicy rfPolicy;
+struct Context {
+    uint32_t generation = 0;
+    uint8_t primary = 0, role = 0, keySize = 0;
+    uint8_t key[32]{};
+    char name[12]{};
+    bool aead = false;
+} context;
+bool haveContext = false;
+struct Tag {
+    const meshtastic_MeshPacket *packet = nullptr;
+    legion::SpamIdentity identity;
+    uint64_t nodeInfoHash = 0;
+    uint32_t id = 0;
+    legion::RelayKind kind = legion::RelayKind::Protected;
+    int8_t nominal = 0, proposed = 0, applied = 0;
+    bool primaryText = false, started = false;
+} tags[legion::TRAFFIC_TAG_CAPACITY];
+const meshtastic_MeshPacket *preparedPacket = nullptr;
+int8_t preparedPower = 0;
+static_assert(sizeof(tags) + sizeof(guardPolicy) + sizeof(rfPolicy) <= 7168, "Legion traffic RAM budget exceeded");
+
+void syncContext()
+{
+    Context next{};
+    next.generation = radioGeneration;
+    next.primary = channels.getPrimaryIndex();
+    next.role = config.device.role;
+    if (next.primary < channels.getNumChannels()) {
+        const auto &ch = channels.getByIndex(next.primary);
+        next.keySize = std::min(size_t(32), size_t(ch.settings.psk.size));
+        std::memcpy(next.key, ch.settings.psk.bytes, next.keySize);
+        std::memcpy(next.name, ch.settings.name, sizeof(next.name));
+        next.aead = channels.isAEADEnabled(next.primary);
+    }
+    bool changed = false;
+    {
+        concurrency::LockGuard lock(&trafficLock);
+        if (!haveContext || context.generation != next.generation || context.primary != next.primary ||
+            context.role != next.role || context.keySize != next.keySize || context.aead != next.aead ||
+            std::memcmp(context.key, next.key, sizeof(next.key)) || std::memcmp(context.name, next.name, sizeof(next.name))) {
+            changed = haveContext;
+            context = next;
+            haveContext = true;
+            if (changed) {
+                guardPolicy.contextChanged();
+                rfPolicy.contextChanged();
+                for (auto &tag : tags)
+                    tag = {};
+            }
+        }
+    }
+    if (changed)
+        legionApcDisarm();
+}
+
+bool textPort(const meshtastic_MeshPacket &p)
+{
+    return p.which_payload_variant == meshtastic_MeshPacket_decoded_tag &&
+           (p.decoded.portnum == meshtastic_PortNum_TEXT_MESSAGE_APP ||
+            p.decoded.portnum == meshtastic_PortNum_TEXT_MESSAGE_COMPRESSED_APP);
+}
+bool primaryText(const meshtastic_MeshPacket &p)
+{
+    return p.from && !isFromUs(&p) && isBroadcast(p.to) && p.channel == channels.getPrimaryIndex() && textPort(p);
+}
+bool identityOf(const meshtastic_MeshPacket &p, legion::SpamIdentity &identity)
+{
+    identity = {};
+    identity.node = getFrom(&p);
+    identity.verified = p.xeddsa_signed;
+    if (!identity.verified)
+        return true;
+    meshtastic_NodeInfoLite_public_key_t key = {0, {0}};
+    if (!nodeDB->copyPublicKeyAuthoritative(p.from, key) || key.size != 32)
+        return false;
+    std::memcpy(identity.key, key.bytes, sizeof(identity.key));
+    return true;
+}
+uint64_t contentHash(const meshtastic_MeshPacket &p)
+{
+    uint64_t hash = 14695981039346656037ULL;
+    hash = (hash ^ static_cast<uint32_t>(p.decoded.portnum)) * 1099511628211ULL;
+    hash = (hash ^ p.decoded.payload.size) * 1099511628211ULL;
+    for (size_t i = 0; i < p.decoded.payload.size && i < sizeof(p.decoded.payload.bytes); ++i)
+        hash = (hash ^ p.decoded.payload.bytes[i]) * 1099511628211ULL;
+    return hash;
+}
+bool controlChannel(uint8_t index)
+{
+    return index < channels.getNumChannels() &&
+           !std::strncmp(channels.getByIndex(index).settings.name, "LegionRF", sizeof(context.name));
+}
+legion::RelayKind classify(const meshtastic_MeshPacket &p)
+{
+    if (isFromUs(&p) || isToUs(&p) || owner.is_licensed || config.device.role != meshtastic_Config_DeviceConfig_Role_CLIENT ||
+        p.transport_mechanism != meshtastic_MeshPacket_TransportMechanism_TRANSPORT_LORA || p.via_mqtt)
+        return legion::RelayKind::Protected;
+    if (p.which_payload_variant == meshtastic_MeshPacket_encrypted_tag)
+        return p.channel == 0 && !isBroadcast(p.to) ? legion::RelayKind::Opaque : legion::RelayKind::Protected;
+    if (p.which_payload_variant != meshtastic_MeshPacket_decoded_tag || controlChannel(p.channel))
+        return legion::RelayKind::Protected;
+    if (textPort(p))
+        return legion::RelayKind::Text;
+    if (p.decoded.want_response || p.decoded.request_id || p.decoded.reply_id || p.want_ack ||
+        p.priority > meshtastic_MeshPacket_Priority_DEFAULT)
+        return legion::RelayKind::Protected;
+    if (isBroadcast(p.to) && p.decoded.portnum == meshtastic_PortNum_NODEINFO_APP)
+        return legion::RelayKind::NodeInfo;
+    if (isBroadcast(p.to) &&
+        (p.decoded.portnum == meshtastic_PortNum_POSITION_APP || p.decoded.portnum == meshtastic_PortNum_TELEMETRY_APP))
+        return legion::RelayKind::Routine;
+    return legion::RelayKind::Protected;
+}
+Tag *findTag(const meshtastic_MeshPacket *packet)
+{
+    if (!packet)
+        return nullptr;
+    for (auto &tag : tags)
+        if (tag.packet == packet)
+            return &tag;
+    return nullptr;
+}
+} // namespace
+
+bool legionTrafficAllowReceived(const meshtastic_MeshPacket &p, RxSource source)
+{
+    syncContext();
+    if (source != RX_SRC_RADIO || !primaryText(p))
+        return true;
+    legion::SpamIdentity identity;
+    if (!identityOf(p, identity))
+        return true;
+    const uint64_t hash = contentHash(p);
+    concurrency::LockGuard lock(&trafficLock);
+    return guardPolicy.receive(Time::getMillis(), identity, p.id, static_cast<uint32_t>(hash ^ (hash >> 32)));
+}
+bool legionTrafficAllowRelay(const meshtastic_MeshPacket &p)
+{
+    syncContext();
+    if (!primaryText(p))
+        return true;
+    legion::SpamIdentity identity;
+    if (!identityOf(p, identity))
+        return true;
+    concurrency::LockGuard lock(&trafficLock);
+    return guardPolicy.allowPending(Time::getMillis(), identity, p.id);
+}
+bool legionTrafficAllowQueued(const meshtastic_MeshPacket *p)
+{
+    syncContext();
+    concurrency::LockGuard lock(&trafficLock);
+    const Tag *tag = findTag(p);
+    return !tag || !tag->primaryText || guardPolicy.allowPending(Time::getMillis(), tag->identity, tag->id);
+}
+void legionTrafficTagOutgoing(const meshtastic_MeshPacket *p)
+{
+    syncContext();
+    Tag value{};
+    value.packet = p;
+    value.identity.node = getFrom(p);
+    value.id = p->id;
+    value.kind = classify(*p);
+    value.primaryText = primaryText(*p) && identityOf(*p, value.identity);
+    if (value.kind == legion::RelayKind::NodeInfo)
+        value.nodeInfoHash = contentHash(*p);
+    concurrency::LockGuard lock(&trafficLock);
+    Tag *slot = findTag(p);
+    if (slot)
+        *slot = {};
+    if (value.kind == legion::RelayKind::Protected && !value.primaryText)
+        return;
+    for (auto &candidate : tags) {
+        if (!candidate.packet) {
+            candidate = value;
+            return;
+        }
+    }
+    rfPolicy.metadataFull();
+}
+void legionTrafficForget(const meshtastic_MeshPacket *p)
+{
+    if (!p)
+        return;
+    concurrency::LockGuard lock(&trafficLock);
+    if (auto *tag = findTag(p))
+        *tag = {};
+}
+int8_t legionTrafficTxPower(const meshtastic_MeshPacket *p, int8_t nominal)
+{
+    syncContext();
+    const auto apc = legionApcControlSnapshot();
+    concurrency::LockGuard lock(&trafficLock);
+    Tag *tag = findTag(p);
+    preparedPacket = p;
+    preparedPower = nominal;
+    if (!tag)
+        return nominal;
+    tag->nominal = nominal;
+    tag->proposed = rfPolicy.target(apc, tag->kind, tag->identity.node, tag->id, tag->nodeInfoHash, nominal, Time::getMillis());
+    tag->applied = apc.mode == legion::ApcMode::On ? tag->proposed : nominal;
+    preparedPower = tag->applied;
+    return tag->applied;
+}
+bool legionTrafficTxPlanCurrent(const meshtastic_MeshPacket *p, int8_t nominal)
+{
+    syncContext();
+    const auto apc = legionApcControlSnapshot();
+    concurrency::LockGuard lock(&trafficLock);
+    const Tag *tag = findTag(p);
+    const int8_t desired = tag && apc.mode == legion::ApcMode::On ? rfPolicy.target(apc, tag->kind, tag->identity.node, tag->id,
+                                                                                    tag->nodeInfoHash, nominal, Time::getMillis())
+                                                                  : nominal;
+    return preparedPacket == p && preparedPower == desired;
+}
+void legionTrafficRfResetFault()
+{
+    concurrency::LockGuard lock(&trafficLock);
+    rfPolicy.resetFault();
+}
+void legionTrafficPowerProgrammed(int8_t chip, bool success)
+{
+    concurrency::LockGuard lock(&trafficLock);
+    rfPolicy.programmed(chip, success);
+}
+void legionTrafficPowerFallback(const meshtastic_MeshPacket *p, int8_t nominal)
+{
+    concurrency::LockGuard lock(&trafficLock);
+    if (auto *tag = findTag(p))
+        tag->applied = nominal;
+    if (preparedPacket == p)
+        preparedPower = nominal;
+}
+void legionTrafficTxStarted(const meshtastic_MeshPacket *p)
+{
+    const auto apc = legionApcControlSnapshot();
+    concurrency::LockGuard lock(&trafficLock);
+    if (auto *tag = findTag(p)) {
+        tag->started = true;
+        rfPolicy.started(apc, tag->identity.node, tag->id, tag->nominal, tag->proposed, tag->applied, Time::getMillis());
+    } else {
+        const int8_t nominal = config.lora.tx_power;
+        rfPolicy.started(apc, getFrom(p), p->id, nominal, nominal, nominal, Time::getMillis());
+    }
+}
+void legionTrafficTxEnded(const meshtastic_MeshPacket *p, bool done)
+{
+    concurrency::LockGuard lock(&trafficLock);
+    const Tag *tag = findTag(p);
+    if (tag && tag->started && done && tag->kind == legion::RelayKind::NodeInfo)
+        rfPolicy.nodeInfoDone(tag->identity.node, tag->nodeInfoHash, Time::getMillis());
+}
+void legionTrafficSetGuard(legion::GuardMode mode)
+{
+    syncContext();
+    concurrency::LockGuard lock(&trafficLock);
+    guardPolicy.setMode(mode);
+}
+void legionTrafficClearSpam(uint32_t node)
+{
+    syncContext();
+    concurrency::LockGuard lock(&trafficLock);
+    guardPolicy.clear(node, Time::getMillis());
+}
+legion::GuardStats legionTrafficGuardStatus()
+{
+    syncContext();
+    concurrency::LockGuard lock(&trafficLock);
+    return guardPolicy.snapshot(Time::getMillis());
+}
+legion::RfStats legionTrafficRfStatus()
+{
+    concurrency::LockGuard lock(&trafficLock);
+    return rfPolicy.snapshot();
+}
+size_t legionTrafficSpamList(legion::SpamEntry *entries, size_t capacity)
+{
+    syncContext();
+    concurrency::LockGuard lock(&trafficLock);
+    return guardPolicy.list(Time::getMillis(), entries, capacity);
+}
+#endif
diff --git a/src/modules/LegionTraffic.h b/src/modules/LegionTraffic.h
new file mode 100644
index 0000000..ee7649b
--- /dev/null
+++ b/src/modules/LegionTraffic.h
@@ -0,0 +1,44 @@
+#pragma once
+
+#include "configuration.h"
+
+#if RAK3401_LEGION_TRAFFIC
+#include "LegionGuardPolicy.h"
+#include "LegionRfPolicy.h"
+#include "MeshTypes.h"
+
+namespace legion { constexpr size_t TRAFFIC_TAG_CAPACITY = 24; }
+
+bool legionTrafficAllowReceived(const meshtastic_MeshPacket &packet, RxSource source);
+bool legionTrafficAllowRelay(const meshtastic_MeshPacket &packet);
+bool legionTrafficAllowQueued(const meshtastic_MeshPacket *packet);
+void legionTrafficTagOutgoing(const meshtastic_MeshPacket *packet);
+void legionTrafficForget(const meshtastic_MeshPacket *packet);
+int8_t legionTrafficTxPower(const meshtastic_MeshPacket *packet, int8_t nominal);
+bool legionTrafficTxPlanCurrent(const meshtastic_MeshPacket *packet, int8_t nominal);
+void legionTrafficRfResetFault();
+void legionTrafficPowerProgrammed(int8_t chip, bool success);
+void legionTrafficPowerFallback(const meshtastic_MeshPacket *packet, int8_t nominal);
+void legionTrafficTxStarted(const meshtastic_MeshPacket *packet);
+void legionTrafficTxEnded(const meshtastic_MeshPacket *packet, bool done);
+void legionTrafficSetGuard(legion::GuardMode mode);
+void legionTrafficClearSpam(uint32_t node);
+legion::GuardStats legionTrafficGuardStatus();
+legion::RfStats legionTrafficRfStatus();
+size_t legionTrafficSpamList(legion::SpamEntry *entries, size_t capacity);
+
+class LegionTrafficPacketLease
+{
+  public:
+    explicit LegionTrafficPacketLease(const meshtastic_MeshPacket *packet) : packet(packet) { legionTrafficTagOutgoing(packet); }
+    ~LegionTrafficPacketLease()
+    {
+        if (packet)
+            legionTrafficForget(packet);
+    }
+    void transferred() { packet = nullptr; }
+
+  private:
+    const meshtastic_MeshPacket *packet;
+};
+#endif
