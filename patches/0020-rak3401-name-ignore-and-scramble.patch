diff --git a/src/mesh/LegionNameIgnore.cpp b/src/mesh/LegionNameIgnore.cpp
new file mode 100644
index 0000000..159a664
--- /dev/null
+++ b/src/mesh/LegionNameIgnore.cpp
@@ -0,0 +1,232 @@
+#include "LegionNameIgnore.h"
+#include "configuration.h"
+
+#if RAK3401_LEGION_CONTROL
+#include "LegionIgnore.h"
+#include "NodeDB.h"
+#include "SafeFile.h"
+#include "Throttle.h"
+#include "UptimeClock.h"
+#include "concurrency/LockGuard.h"
+#include "power/PowerHAL.h"
+#include <algorithm>
+#include <cstdio>
+#include <cstring>
+#include <pb_decode.h>
+#ifdef MESHTASTIC_ENCRYPTED_STORAGE
+#include "security/EncryptedStorage.h"
+#endif
+
+namespace {
+constexpr char PATH[] = "/prefs/legion-ignore-names.bin";
+constexpr size_t MAX_RULES = 8;
+constexpr size_t MAX_ALIASES = 24;
+constexpr uint32_t ALIAS_IDLE_MS = 60 * 60 * 1000;
+constexpr unsigned RULES_PER_PAGE = 2;
+static_assert(sizeof(meshtastic_User::long_name) == legion::IGNORE_NAME_BYTES);
+
+struct Rules {
+  char version[4] = {'L', 'N', 'I', 1};
+  char names[MAX_RULES][legion::IGNORE_NAME_BYTES]{};
+};
+struct RuleStats {
+  NodeNum last = 0;
+  uint32_t drops = 0;
+};
+struct Alias {
+  NodeNum node = 0;
+  uint32_t expires = 0;
+  size_t rule = 0;
+  bool verified = false;
+};
+
+concurrency::Lock nameIgnoreLock;
+concurrency::Lock nameStoreLock;
+Rules rules;
+RuleStats stats[MAX_RULES];
+Alias aliases[MAX_ALIASES];
+size_t nextAlias = 0;
+
+size_t findRule(const char *name) {
+  for (size_t i = 0; i < MAX_RULES; ++i)
+    if (std::strcmp(rules.names[i], name) == 0)
+      return i;
+  return MAX_RULES;
+}
+
+Alias *findAlias(NodeNum node, uint32_t now) {
+  for (auto &entry : aliases) {
+    if (entry.node && Throttle::deadlinePassedAt(now, entry.expires))
+      entry = {};
+    if (entry.node == node)
+      return &entry;
+  }
+  return nullptr;
+}
+
+void remember(NodeNum node, size_t rule, bool verified, uint32_t now,
+              Alias *entry) {
+  if (!entry) {
+    for (auto &candidate : aliases) {
+      if (!candidate.node) {
+        entry = &candidate;
+        break;
+      }
+    }
+  }
+  if (!entry) {
+    entry = &aliases[nextAlias];
+    nextAlias = (nextAlias + 1) % MAX_ALIASES;
+  }
+  *entry = {node, now + ALIAS_IDLE_MS, rule, verified};
+}
+
+bool countDrop(size_t rule, NodeNum node) {
+  stats[rule].last = node;
+  ++stats[rule].drops;
+  return true;
+}
+
+bool externalOrigin(const meshtastic_MeshPacket &packet) {
+  return packet.from >= 4 && !isBroadcast(packet.from) && !isFromUs(&packet);
+}
+} // namespace
+
+void legionLoadNameIgnores() {
+  Rules saved;
+  {
+    concurrency::LockGuard io(spiLock);
+    auto file = FSCom.open(PATH, FILE_O_READ);
+    if (!file)
+      return;
+    const bool valid =
+        file.read(reinterpret_cast<uint8_t *>(&saved), sizeof(saved)) ==
+            sizeof(saved) &&
+        file.read() < 0 &&
+        std::memcmp(saved.version, rules.version, sizeof(saved.version)) == 0;
+    file.close();
+    if (!valid)
+      return;
+  }
+  for (const auto &name : saved.names)
+    if (!std::memchr(name, '\0', sizeof(name)))
+      return;
+  concurrency::LockGuard guard(&nameIgnoreLock);
+  rules = saved;
+}
+
+LegionIgnoreResult legionSetNameIgnored(const char *name, bool ignored) {
+  const auto length = strnlen(name, legion::IGNORE_NAME_BYTES);
+  if (!length || length >= legion::IGNORE_NAME_BYTES)
+    return LegionIgnoreResult::Invalid;
+  concurrency::LockGuard store(&nameStoreLock);
+  Rules candidate;
+  size_t slot;
+  {
+    concurrency::LockGuard guard(&nameIgnoreLock);
+    slot = findRule(name);
+    if ((slot != MAX_RULES) == ignored)
+      return LegionIgnoreResult::Unchanged;
+    if (ignored)
+      slot = findRule("");
+    candidate = rules;
+  }
+  if (slot == MAX_RULES)
+    return LegionIgnoreResult::Capacity;
+#ifdef MESHTASTIC_ENCRYPTED_STORAGE
+  if (EncryptedStorage::isLockdownActive() && !EncryptedStorage::isUnlocked())
+    return LegionIgnoreResult::Unavailable;
+#endif
+  if (!powerHAL_isPowerLevelSafe())
+    return LegionIgnoreResult::Unavailable;
+  std::memset(candidate.names[slot], 0, sizeof(candidate.names[slot]));
+  if (ignored)
+    std::memcpy(candidate.names[slot], name, length);
+  SafeFile file(PATH, true);
+  if (file.write(reinterpret_cast<const uint8_t *>(&candidate),
+                 sizeof(candidate)) != sizeof(candidate) ||
+      !file.close())
+    return LegionIgnoreResult::Unavailable;
+  concurrency::LockGuard guard(&nameIgnoreLock);
+  rules = candidate;
+  stats[slot] = {};
+  for (auto &entry : aliases)
+    if (entry.node && entry.rule == slot)
+      entry = {};
+  return LegionIgnoreResult::Saved;
+}
+
+void legionFormatNameIgnores(unsigned page, char *output, size_t size) {
+  concurrency::LockGuard guard(&nameIgnoreLock);
+  unsigned count = 0;
+  for (const auto &name : rules.names)
+    count += name[0] != '\0';
+  const unsigned pages =
+      count ? (count + RULES_PER_PAGE - 1) / RULES_PER_PAGE : 1;
+  if (page < 1 || page > pages) {
+    std::snprintf(output, size, "Name ignore list has %u page(s)", pages);
+    return;
+  }
+  int used = std::snprintf(output, size, "Name ignores %u/%u%s", page, pages,
+                           count ? "" : "\nNone");
+  unsigned index = 0;
+  for (size_t i = 0;
+       i < MAX_RULES && used >= 0 && static_cast<size_t>(used) < size; ++i) {
+    if (rules.names[i][0] && index++ / RULES_PER_PAGE + 1 == page)
+      used += std::snprintf(output + used, size - used, "\n%s !%08lx drops:%lu",
+                            rules.names[i], (unsigned long)stats[i].last,
+                            (unsigned long)stats[i].drops);
+  }
+}
+
+bool legionNameIgnoreDropsReceived(const meshtastic_MeshPacket &packet) {
+  if (!externalOrigin(packet))
+    return false;
+  concurrency::LockGuard guard(&nameIgnoreLock);
+  const auto now = Time::getMillis();
+  auto *entry = findAlias(packet.from, now);
+  const bool nodeInfo =
+      packet.decoded.portnum == meshtastic_PortNum_NODEINFO_APP;
+  if (!entry &&
+      (!nodeInfo || std::none_of(rules.names, rules.names + MAX_RULES,
+                                 [](const auto &name) { return name[0]; })))
+    return false;
+  const bool knownSigner = packet.xeddsa_signed || (entry && entry->verified) ||
+                           nodeDB->isKnownXeddsaSigner(packet.from);
+  if (nodeInfo) {
+    // A trusted identity can replace an older observation made without a
+    // signature.
+    meshtastic_User user{};
+    if (pb_decode_from_bytes(packet.decoded.payload.bytes,
+                             packet.decoded.payload.size, &meshtastic_User_msg,
+                             &user) &&
+        user.is_licensed == owner.is_licensed && user.long_name[0]) {
+      const auto rule = findRule(user.long_name);
+      if (packet.xeddsa_signed || !knownSigner) {
+        if (rule != MAX_RULES)
+          remember(packet.from, rule, packet.xeddsa_signed, now, entry);
+        else if (entry)
+          *entry = {};
+        return rule != MAX_RULES && countDrop(rule, packet.from);
+      }
+      if (rule != MAX_RULES)
+        return countDrop(rule, packet.from);
+    }
+  }
+  if (!entry || (!entry->verified && knownSigner))
+    return false;
+  entry->expires = now + ALIAS_IDLE_MS;
+  return countDrop(entry->rule, packet.from);
+}
+
+bool legionNameIgnoreDropsOrigin(const meshtastic_MeshPacket &packet) {
+  if (!externalOrigin(packet))
+    return false;
+  concurrency::LockGuard guard(&nameIgnoreLock);
+  const auto *entry = findAlias(packet.from, Time::getMillis());
+  return entry &&
+         (entry->verified || (!packet.xeddsa_signed &&
+                              !nodeDB->isKnownXeddsaSigner(packet.from))) &&
+         countDrop(entry->rule, packet.from);
+}
+#endif
