+[[noreturn]] void legionWaitForTimedRestart(uint32_t deadline)
+{
+    sd_power_mode_set(NRF_POWER_MODE_LOWPWR);
+    auto now = Time::getMillis();
+    while (!Throttle::deadlinePassedAt(now, deadline)) {
+        feedSleepWatchdog();
+        delay(std::min(RECOVERY_CHECK_MS, deadline - now));
+        now = Time::getMillis();
+    }
+    NVIC_SystemReset();
+}
