diff --git a/src/power/LegionThermalPolicy.h b/src/power/LegionThermalPolicy.h
new file mode 100644
index 0000000..4bdb779
--- /dev/null
+++ b/src/power/LegionThermalPolicy.h
@@ -0,0 +1,57 @@
+#pragma once
+
+#include "mesh/Throttle.h"
+#include <cstdint>
+
+namespace legion
+{
+constexpr uint32_t CPU_THERMAL_CHECK_MS = 30000;
+constexpr uint32_t CPU_THERMAL_CONFIRM_MS = 3 * 60 * 1000;
+constexpr int16_t CPU_THERMAL_SUSPEND_QUARTERS = 70 * 4;
+constexpr int16_t CPU_THERMAL_RESUME_QUARTERS = 60 * 4;
+
+inline bool cpuThermalCooled(bool valid, int16_t quarterDegrees)
+{
+    return valid && quarterDegrees <= CPU_THERMAL_RESUME_QUARTERS;
+}
+
+class CpuThermalPolicy
+{
+  public:
+    bool sampleDue(uint32_t now) const { return !sampled || Throttle::deadlinePassedAt(now, nextSample); }
+
+    bool observeHeating(uint32_t now, bool valid, int16_t quarterDegrees)
+    {
+        // A missed reading cannot count towards a sustained high temperature.
+        if (sampled && Throttle::deadlinePassedAt(now, nextSample + CPU_THERMAL_CHECK_MS))
+            hot = false;
+        sampled = true;
+        nextSample = now + CPU_THERMAL_CHECK_MS;
+
+        if (!valid || quarterDegrees < CPU_THERMAL_SUSPEND_QUARTERS) {
+            hot = false;
+            return false;
+        }
+        if (!hot) {
+            hot = true;
+            suspendAt = now + CPU_THERMAL_CONFIRM_MS;
+        }
+        return Throttle::deadlinePassedAt(now, suspendAt);
+    }
+
+    bool observeCooling(bool valid, int16_t quarterDegrees)
+    {
+        const bool cool = cpuThermalCooled(valid, quarterDegrees);
+        const bool confirmed = cool && previousCool;
+        previousCool = cool;
+        return confirmed;
+    }
+
+  private:
+    uint32_t nextSample = 0;
+    uint32_t suspendAt = 0;
+    bool sampled = false;
+    bool hot = false;
+    bool previousCool = false;
+};
+} // namespace legion
