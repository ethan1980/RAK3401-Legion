+#if RAK3401_LEGION_CONTROL
+bool legionCpuThermalSuspendDue()
+{
+    const auto now = Time::getMillis();
+    if (!thermalPolicy.sampleDue(now))
+        return false;
+
+    int16_t quarterDegrees = 0;
+    const bool valid = legionReadCpuTemperature(quarterDegrees);
+    if (!thermalPolicy.observeHeating(now, valid, quarterDegrees))
+        return false;
+
+    LOG_WARN("Legion CPU overheat at %d C, suspending", quarterDegrees / 4);
+    return true;
+}
+
+[[noreturn]] void legionWaitForThermalRecovery(uint32_t restartNotBefore)
+{
+#if RAK3401_LEGION_BOOT
+    legionBootRecordShutdown(LegionShutdown::CpuThermal);
+#endif
+    powerOffPeripherals();
+    uint8_t softDeviceEnabled = 0;
+    if (sd_softdevice_is_enabled(&softDeviceEnabled) == NRF_SUCCESS && softDeviceEnabled)
+        sd_power_mode_set(NRF_POWER_MODE_LOWPWR);
+
+    while (true) {
+        feedSleepWatchdog();
+        delay(legion::CPU_THERMAL_CHECK_MS);
+        int16_t quarterDegrees = 0;
+        const bool valid = legionReadCpuTemperature(quarterDegrees);
+        if (thermalPolicy.observeCooling(valid, quarterDegrees) &&
+            (!restartNotBefore || Throttle::deadlinePassed(restartNotBefore)))
+            NVIC_SystemReset();
+    }
+}
+#endif
+
 void legionPowerPoll()
 {
     static bool sampled = false;
