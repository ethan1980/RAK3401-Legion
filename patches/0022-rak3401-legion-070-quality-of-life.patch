+void LegionControlModule::sendHibernationNotice(const char *text, bool thermal, bool entering)
+{
+    Channel control;
+    if (!legionPowerTxReady() || !router->getRadioIface() || !findControlChannel(control))
+        return;
+    if (!entering) {
+        reply(control.index, text);
+        return;
+    }
+    char output[legion::CONTROL_TEXT_MAX + 1];
+    const int length = std::snprintf(output, sizeof(output), "!%08lx: %s", (unsigned long)nodeDB->getNodeNum(), text);
+    if (length <= 0 || size_t(length) >= sizeof(output))
+        return;
+    auto *packet = allocDataPacket();
+    if (!packet)
+        return;
+    packet->channel = control.index;
+    packet->to = NODENUM_BROADCAST;
+    packet->want_ack = false;
+    packet->decoded.want_response = false;
+    packet->priority = meshtastic_MeshPacket_Priority_HIGH;
+    packet->decoded.payload.size = length;
+    std::memcpy(packet->decoded.payload.bytes, output, length);
+    const auto id = packet->id;
+    legionStartHibernationNotice(id, thermal);
+    if (service->sendToMesh(packet, RX_SRC_LOCAL, true) != 0)
+        legionFinishHibernationNotice(id);
+}
+
+void legionControlEnterHibernation(bool thermal)
+{
+    if (thermal)
+        legionStartHibernationNotice(0, true);
+    if (legionControlModule)
+        legionControlModule->sendHibernationNotice(
+            thermal ? "Entering hibernation due to high CPU temperature." : "Entering hibernation for Scramble.", thermal, true);
+}
+
+void legionControlLowSupplyNotice()
+{
+    if (legionControlModule && !legionHibernationPending())
+        legionControlModule->sendHibernationNotice("Low supply voltage. Hibernation possible.", false, false);
+}
+
+void LegionControlModule::pollRecoveryNotice()
+{
+#if RAK3401_LEGION_BOOT
+    if (recoveryNoticeAttempted || controlBusy() || !legionPowerTxReady() || !router->getRadioIface())
+        return;
+    const char *message = nullptr;
+    switch (legionBootSnapshot().previous) {
+    case LegionShutdown::BootProtect:
+    case LegionShutdown::LowBattery:
+    case LegionShutdown::LowVdd:
+        message = "Hibernation ended. Supply voltage recovered.";
+        break;
+    case LegionShutdown::CpuThermal:
+        message = "Hibernation ended. CPU cooled down.";
+        break;
+    case LegionShutdown::Scramble:
+        message = "Hibernation ended. Scramble complete.";
+        break;
+    default:
+        recoveryNoticeAttempted = true;
+        return;
+    }
+    Channel control;
+    if (!findControlChannel(control))
+        return;
+    recoveryNoticeAttempted = true;
+    reply(control.index, message);
+#endif
+}
