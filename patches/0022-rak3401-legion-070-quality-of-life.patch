+void LegionControlModule::advanceMeshHealth()
+{
+    meshHealth.advance(Time::getMillisMonotonic(), radioGeneration, nodeDB->committedLoraSlot(), config.device.role);
+}
+
+void LegionControlModule::observeMeshRx(const meshtastic_MeshPacket &packet, int8_t hopsAway)
+{
+    if (packet.via_mqtt || packet.from == nodeDB->getNodeNum() || nodeDB->isLoraSlotTransient())
+        return;
+    if (hopsAway == 0 && (!packet.has_rx_rssi || !std::isfinite(packet.rx_snr) || packet.rx_snr < -128 || packet.rx_snr > 127))
+        hopsAway = -1;
+    concurrency::LockGuard guard(&stateLock);
+    advanceMeshHealth();
+    meshHealth.hear(packet.from, hopsAway);
+}
+
+void LegionControlModule::observeMeshTx(const meshtastic_MeshPacket &packet, bool directMessage)
+{
+    if (packet.via_mqtt || (!directMessage && isFromUs(&packet)) || nodeDB->isLoraSlotTransient())
+        return;
+    concurrency::LockGuard guard(&stateLock);
+    advanceMeshHealth();
+    if (directMessage)
+        meshHealth.directTx(packet.to, packet.id);
+    else
+        meshHealth.relay(packet.from);
+}
+
+void LegionControlModule::observeMeshAck(uint32_t target, uint32_t id)
+{
+    if (nodeDB->isLoraSlotTransient())
+        return;
+    concurrency::LockGuard guard(&stateLock);
+    advanceMeshHealth();
+    meshHealth.acknowledge(target, id);
+}
+
+void legionControlObserveMeshRx(const meshtastic_MeshPacket &packet, int8_t hopsAway)
+{
+    if (legionControlModule)
+        legionControlModule->observeMeshRx(packet, hopsAway);
+}
+
+void legionControlObserveMeshTx(const meshtastic_MeshPacket &packet, bool directMessage)
+{
+    if (legionControlModule)
+        legionControlModule->observeMeshTx(packet, directMessage);
+}
+
+void legionControlObserveMeshAck(const meshtastic_MeshPacket &packet, uint32_t id)
+{
+    if (legionControlModule && packet.to == nodeDB->getNodeNum() && !packet.via_mqtt && packet.has_rx_rssi &&
+        packet.transport_mechanism == meshtastic_MeshPacket_TransportMechanism_TRANSPORT_LORA && !isFromUs(&packet))
+        legionControlModule->observeMeshAck(packet.from, id);
+}
