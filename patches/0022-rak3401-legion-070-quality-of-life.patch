+class DailyBattery
+{
+  public:
+    void sample(uint64_t slot, DailyBatterySample value)
+    {
+        if (!slot) {
+            if (!current.mv)
+                current.mv = value.mv;
+            if (current.percent < 0)
+                current.percent = value.percent;
+        } else if (slot != lastSlot) {
+            previous = slot == lastSlot + 1 ? current : DailyBatterySample{};
+            current = value;
+            lastSlot = slot;
+        }
+    }
+
+    void format(char *out, size_t size) const
+    {
+        char percent[20] = "", voltage[25] = "";
+        const bool percentDelta = current.percent >= 0 && previous.percent >= 0;
+        const bool voltageDelta = current.mv && previous.mv;
+        if (percentDelta)
+            std::snprintf(percent, sizeof(percent), "%d%% (%+dpp) ", int(current.percent), current.percent - previous.percent);
+        else if (current.percent >= 0)
+            std::snprintf(percent, sizeof(percent), "%d%% ", int(current.percent));
+        if (voltageDelta)
+            std::snprintf(voltage, sizeof(voltage), "%u.%02uV (%+ldmV)", unsigned(current.mv / 1000),
+                          unsigned(current.mv % 1000 / 10), long(current.mv) - previous.mv);
+        else if (current.mv)
+            std::snprintf(voltage, sizeof(voltage), "%u.%02uV", unsigned(current.mv / 1000), unsigned(current.mv % 1000 / 10));
+        else
+            std::snprintf(voltage, sizeof(voltage), "NA");
+        std::snprintf(out, size, "BAT:%s%s%s", percent, voltage, percentDelta || voltageDelta ? "" : " 24h:NA");
+    }
+
+  private:
+    uint64_t lastSlot = 0;
+    DailyBatterySample current, previous;
