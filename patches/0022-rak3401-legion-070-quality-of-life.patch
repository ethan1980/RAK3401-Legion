+    uint32_t relayed = 0;
+    int16_t score = -1;
+    bool partial = false;
+
+    void format(char *out, size_t size) const
+    {
+        char grade[12];
+        if (score >= 0)
+            std::snprintf(grade, sizeof(grade), "%u/100", unsigned(score));
+        else
+            std::snprintf(grade, sizeof(grade), "%s", partial ? "PARTIAL" : "NA");
+        std::snprintf(out, size,
+                      "MeshHealth %s\nHeard:%u Direct:%u 2+ hops:%u\nRelayed:%lu Sources:%u\nDM targets:%u Confirmed:%u", grade,
+                      unsigned(heard), unsigned(direct), unsigned(distant), (unsigned long)relayed, unsigned(sources),
+                      unsigned(targets), unsigned(confirmed));
+    }
+};
+
+class MeshHealth
+{
+  public:
+    void advance(uint64_t now, uint32_t generation, uint16_t slot, uint8_t role)
+    {
+        const auto day = now / DailySchedule::DAY_MS;
+        if (haveContext && (generation != radioGeneration || slot != radioSlot || role != radioRole)) {
+            partial = true;
+            historySize = 0;
+            historyNext = 0;
+        }
+        haveContext = true;
+        radioGeneration = generation;
+        radioSlot = slot;
+        radioRole = role;
+        if (day <= currentDay)
+            return;
+
+        closed = day == currentDay + 1 ? summarize() : MeshHealthTotals{};
+        if (day != currentDay + 1)
+            closed.partial = true;
+        if (!closed.partial) {
+            closed.score = score(closed);
+            history[historyNext] = {closed.heard, closed.direct, closed.sources};
+            historyNext = (historyNext + 1) % history.size();
+            if (historySize < history.size())
+                ++historySize;
+        }
+        currentDay = day;
+        nodes.fill(0);
+        facts.fill(0);
+        outstanding.fill({});
+        nodeCount = 0;
+        relayed = 0;
+        partial = false;
+    }
+
+    const MeshHealthTotals &last() const { return closed; }
+
+    void hear(uint32_t node, int8_t hops)
+    {
+        if (auto *fact = find(node, true)) {
+            *fact |= HEARD;
+            const auto best = *fact & HOP_MASK;
+            if (hops >= 0 && hops <= 7 && (!best || hops + 1 < best))
+                *fact = (*fact & ~HOP_MASK) | (hops + 1);
+        }
+    }
+
+    void relay(uint32_t node)
+    {
+        if (relayed != UINT32_MAX)
+            ++relayed;
+        if (auto *fact = find(node, true))
+            *fact |= RELAYED;
+    }
+
+    void directTx(uint32_t target, uint32_t packet)
+    {
+        auto *fact = find(target, true);
+        if (!fact)
+            return;
+        *fact |= TARGETED;
+        if (*fact & CONFIRMED)
+            return;
+        PendingAck *free = nullptr;
+        for (auto &pending : outstanding) {
+            if (pending.packet == packet && pending.target == target)
+                return;
+            if (!free && !pending.packet)
+                free = &pending;
+        }
+        if (free)
+            *free = {target, packet};
+        else
+            partial = true;
+    }
+
+    void acknowledge(uint32_t target, uint32_t packet)
+    {
+        const auto match = std::find_if(outstanding.begin(), outstanding.end(),
+                                        [=](const PendingAck &ack) { return ack.target == target && ack.packet == packet; });
+        if (match == outstanding.end())
+            return;
+        if (auto *fact = find(target, false))
+            *fact |= CONFIRMED;
+        for (auto &pending : outstanding)
+            if (pending.target == target)
+                pending = {};
+    }
+
+  private:
+    static constexpr uint8_t HOP_MASK = 0x0f, HEARD = 0x10, RELAYED = 0x20, TARGETED = 0x40, CONFIRMED = 0x80;
+    static constexpr size_t CAPACITY = 1024, MAX_TRACKED = 768;
+    struct PendingAck {
+        uint32_t target = 0, packet = 0;
+    };
+    using Baseline = std::array<uint16_t, 3>;
+
+    uint8_t *find(uint32_t node, bool insert)
+    {
+        if (node < 4 || node == UINT32_MAX)
+            return nullptr;
+        auto slot = size_t(((node ^ (node >> 16)) * 2654435761u) >> 22);
+        while (nodes[slot] && nodes[slot] != node)
+            slot = (slot + 1) % CAPACITY;
+        if (!nodes[slot]) {
+            if (!insert)
+                return nullptr;
+            if (nodeCount == MAX_TRACKED) {
+                partial = true;
+                return nullptr;
+            }
+            nodes[slot] = node;
+            ++nodeCount;
+        }
+        return &facts[slot];
+    }
+
+    MeshHealthTotals summarize() const
+    {
+        MeshHealthTotals total;
+        total.relayed = relayed;
+        total.partial = partial;
+        for (const auto fact : facts) {
+            const auto hops = fact & HOP_MASK;
+            total.heard += (fact & HEARD) != 0;
+            total.direct += hops == 1;
+            total.distant += hops >= 3;
+            total.sources += (fact & RELAYED) != 0;
+            total.targets += (fact & TARGETED) != 0;
+            total.confirmed += (fact & CONFIRMED) != 0;
+        }
+        return total;
+    }
+
+    int16_t score(const MeshHealthTotals &total) const
+    {
+        if (!historySize)
+            return -1;
+        const Baseline today{total.heard, total.direct, total.sources};
+        constexpr Baseline weights{40, 25, 35};
+        float points = 0;
+        unsigned possible = 0;
+        for (size_t metric = 0; metric < weights.size(); ++metric) {
+            std::array<uint16_t, 7> values{};
+            for (size_t i = 0; i < historySize; ++i)
+                values[i] = history[i][metric];
+            std::sort(values.begin(), values.begin() + historySize);
+            const unsigned doubleMedian = values[(historySize - 1) / 2] + values[historySize / 2];
+            if (doubleMedian) {
+                possible += weights[metric];
+                points += weights[metric] * std::min(2u * today[metric], doubleMedian) / float(doubleMedian);
+            }
+        }
+        return possible ? int16_t(100 * points / possible + 0.5f) : -1;
+    }
+
+    std::array<uint32_t, CAPACITY> nodes{};
+    std::array<uint8_t, CAPACITY> facts{};
+    std::array<PendingAck, 96> outstanding{};
+    std::array<Baseline, 7> history{};
+    size_t nodeCount = 0, historySize = 0, historyNext = 0;
+    uint64_t currentDay = 0;
+    uint32_t radioGeneration = 0, relayed = 0;
+    uint16_t radioSlot = 0;
+    uint8_t radioRole = 0;
+    bool haveContext = false, partial = false;
+    MeshHealthTotals closed;
+};
+static_assert(sizeof(MeshHealth) <= 6144, "MeshHealth RAM budget exceeded");
 } // namespace legion
