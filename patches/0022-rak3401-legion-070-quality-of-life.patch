+        const bool low = !usb && transmitPowerReady(battery, vdd, false) && (battery <= 3650 || vdd <= 3100);
+        samples = low ? samples + 1 : 0;
+        if (samples < confirmations)
+            return false;
+        samples = 0;
+        sent = true;
+        return true;
+    }
+
+  private:
+    uint8_t samples = 0;
+    bool sent = false;
+};
 } // namespace legion
