+class UniqueEstimate
+{
+  public:
+    static uint32_t hash(uint32_t node)
+    {
+        node ^= node >> 16;
+        node *= 0x85ebca6bu;
+        node ^= node >> 13;
+        node *= 0xc2b2ae35u;
+        return node ^ (node >> 16);
+    }
+
+    void add(uint32_t hash)
+    {
+        auto &rank = registers[hash >> 24];
+        rank = std::max(rank, uint8_t(__builtin_clz((hash << 8) | 0x80u) + 1));
+    }
+
+    uint16_t count() const
+    {
+        float sum = 0;
+        unsigned empty = 0;
+        for (const auto rank : registers) {
+            empty += rank == 0;
+            sum += 1.0f / float(uint32_t(1) << rank);
+        }
+        float estimate = (0.7213f / (1 + 1.079f / 256)) * 256 * 256 / sum;
+        if (empty && estimate <= 640)
+            estimate = 256 * std::log(256.0f / empty);
+        return uint16_t(std::min(65535.0f, estimate + 0.5f));
+    }
+
+    void clear() { registers.fill(0); }
+
+  private:
+    std::array<uint8_t, 256> registers{};
+};
