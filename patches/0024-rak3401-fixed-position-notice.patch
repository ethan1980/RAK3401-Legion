+void LegionControlModule::pollPositionNotice(uint32_t now)
+{
+    if (!positionNotice.due(now) || controlBusy() || !legionPowerTxReady() || !router->getRadioIface())
+        return;
+    {
+        concurrency::LockGuard guard(&stateLock);
+        if (requests.isPending() || trace.id)
+            return;
+    }
+    Channel control;
+    if (!findControlChannel(control))
+        return;
+    char text[legion::CONTROL_TEXT_MAX + 1];
+    std::snprintf(text, sizeof(text), "!%08lx: Fixed position is invalid. Set valid coordinates in Position settings.",
+                  (unsigned long)nodeDB->getNodeNum());
+    if (sendText(control.index, text))
+        positionNotice.queued(now);
+    else
+        positionNotice.deferred(now);
+}
