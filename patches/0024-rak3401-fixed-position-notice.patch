+class FixedPositionNotice
+{
+  public:
+    static constexpr uint32_t FIRST_MS = 5 * 60 * 1000;
+    static constexpr uint32_t REPEAT_MS = 12 * 60 * 60 * 1000;
+    static constexpr uint32_t RETRY_MS = 60 * 1000;
+
+    void observe(uint32_t now, bool invalid)
+    {
+        if (!invalid) {
+            tracking = false;
+            return;
+        }
+        if (!tracking) {
+            tracking = true;
+            nextAt = now + FIRST_MS;
+        }
+    }
+    bool due(uint32_t now) const { return tracking && Throttle::deadlinePassedAt(now, nextAt); }
+    void queued(uint32_t now) { nextAt = now + REPEAT_MS; }
+    void deferred(uint32_t now) { nextAt = now + RETRY_MS; }
+
+  private:
+    uint32_t nextAt = 0;
+    bool tracking = false;
+};
