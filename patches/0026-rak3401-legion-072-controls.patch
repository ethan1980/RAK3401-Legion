diff --git a/src/modules/LegionNodeSelector.h b/src/modules/LegionNodeSelector.h
new file mode 100644
index 0000000000000000000000000000000000000000..e1865be0b424a12fdfa9b21be749a0b7c2acd9ff
--- /dev/null
+++ b/src/modules/LegionNodeSelector.h
@@ -0,0 +1,56 @@
+#pragma once
+
+#include <cstddef>
+#include <cstdint>
+#include <cstring>
+
+namespace legion
+{
+inline bool sameShortName(const char *a, const char *b)
+{
+    if (!a || !b || !*a || !*b)
+        return false;
+    for (size_t i = 0; i < 5; ++i) {
+        const auto lower = [](uint8_t c) { return c >= 'A' && c <= 'Z' ? c + ('a' - 'A') : c; };
+        if (lower(a[i]) != lower(b[i]))
+            return false;
+        if (!a[i])
+            return true;
+    }
+    return false;
+}
+
+inline bool matchesNodeSelector(const uint8_t *data, size_t size, uint32_t ownNode, const char *ownShortName)
+{
+    if (!data || !size)
+        return false;
+    if (data[0] == '!') {
+        if (size != 9)
+            return false;
+        uint32_t node = 0;
+        for (size_t i = 1; i < size; ++i) {
+            const uint8_t c = data[i];
+            uint8_t digit;
+            if (c >= '0' && c <= '9')
+                digit = c - '0';
+            else if (c >= 'a' && c <= 'f')
+                digit = c - 'a' + 10;
+            else if (c >= 'A' && c <= 'F')
+                digit = c - 'A' + 10;
+            else
+                return false;
+            node = (node << 4) | digit;
+        }
+        return node == ownNode;
+    }
+    if (size >= 2 && data[0] == '"' && data[size - 1] == '"') {
+        ++data;
+        size -= 2;
+    }
+    if (!size || size > 4 || !ownShortName || strnlen(ownShortName, 5) != size || std::memchr(data, 0, size))
+        return false;
+    char name[5]{};
+    std::memcpy(name, data, size);
+    return sameShortName(name, ownShortName);
+}
+} // namespace legion
