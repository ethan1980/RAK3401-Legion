diff --git a/src/modules/LegionAutoArm.cpp b/src/modules/LegionAutoArm.cpp
new file mode 100644
index 0000000000000000000000000000000000000000..b36fd54e378e3aba9a5c518e3421127b1bedb653
--- /dev/null
+++ b/src/modules/LegionAutoArm.cpp
@@ -0,0 +1,52 @@
+#include "LegionAutoArm.h"
+
+#if RAK3401_LEGION_TRAFFIC
+#include "FSCommon.h"
+#include "SPILock.h"
+#include "SafeFile.h"
+#include "concurrency/LockGuard.h"
+#include "mesh/LegionRecovery.h"
+#include "power/RAK3401LegionPower.h"
+
+namespace
+{
+constexpr char filename[] = "/prefs/legionAutoArm.bin";
+constexpr uint32_t magic = 0x4c474152;
+constexpr uint32_t enabledValue = 0xa5a55a5a;
+constexpr uint32_t disabledValue = 0x5a5aa5a5;
+}
+
+LegionAutoArmState legionReadAutoArm()
+{
+    concurrency::LockGuard guard(spiLock);
+    auto file = FSCom.open(filename, FILE_O_READ);
+    if (!file)
+        return LegionAutoArmState::Missing;
+    uint32_t record[3]{};
+    const bool complete = static_cast<size_t>(file.read(reinterpret_cast<uint8_t *>(record), sizeof(record))) == sizeof(record) && file.read() < 0;
+    file.close();
+    if (!complete || record[0] != magic || record[1] != 1)
+        return LegionAutoArmState::Invalid;
+    if (record[2] == enabledValue)
+        return LegionAutoArmState::On;
+    return record[2] == disabledValue ? LegionAutoArmState::Off : LegionAutoArmState::Invalid;
+}
+
+bool legionWriteAutoArm(bool enabled)
+{
+    const auto wanted = enabled ? LegionAutoArmState::On : LegionAutoArmState::Off;
+    const auto current = legionReadAutoArm();
+    if (current == wanted || (!enabled && current == LegionAutoArmState::Missing))
+        return true;
+    if (!legionBatterySafeForFlash() || legionRecoveryIsBlocked())
+        return false;
+    const uint32_t record[3] = {magic, 1, enabled ? enabledValue : disabledValue};
+    SafeFile file(filename, true);
+    if (file.write(reinterpret_cast<const uint8_t *>(record), sizeof(record)) != sizeof(record)) {
+        file.abort();
+        return false;
+    }
+    file.close();
+    return legionReadAutoArm() == wanted;
+}
+#endif
