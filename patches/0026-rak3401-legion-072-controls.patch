+void LegionControlModule::queryDaily(uint8_t channel)
+{
+    legion::MeshHealthTotals totals;
+    {
+        concurrency::LockGuard guard(&stateLock);
+        totals = dailyMeshHealth;
+    }
+    if (!dailySlot) {
+        reply(channel, "DAILY unavailable; first 24-hour period has not closed");
+        return;
+    }
+    char health[160];
+    totals.format(health, sizeof(health));
+    char output[legion::CONTROL_TEXT_MAX + 1];
+    const auto age = Time::getMillisMonotonic() - dailySlot * legion::DailySchedule::DAY_MS;
+    const int length = std::snprintf(output, sizeof(output), "!%08lx DAILY age:%lus\n%s", (unsigned long)nodeDB->getNodeNum(),
+                                     (unsigned long)(age / 1000), health);
+    if (length > 0 && size_t(length) < sizeof(output))
+        sendText(channel, output);
+}
+
+void LegionControlModule::queryPosition(uint8_t channel)
+{
+    const auto position = localPosition;
+    const bool valid = position.latitude_i != 0 || position.longitude_i != 0;
+    uint8_t shareChannel = channels.getPrimaryIndex();
+    const bool sharing = findPositionChannel(shareChannel);
+    const uint32_t precision = sharing ? getPositionPrecisionForChannel(shareChannel) : 0;
+    const auto &settings = channels.getByIndex(shareChannel).settings;
+    char output[legion::CONTROL_TEXT_MAX + 1];
+    const int length = std::snprintf(
+        output, sizeof(output),
+        "!%08lx POSITION %s valid:%u\nlat:%.7f lon:%.7f\nLoRa_cfg:%s ch:%u p:%lubits interval_cfg:%lus smart:%u\n"
+        "MQTT_cfg:%s uplink:%u map:%u",
+        (unsigned long)nodeDB->getNodeNum(), config.position.fixed_position ? "FIXED" : "LIVE", unsigned(valid),
+        position.latitude_i / 1e7, position.longitude_i / 1e7, config.lora.tx_enabled && sharing ? "ON" : "OFF",
+        unsigned(shareChannel + 1), (unsigned long)precision, (unsigned long)config.position.position_broadcast_secs,
+        unsigned(config.position.position_broadcast_smart_enabled), moduleConfig.mqtt.enabled ? "ON" : "OFF",
+        unsigned(settings.uplink_enabled), unsigned(moduleConfig.mqtt.map_reporting_enabled));
+    if (length > 0 && size_t(length) < sizeof(output))
+        sendText(channel, output);
+}
+
+void LegionControlModule::listChannels(uint8_t channel)
+{
+    char output[legion::CONTROL_TEXT_MAX + 1];
+    size_t used = std::snprintf(output, sizeof(output), "!%08lx:", (unsigned long)nodeDB->getNodeNum());
+    bool first = true;
+    for (uint8_t i = 0; i < channels.getNumChannels(); ++i) {
+        const auto &candidate = channels.getByIndex(i);
+        if (!candidate.has_settings || candidate.role == meshtastic_Channel_Role_DISABLED)
+            continue;
+        const char *name = channels.getName(i);
+        if (!name || !*name)
+            continue;
+        const int length = std::snprintf(output + used, sizeof(output) - used, "%s%u:%s", first ? " " : ", ", unsigned(i + 1), name);
+        if (length < 0 || size_t(length) >= sizeof(output) - used) {
+            reply(channel, "Channel list exceeds message limit");
+            return;
+        }
+        used += size_t(length);
+        first = false;
+    }
+    if (first)
+        reply(channel, "No configured channels");
+    else
+        sendText(channel, output);
+}
